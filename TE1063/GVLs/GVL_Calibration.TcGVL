    tDelayStart         : TIME;
    bPrintWhenComplete  : BOOL;
    sGlobalStatus       : STRING[100];
	iPercentLoadBar     : UINT;
	iReplicatesSetpoint : UINT := 1; 
	rAcceptanceCriteria	: LREAL;
	iAllowableFailures	: UINT := 2;
	fbScaleDevice		: FB_ScaleDevice; //Scale Instance Object
	iResultIndex	 	: INT;		 	// Array index on calibration results
	
	aCalibLinearPumps	: ARRAY[1..10] OF ST_LinearPumpCalibration;
	eLeakTestState 		: E_LeakTestState	:= E_LeakTestState.IDLE;
	
	//aCalibCheckResult	: ARRAY[1..100] OF ST_CalibrationPumpResult;
	
	(* Calibration Report*)// -----------------------------------------------------------------------------------------------
