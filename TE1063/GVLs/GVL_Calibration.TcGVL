	stPumpCalReportInfo 	: ST_ReportInfo;	  	//																	  	|
	stPumpCalibrationInfo 	: ST_CalibrationInfo;	//																		|
	stPumpCalibrationData 	: ARRAY[1..250] OF ST_CalibrationData;	//
	//																	
	stLinearCalibrationData : ARRAY[1..10] OF ST_LinearPumpControllDB; // Linear Calibration changing position data from HMI
	//																														|		
	bStartCreationCalJson	: BOOL; // Flag to start the Json creation														|
	bCreationCalJsonDone	: BOOL; // Flag to indicate Json was created Correctly											|
	bCreationCalJsonError	: BOOL; // Flag to indicate Error on Json creation												|
