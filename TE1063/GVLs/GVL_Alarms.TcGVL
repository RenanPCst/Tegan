<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <GVL Name="GVL_Alarms" Id="{046a5301-5506-40ac-a704-744f0bfa435c}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL

	arrEventText 	: ARRAY[0..400] OF T_MaxSTring;	// All events messages defined for the system - indices corresponds to indices of aEvents
	arrActiveEvents : ARRAY[0..400] OF T_MaxSTring;	// Active events messages - displayed in active alarms
	arrEventLogs	: ARRAY[0..400] OF T_MaxSTring;	// Logged events messages - displayed in alarm history
	arrEventFlag	: ARRAY[0..400] OF BOOL;		// Events triggers

	(* Flags to trigger the alarms/events *) //--------------------------------------------------------------------
	
	aSolventLowLevel	 : ARRAY[1..4] OF BOOL; //Flags to check the solvent levels before going to auto cycle
	aSolventNearLowLevel : ARRAY[1..4] OF BOOL; //Flags to warning if the solvent levels are near low level
	bWasteHighLevel		 : BOOL; //Flag to check waste reservoir level before going to auto cycle
	bWasteNearHighLevel	 : BOOL; //Flag to warning if waste reservoir is new high level
	
	bPumpsEStopTriggered : BOOL; //Flag when pumps were running and a emergency stop is triggered
	
	rDiskUsage_C : LREAL;   // % Percentage usage of C: on IPC hard drive
	
	bTCPCLientConnectError	: BOOL; // TCP Client FB_SocketConnect error Flag
	bTCPCLientSendError		: BOOL; // TCP Client FB_SocketSend error Flag
	bTCPCLientReceiveError	: BOOL; // TCP Client FB_SocketReceive error Flag
	bTCPCLientCloseError	: BOOL; // TCP Client FB_SocketCloseAll or FB_SocketClose error Flag
 
	bInvalidSolventSelection : BOOL; // Calibration Invalid Solvent Selection Error
	sStartCalibrationBlockedReason : STRING(255); // Calibration Invalid Solvent Selection Reason
	
	(* Motion Timeouts *) //---------------------------------------------------------------------------------------
	//System Init
	bMotionResetTimeout		: BOOL;	// Motion Timeout during Reset step on PRG_SystemInit
	bMotionEnableTimeout	: BOOL; // Motion Timeout during Enable step on PRG_SystemInit
	bMotionHomeTimeout		: BOOL; // Motion Timeout during Homing step on PRG_SystemInit
	bMotionMoveAbsTimeout	: BOOL; // Motion Timeout during Move Absolute step on PRG_SystemInit
	
	sMotionResetTimeoutAxis		: STRING(64); // String including the axis names to be part of alarm text - Motion Timeout during Reset step on PRG_SystemInit
	sMotionEnableTimeoutAxis	: STRING(64); // String including the axis names to be part of alarm text - Motion Timeout during Enable step on PRG_SystemInit
	sMotionHomeTimeoutAxis		: STRING(64); // String including the axis names to be part of alarm text - Motion Timeout during Homing step on PRG_SystemInit
	sMotionMoveAbsTimeoutAxis	: STRING(64); // String including the axis names to be part of alarm text - Motion Timeout during Move Absolute step on PRG_SystemInit
	
	(* Secondary Functions *) //---------------------------------------------------------------------------------------
	bCalJsonCreationError		: BOOL;		// Error during calibration json file creation
	nCalJsonCreationErrorId		: UDINT;	// Error number ID during calibration json file creation
	
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>