	nBLUE								: 	DWORD 	:= 	16#FF0000FF;
	nLIGHTBLUE                          :   DWORD   :=  16#FF08ADF4;
	nGREY								: 	DWORD 	:= 	16#FFA9A9A9;	
	nDARKGREY							:	DWORD	:=	16#FF808080;
	nPURPLE								:	DWORD	:=	16#FF800080;
	nVIOLET								:	DWORD	:=	16#FFEE82EE;
