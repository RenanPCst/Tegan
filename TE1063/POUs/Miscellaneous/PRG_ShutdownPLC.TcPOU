      <LineId Id="122" Count="4" />
      <LineId Id="171" Count="0" />
      <LineId Id="127" Count="5" />
      <LineId Id="154" Count="0" />
      <LineId Id="133" Count="18" />
      <LineId Id="5" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>