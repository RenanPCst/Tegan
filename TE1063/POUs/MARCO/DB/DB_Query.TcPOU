GVL_Reports.stSelectedSystemSettings.sSmpIntoResWeigh           := '';
GVL_Reports.stSelectedSystemSettings.sSmpIntoVials              := '';
GVL_Reports.stSelectedSystemSettings.sSmpIntoWaste              := '';
GVL_Reports.stSelectedSystemSettings.sSecDisplayManualControl   := '';
GVL_Reports.stSelectedSystemSettings.sSecCheckLogonEachRun      := '';
GVL_Reports.stSelectedSystemSettings.sCreatedBy                 := '';
GVL_Reports.stSelectedSystemSettings.sCreatedDate               := '';
GVL_Reports.stSelectedSystemSettings.sSysRevisionNo             := '';]]></ST>
      </Implementation>
    </Method>
    <Method Name="copyPumpCalibHeaderToReports" Id="{232e4675-4be5-410f-9005-6177b6c89fac}">
      <Declaration><![CDATA[METHOD copyPumpCalibHeaderToReports : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[GVL_Reports.iPumpCalibNo           := aPumpCalibHeader[1].CalibrationNo;
GVL_Reports.sPumpCalibUserID       := aPumpCalibHeader[1].userID;
GVL_Reports.sPumpCalibDensity      := aPumpCalibHeader[1].density;
GVL_Reports.sPumpCalibSolventNo    := aPumpCalibHeader[1].solventNo;
GVL_Reports.sPumpCalibSolventRev   := aPumpCalibHeader[1].solventRevision;
GVL_Reports.sPumpCalibAllowFail    := aPumpCalibHeader[1].allowableFail;
GVL_Reports.sPumpCalibReplicates   := aPumpCalibHeader[1].replicates;
GVL_Reports.sPumpCalibCallInterval := aPumpCalibHeader[1].callInterval;
GVL_Reports.sPumpCalibSysRev       := INT_TO_STRING(aPumpCalibHeader[1].sysRevisionNo);]]></ST>
      </Implementation>
    </Method>
    <Method Name="CopySelectedCalibHeaderToLegacy" Id="{84371fb3-b882-4e2c-96f5-4e09033f5130}">
      <Declaration><![CDATA[METHOD CopySelectedCalibHeaderToLegacy : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[GVL_Reports.iPumpCalibNo           := STRING_TO_INT(GVL_Reports.stSelectedCalibReportHeader.sCalibrationNo);
GVL_Reports.sPumpCalibUserID       := GVL_Reports.stSelectedCalibReportHeader.sUserId;
GVL_Reports.sPumpCalibDensity      := GVL_Reports.stSelectedCalibReportHeader.sDensity;
GVL_Reports.sPumpCalibSolventNo    := GVL_Reports.stSelectedCalibReportHeader.sSolventNo;
GVL_Reports.sPumpCalibSolventRev   := GVL_Reports.stSelectedCalibReportHeader.sSolventRevision;
GVL_Reports.sPumpCalibSysRev       := GVL_Reports.stSelectedCalibReportHeader.sSysRevisionNo;
GVL_Reports.sPumpCalibAllowFail    := GVL_Reports.stSelectedCalibReportHeader.sAllowableFail;
GVL_Reports.sPumpCalibReplicates   := GVL_Reports.stSelectedCalibReportHeader.sReplicates;
GVL_Reports.sPumpCalibCallInterval := GVL_Reports.stSelectedCalibReportHeader.sCallInterval;]]></ST>
      </Implementation>
    </Method>
    <Method Name="CopySelectedCalibLinesToLegacy" Id="{2b3efc14-f42f-4abe-953c-fb042707a17d}">
      <Declaration><![CDATA[METHOD CopySelectedCalibLinesToLegacy : BOOL
VAR
	 i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO 100 DO
    GVL_Reports.aPumpCalibValues[i].dateTime          := '';
    GVL_Reports.aPumpCalibValues[i].pumpNo            := '';
    GVL_Reports.aPumpCalibValues[i].step              := '';
    GVL_Reports.aPumpCalibValues[i].tareWt            := '';
    GVL_Reports.aPumpCalibValues[i].grossWt           := '';
    GVL_Reports.aPumpCalibValues[i].netWt             := '';
    GVL_Reports.aPumpCalibValues[i].netVolume         := '';
    GVL_Reports.aPumpCalibValues[i].targetVolume      := '';
    GVL_Reports.aPumpCalibValues[i].differencePercent := '';
    GVL_Reports.aPumpCalibValues[i].criteria          := '';
    GVL_Reports.aPumpCalibValues[i].pumpRevs          := '';
END_FOR

FOR i := 1 TO 100 DO
    IF i <= 300 THEN
        GVL_Reports.aPumpCalibValues[i].dateTime          := GVL_Reports.aSelectedCalibReportLines[i].sDateTime;
        GVL_Reports.aPumpCalibValues[i].pumpNo            := GVL_Reports.aSelectedCalibReportLines[i].sPumpNo;
        GVL_Reports.aPumpCalibValues[i].step              := GVL_Reports.aSelectedCalibReportLines[i].sStep;
        GVL_Reports.aPumpCalibValues[i].tareWt            := GVL_Reports.aSelectedCalibReportLines[i].sTareWt;
        GVL_Reports.aPumpCalibValues[i].grossWt           := GVL_Reports.aSelectedCalibReportLines[i].sGrossWt;
        GVL_Reports.aPumpCalibValues[i].netWt             := GVL_Reports.aSelectedCalibReportLines[i].sNetWt;
        GVL_Reports.aPumpCalibValues[i].netVolume         := GVL_Reports.aSelectedCalibReportLines[i].sNetVolume;
        GVL_Reports.aPumpCalibValues[i].targetVolume      := GVL_Reports.aSelectedCalibReportLines[i].sTargetVolume;
        GVL_Reports.aPumpCalibValues[i].differencePercent := GVL_Reports.aSelectedCalibReportLines[i].sDifferencePercent;
        GVL_Reports.aPumpCalibValues[i].criteria          := GVL_Reports.aSelectedCalibReportLines[i].sCriteria;
        GVL_Reports.aPumpCalibValues[i].pumpRevs          := GVL_Reports.aSelectedCalibReportLines[i].sPumpRevs;
    END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="deleteCalibHead" Id="{d1a83fa1-a0e2-4042-9fcf-421920f81649}">
      <Declaration><![CDATA[METHOD deleteCalibHead : BOOL
VAR_INPUT
	start : BOOL;
END_VAR
VAR
	sCalibNo : STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Builds the DELETE command that removes an orphaned CALIBRATION_HEAD row.
// Called from E_DB_QUERY_STATE.DELETE_CALIBRATION_HEAD when calibration
// was aborted before any measurement row was inserted into [CALIBRATION].
sCalibNo := INT_TO_STRING(GVL_DB.stParameter_PCR.CalibrationNo);

IF start THEN
    FindAndReplace(
        pSrcString    := ADR(cmdIn),
        pDeleteString := ADR('#1#'),
        pInsertString := ADR(sCalibNo),
        pDstString    := ADR(cmdIn),
        nDstSize      := SIZEOF(cmdIn)
    );
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Fill_Calibration_Data" Id="{d59b2a6e-d6b9-48b7-be19-8a8a00342b04}">
      <Declaration><![CDATA[METHOD Fill_Calibration_Data : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i:=1 TO 100 BY 1 DO 
GVL_DB.astData_PCR[i].CalibrationNo			:= 0;
GVL_DB.astData_PCR[i].criteria				:= '';
GVL_DB.astData_PCR[i].dateTime				:= '';
GVL_DB.astData_PCR[i].differencePercent		:= '';
GVL_DB.astData_PCR[i].grossWt				:= '';
GVL_DB.astData_PCR[i].netVolume				:= '';
GVL_DB.astData_PCR[i].netWt					:= '';
GVL_DB.astData_PCR[i].pumpNo				:= '';
GVL_DB.astData_PCR[i].pumpRevs				:= '';
GVL_DB.astData_PCR[i].step					:= '';
GVL_DB.astData_PCR[i].tareWt				:= '';
GVL_DB.astData_PCR[i].targetVolume			:= '';
END_FOR

FOR i:=1 TO 100 BY 1 DO 
GVL_DB.astData_PCR[i].CalibrationNo			:= GVL_DB.stParameter_PCR.CalibrationNo;
GVL_DB.astData_PCR[i].criteria				:= REAL_TO_STRING(GVL_Calibration.stPumpCalibrationData[i].rCriteria);
GVL_DB.astData_PCR[i].dateTime				:= GVL_Calibration.stPumpCalibrationData[i].dDateTime;
GVL_DB.astData_PCR[i].differencePercent		:= LREAL_TO_STRING(GVL_Calibration.stPumpCalibrationData[i].rDifferencePercent);
GVL_DB.astData_PCR[i].grossWt				:= LREAL_TO_STRING(GVL_Calibration.stPumpCalibrationData[i].rGrossWeigth);
GVL_DB.astData_PCR[i].netVolume				:= LREAL_TO_STRING(GVL_Calibration.stPumpCalibrationData[i].rNetVolume);
GVL_DB.astData_PCR[i].netWt					:= LREAL_TO_STRING(GVL_Calibration.stPumpCalibrationData[i].rNetWeigth);
GVL_DB.astData_PCR[i].pumpNo				:= USINT_TO_STRING(GVL_Calibration.stPumpCalibrationData[i].iPumpNumber);
GVL_DB.astData_PCR[i].pumpRevs				:= UINT_TO_STRING(GVL_Calibration.stPumpCalibrationData[i].iPumpRevs);
GVL_DB.astData_PCR[i].step					:= GVL_Calibration.stPumpCalibrationData[i].sStep;
GVL_DB.astData_PCR[i].tareWt				:= LREAL_TO_STRING(GVL_Calibration.stPumpCalibrationData[i].rTareWeigth);
GVL_DB.astData_PCR[i].targetVolume			:= LREAL_TO_STRING(GVL_Calibration.stPumpCalibrationData[i].rTargetVolume);
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="Fill_Method_Data" Id="{d51d889f-7cbb-4120-a8cc-95084a764cad}">
      <Declaration><![CDATA[METHOD Fill_Method_Data : BOOL
VAR_INPUT
END_VAR

VAR
	j: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
GVL_Recipe.stCurrentRecipe.stOtherParams.tAgitate1Time := DINT_TO_TIME(STRING_TO_DINT(GVL_DB.stParameter_MR.agitate_1_Time)*1000);
GVL_Recipe.stCurrentRecipe.stOtherParams.tAgitate2Time := DINT_TO_TIME(STRING_TO_DINT(GVL_DB.stParameter_MR.agitate_2_Time)*1000);
GVL_Recipe.stCurrentRecipe.stOtherParams.tAirDryTime := DINT_TO_TIME(STRING_TO_DINT(GVL_DB.stParameter_MR.airDryTime)*1000);
GVL_Recipe.stCurrentRecipe.stInfo.sCreatedBy := GVL_DB.stParameter_MR.methodCreatedBy;
//GVL_Recipe.stCurrentRecipe.stInfo.dCreationDate := GVL_DB.stParameter_MR.methodCreatedOn;
GVL_Recipe.stCurrentRecipe.stInfo.sMethodName := GVL_DB.stParameter_MR.methodName;
GVL_Recipe.stCurrentRecipe.stInfo.iRevision := STRING_TO_INT(GVL_DB.stParameter_MR.methodRevision);
GVL_Recipe.stCurrentRecipe.stOtherParams.tSoakTime := DINT_TO_TIME(STRING_TO_DINT(GVL_DB.stParameter_MR.soakTime)*1000);
GVL_Recipe.stCurrentRecipe.stSolventsTimes.aSolventN[1] := STRING_TO_USINT(GVL_DB.stParameter_MR.solvent_R1);
GVL_Recipe.stCurrentRecipe.stSolventsTimes.aSolventN[2] := STRING_TO_USINT(GVL_DB.stParameter_MR.solvent_R2);
GVL_Recipe.stCurrentRecipe.stSolventsTimes.aSolventN[3] := STRING_TO_USINT(GVL_DB.stParameter_MR.solvent_W1);
GVL_Recipe.stCurrentRecipe.stSolventsTimes.aSolventN[4] := STRING_TO_USINT(GVL_DB.stParameter_MR.solvent_W2);
GVL_Recipe.stCurrentRecipe.stSolventsTimes.aTime[1] := DINT_TO_TIME(STRING_TO_DINT(GVL_DB.stParameter_MR.time_R1)*1000);
GVL_Recipe.stCurrentRecipe.stSolventsTimes.aTime[2] := DINT_TO_TIME(STRING_TO_DINT(GVL_DB.stParameter_MR.time_R2)*1000);
GVL_Recipe.stCurrentRecipe.stSolventsTimes.aTime[3] := DINT_TO_TIME(STRING_TO_DINT(GVL_DB.stParameter_MR.time_W1)*1000);
GVL_Recipe.stCurrentRecipe.stSolventsTimes.aTime[4] := DINT_TO_TIME(STRING_TO_DINT(GVL_DB.stParameter_MR.time_W2)*1000);
GVL_Recipe.stCurrentRecipe.stSolventsTimes.aVelocity[1] := STRING_TO_INT(GVL_DB.stParameter_MR.velocity_R1);
GVL_Recipe.stCurrentRecipe.stSolventsTimes.aVelocity[2] := STRING_TO_INT(GVL_DB.stParameter_MR.velocity_R2);
GVL_Recipe.stCurrentRecipe.stSolventsTimes.aVelocity[3] := STRING_TO_INT(GVL_DB.stParameter_MR.velocity_W1);
GVL_Recipe.stCurrentRecipe.stSolventsTimes.aVelocity[4] := STRING_TO_INT(GVL_DB.stParameter_MR.velocity_W2);
GVL_Recipe.stCurrentRecipe.stOtherParams.rVial1FillVol := STRING_TO_REAL(GVL_DB.stParameter_MR.vial_1_FillVol);
GVL_Recipe.stCurrentRecipe.stOtherParams.rVials2_4FillVol := STRING_TO_REAL(GVL_DB.stParameter_MR.vial_2_4_FillVol);
GVL_Recipe.stCurrentRecipe.stOtherParams.rVialPrimeVol := STRING_TO_REAL(GVL_DB.stParameter_MR.vialPrimeVol);
GVL_Recipe.stCurrentRecipe.stOtherParams.iVialsToFill := STRING_TO_USINT(GVL_DB.stParameter_MR.vialsToFill);

GVL_Recipe.stCurrentRecipe.stVolumes.aT_IC_Volume[1] := STRING_TO_REAL(GVL_DB.astVolData[1].rinse1);
GVL_Recipe.stCurrentRecipe.stVolumes.aT_IC_Volume[2] := STRING_TO_REAL(GVL_DB.astVolData[1].rinse2);
GVL_Recipe.stCurrentRecipe.stVolumes.aT_IC_Volume[3] := STRING_TO_REAL(GVL_DB.astVolData[1].wash1);
GVL_Recipe.stCurrentRecipe.stVolumes.aT_IC_Volume[4] := STRING_TO_REAL(GVL_DB.astVolData[1].wash2);
GVL_Recipe.stCurrentRecipe.stVolumes.aS0_Volume[1] := STRING_TO_REAL(GVL_DB.astVolData[2].rinse1);
GVL_Recipe.stCurrentRecipe.stVolumes.aS0_Volume[2] := STRING_TO_REAL(GVL_DB.astVolData[2].rinse2);
GVL_Recipe.stCurrentRecipe.stVolumes.aS0_Volume[3] := STRING_TO_REAL(GVL_DB.astVolData[2].wash1);
GVL_Recipe.stCurrentRecipe.stVolumes.aS0_Volume[4] := STRING_TO_REAL(GVL_DB.astVolData[2].wash2);
GVL_Recipe.stCurrentRecipe.stVolumes.aS1_Volume[1] := STRING_TO_REAL(GVL_DB.astVolData[3].rinse1);
GVL_Recipe.stCurrentRecipe.stVolumes.aS1_Volume[2] := STRING_TO_REAL(GVL_DB.astVolData[3].rinse2);
GVL_Recipe.stCurrentRecipe.stVolumes.aS1_Volume[3] := STRING_TO_REAL(GVL_DB.astVolData[3].wash1);
GVL_Recipe.stCurrentRecipe.stVolumes.aS1_Volume[4] := STRING_TO_REAL(GVL_DB.astVolData[3].wash2);
GVL_Recipe.stCurrentRecipe.stVolumes.aS2_Volume[1] := STRING_TO_REAL(GVL_DB.astVolData[4].rinse1);
GVL_Recipe.stCurrentRecipe.stVolumes.aS2_Volume[2] := STRING_TO_REAL(GVL_DB.astVolData[4].rinse2);
GVL_Recipe.stCurrentRecipe.stVolumes.aS2_Volume[3] := STRING_TO_REAL(GVL_DB.astVolData[4].wash1);
GVL_Recipe.stCurrentRecipe.stVolumes.aS2_Volume[4] := STRING_TO_REAL(GVL_DB.astVolData[4].wash2);
GVL_Recipe.stCurrentRecipe.stVolumes.aS3_Volume[1] := STRING_TO_REAL(GVL_DB.astVolData[5].rinse1);
GVL_Recipe.stCurrentRecipe.stVolumes.aS3_Volume[2] := STRING_TO_REAL(GVL_DB.astVolData[5].rinse2);
GVL_Recipe.stCurrentRecipe.stVolumes.aS3_Volume[3] := STRING_TO_REAL(GVL_DB.astVolData[5].wash1);
GVL_Recipe.stCurrentRecipe.stVolumes.aS3_Volume[4] := STRING_TO_REAL(GVL_DB.astVolData[5].wash2);
GVL_Recipe.stCurrentRecipe.stVolumes.aS4_Volume[1] := STRING_TO_REAL(GVL_DB.astVolData[6].rinse1);
GVL_Recipe.stCurrentRecipe.stVolumes.aS4_Volume[2] := STRING_TO_REAL(GVL_DB.astVolData[6].rinse2);
GVL_Recipe.stCurrentRecipe.stVolumes.aS4_Volume[3] := STRING_TO_REAL(GVL_DB.astVolData[6].wash1);
GVL_Recipe.stCurrentRecipe.stVolumes.aS4_Volume[4] := STRING_TO_REAL(GVL_DB.astVolData[6].wash2);
GVL_Recipe.stCurrentRecipe.stVolumes.aS5_Volume[1] := STRING_TO_REAL(GVL_DB.astVolData[7].rinse1);
GVL_Recipe.stCurrentRecipe.stVolumes.aS5_Volume[2] := STRING_TO_REAL(GVL_DB.astVolData[7].rinse2);
GVL_Recipe.stCurrentRecipe.stVolumes.aS5_Volume[3] := STRING_TO_REAL(GVL_DB.astVolData[7].wash1);
GVL_Recipe.stCurrentRecipe.stVolumes.aS5_Volume[4] := STRING_TO_REAL(GVL_DB.astVolData[7].wash2);
GVL_Recipe.stCurrentRecipe.stVolumes.aS6_Volume[1] := STRING_TO_REAL(GVL_DB.astVolData[8].rinse1);
GVL_Recipe.stCurrentRecipe.stVolumes.aS6_Volume[2] := STRING_TO_REAL(GVL_DB.astVolData[8].rinse2);
GVL_Recipe.stCurrentRecipe.stVolumes.aS6_Volume[3] := STRING_TO_REAL(GVL_DB.astVolData[8].wash1);
GVL_Recipe.stCurrentRecipe.stVolumes.aS6_Volume[4] := STRING_TO_REAL(GVL_DB.astVolData[8].wash2);
GVL_Recipe.stCurrentRecipe.stVolumes.aS7_Volume[1] := STRING_TO_REAL(GVL_DB.astVolData[9].rinse1);
GVL_Recipe.stCurrentRecipe.stVolumes.aS7_Volume[2] := STRING_TO_REAL(GVL_DB.astVolData[9].rinse2);
GVL_Recipe.stCurrentRecipe.stVolumes.aS7_Volume[3] := STRING_TO_REAL(GVL_DB.astVolData[9].wash1);
GVL_Recipe.stCurrentRecipe.stVolumes.aS7_Volume[4] := STRING_TO_REAL(GVL_DB.astVolData[9].wash2);
GVL_Recipe.stCurrentRecipe.stVolumes.aF_Volume[1] := STRING_TO_REAL(GVL_DB.astVolData[10].rinse1);
GVL_Recipe.stCurrentRecipe.stVolumes.aF_Volume[2] := STRING_TO_REAL(GVL_DB.astVolData[10].rinse2);
GVL_Recipe.stCurrentRecipe.stVolumes.aF_Volume[3] := STRING_TO_REAL(GVL_DB.astVolData[10].wash1);
GVL_Recipe.stCurrentRecipe.stVolumes.aF_Volume[4] := STRING_TO_REAL(GVL_DB.astVolData[10].wash2);









]]></ST>
      </Implementation>
    </Method>
    <Method Name="insertCalib" Id="{04796082-46d0-4881-a277-bdc8481c6e70}">
      <Declaration><![CDATA[METHOD insertCalib : BOOL
VAR_INPUT
	start: BOOL;
END_VAR


VAR
	sysRevisionNo: STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[sysRevisionNo:= INT_TO_STRING(GVL_DB.stParameter_PCR.sysRevisionNo);

IF start THEN
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#1#'), pInsertString:= ADR(GVL_DB.stParameter_PCR.userID), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#2#'), pInsertString:= ADR(GVL_DB.stParameter_PCR.density), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#3#'), pInsertString:= ADR(GVL_DB.stParameter_PCR.solventNo), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#4#'), pInsertString:= ADR(GVL_DB.stParameter_PCR.solventRevision), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#5#'), pInsertString:= ADR(GVL_DB.stParameter_PCR.allowableFail), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#6#'), pInsertString:= ADR(GVL_DB.stParameter_PCR.replicates), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#7#'), pInsertString:= ADR(GVL_DB.stParameter_PCR.callInterval), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#8#'), pInsertString:= ADR(sysRevisionNo), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="insertCalibValues" Id="{b4b4219c-c49e-4d85-8ecc-39525f3a4943}">
      <Declaration><![CDATA[METHOD insertCalibValues : BOOL
VAR_INPUT
	start: BOOL;
	line: INT;
END_VAR

VAR
	CalibrationNo: STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CalibrationNo:= INT_TO_STRING(GVL_DB.astData_PCR[line-1].CalibrationNo);

IF start THEN
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#1#'), pInsertString:= ADR(GVL_DB.astData_PCR[line-1].dateTime), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#2#'), pInsertString:= ADR(GVL_DB.astData_PCR[line-1].pumpNo), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#3#'), pInsertString:= ADR(GVL_DB.astData_PCR[line-1].step), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#4#'), pInsertString:= ADR(GVL_DB.astData_PCR[line-1].tareWt), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#5#'), pInsertString:= ADR(GVL_DB.astData_PCR[line-1].grossWt), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#6#'), pInsertString:= ADR(GVL_DB.astData_PCR[line-1].netVolume), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#7#'), pInsertString:= ADR(GVL_DB.astData_PCR[line-1].netWt), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#8#'), pInsertString:= ADR(GVL_DB.astData_PCR[line-1].targetVolume), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#9#'), pInsertString:= ADR(GVL_DB.astData_PCR[line-1].differencePercent), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#10#'), pInsertString:= ADR(GVL_DB.astData_PCR[line-1].criteria), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#11#'), pInsertString:= ADR(GVL_DB.astData_PCR[line-1].pumpRevs), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#12#'), pInsertString:= ADR(CalibrationNo), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));

END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="insertLinearMotors" Id="{2cc83db0-0d56-4ac9-a971-75f999630793}">
      <Declaration><![CDATA[METHOD insertLinearMotors : BOOL
VAR_INPUT
	start: BOOL;
END_VAR


VAR

	stIOTerm23: STRING;
	stIOTerm24: STRING;
	stIOTerm25: STRING;
	stIOTerm26: STRING;
	stIOTerm27: STRING;
	stIOTerm28: STRING;
	stIOTerm29: STRING;
	stIOTerm30: STRING;
	stIOTerm31: STRING;
	stIOTerm32: STRING;
	sChangedBy : STRING(100);
    sChangedOn : STRING(100);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
stIOTerm23:= LREAL_TO_STRING(GVL_HMI.aCalibLinearPumps[1].rNewPosition);
stIOTerm24:= LREAL_TO_STRING(GVL_HMI.aCalibLinearPumps[2].rNewPosition);
stIOTerm25:= LREAL_TO_STRING(GVL_HMI.aCalibLinearPumps[3].rNewPosition);
stIOTerm26:= LREAL_TO_STRING(GVL_HMI.aCalibLinearPumps[4].rNewPosition);
stIOTerm27:= LREAL_TO_STRING(GVL_HMI.aCalibLinearPumps[5].rNewPosition);
stIOTerm28:= LREAL_TO_STRING(GVL_HMI.aCalibLinearPumps[6].rNewPosition);
stIOTerm29:= LREAL_TO_STRING(GVL_HMI.aCalibLinearPumps[7].rNewPosition);
stIOTerm30:= LREAL_TO_STRING(GVL_HMI.aCalibLinearPumps[8].rNewPosition);
stIOTerm31:= LREAL_TO_STRING(GVL_HMI.aCalibLinearPumps[9].rNewPosition);
stIOTerm32:= LREAL_TO_STRING(GVL_HMI.aCalibLinearPumps[10].rNewPosition);

IF start THEN
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#1#'),  pInsertString:= ADR(stIOTerm23), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#2#'),  pInsertString:= ADR(stIOTerm24), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#3#'),  pInsertString:= ADR(stIOTerm25), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#4#'),  pInsertString:= ADR(stIOTerm26), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#5#'),  pInsertString:= ADR(stIOTerm27), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#6#'),  pInsertString:= ADR(stIOTerm28), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#7#'),  pInsertString:= ADR(stIOTerm29), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#8#'),  pInsertString:= ADR(stIOTerm30), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#9#'),  pInsertString:= ADR(stIOTerm31), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#10#'), pInsertString:= ADR(stIOTerm32), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#11#'), pInsertString:= ADR(sChangedBy),  pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#12#'), pInsertString:= ADR(sChangedOn),  pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="insertMethod" Id="{28bec1f1-562b-498f-976b-131c3ec1fe86}">
      <Declaration><![CDATA[METHOD insertMethod : BOOL
VAR_INPUT
	start: BOOL;
END_VAR

VAR
	iRevision: STRING;
	dCreationDate: STRING;
	Rinse1: STRING;
	Rinse2: STRING;
	Wash1: STRING;
	Wash2: STRING;
	Rinse12: STRING;
	Rinse22: STRING;
	Wash12: STRING;
	Wash22: STRING;
	Rinse13: STRING;
	Wash13: STRING;
	Wash23: STRING;
	Rinse23: STRING;
	soakTime: STRING;
	agitate_1_Time: STRING;
	vialPrimeVol: STRING;
	vial_2_4_FillVol: STRING;
	vial_1_FillVol: STRING;
	airDryTime: STRING;
	agitate_2_Time: STRING;
	vialsToFill: STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF GVL_HMI.bNewRecipeButton THEN
	iRevision := '1';
ELSE
	iRevision := INT_TO_STRING(GVL_HMI.stRecipeInfo.iRevision+1);	
END_IF
dCreationDate := DATE_TO_STRING(GVL_HMI.stRecipeInfo.dCreationDate);
Rinse1 := INT_TO_STRING(GVL_HMI.aSolventAndTimesRows[1].Rinse1);
Rinse2 := INT_TO_STRING(GVL_HMI.aSolventAndTimesRows[1].Rinse2);
Wash1 := INT_TO_STRING(GVL_HMI.aSolventAndTimesRows[1].Wash1);
Wash2 := INT_TO_STRING(GVL_HMI.aSolventAndTimesRows[1].Wash2);
Rinse12 := INT_TO_STRING(GVL_HMI.aSolventAndTimesRows[2].Rinse1);
Rinse22 := INT_TO_STRING(GVL_HMI.aSolventAndTimesRows[2].Rinse2);
Wash12 := INT_TO_STRING(GVL_HMI.aSolventAndTimesRows[2].Wash1);
Wash22 := INT_TO_STRING(GVL_HMI.aSolventAndTimesRows[2].Wash2);
Rinse13 := INT_TO_STRING(GVL_HMI.aSolventAndTimesRows[3].Rinse1);
Rinse23 := INT_TO_STRING(GVL_HMI.aSolventAndTimesRows[3].Rinse2);
Wash13 := INT_TO_STRING(GVL_HMI.aSolventAndTimesRows[3].Wash1);
Wash23 := INT_TO_STRING(GVL_HMI.aSolventAndTimesRows[3].Wash2);
soakTime := REAL_TO_STRING(GVL_HMI.aOtherParamsRows[1].Value) ;
agitate_1_Time := REAL_TO_STRING(GVL_HMI.aOtherParamsRows[2].Value);
agitate_2_Time := REAL_TO_STRING(GVL_HMI.aOtherParamsRows[3].Value);
vialsToFill := REAL_TO_STRING(GVL_HMI.aOtherParamsRows[4].Value);
vialPrimeVol := REAL_TO_STRING(GVL_HMI.aOtherParamsRows[5].Value);
vial_1_FillVol := REAL_TO_STRING(GVL_HMI.aOtherParamsRows[6].Value);
vial_2_4_FillVol := REAL_TO_STRING(GVL_HMI.aOtherParamsRows[7].Value);
airDryTime := REAL_TO_STRING(GVL_HMI.aOtherParamsRows[8].Value);


IF start THEN
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#1#'), pInsertString:= ADR(GVL_HMI.stRecipeInfo.sMethodName), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#2#'), pInsertString:= ADR(iRevision), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#3#'), pInsertString:= ADR(GVL_HMI.stRecipeInfo.sCreatedBy), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#4#'), pInsertString:= ADR(dCreationDate), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#5#'), pInsertString:= ADR(Rinse1), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#6#'), pInsertString:= ADR(Rinse2), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#7#'), pInsertString:= ADR(Wash1), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#8#'), pInsertString:= ADR(Wash2), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#9#'), pInsertString:= ADR(Rinse12), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#10#'), pInsertString:= ADR(Rinse22), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#11#'), pInsertString:= ADR(Wash12), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#12#'), pInsertString:= ADR(Wash22), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#13#'), pInsertString:= ADR(Rinse13), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#14#'), pInsertString:= ADR(Rinse23), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#15#'), pInsertString:= ADR(Wash13), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#16#'), pInsertString:= ADR(Wash23), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#17#'), pInsertString:= ADR(soakTime), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#18#'), pInsertString:= ADR(agitate_1_Time), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#19#'), pInsertString:= ADR(agitate_2_Time), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#20#'), pInsertString:= ADR(vialsToFill), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#21#'), pInsertString:= ADR(vialPrimeVol), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#22#'), pInsertString:= ADR(vial_1_FillVol), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#23#'), pInsertString:= ADR(vial_2_4_FillVol), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#24#'), pInsertString:= ADR(airDryTime), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#25#'), pInsertString:= ADR('activated'), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));

END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="insertRunValues" Id="{0319136d-2abf-43a1-b3bf-c358d6f9b273}">
      <Declaration><![CDATA[METHOD insertRunValues : BOOL
VAR_INPUT
	start: bool;
END_VAR

VAR
	methodID: STRING;
	CalibrationNo: STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[methodID:= INT_TO_STRING(GVL_DB.stPostRunInfo.methodID);
CalibrationNo:= INT_TO_STRING(GVL_DB.stPostRunInfo.CalibrationNo);

IF start THEN
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#1#'), pInsertString:= ADR(GVL_DB.stPostRunInfo.analyst), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#2#'), pInsertString:= ADR(GVL_DB.stPostRunInfo.comment), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#3#'), pInsertString:= ADR(GVL_DB.stPostRunInfo.softwareVersion), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#4#'), pInsertString:= ADR(GVL_DB.stPostRunInfo.sysMasterRevision), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#5#'), pInsertString:= ADR(GVL_DB.stPostRunInfo.sysSettingsRevision), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#6#'), pInsertString:= ADR(GVL_DB.stPostRunInfo.meterVelocity), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#7#'), pInsertString:= ADR(GVL_DB.stPostRunInfo.runVelocity), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#8#'), pInsertString:= ADR(GVL_DB.stPostRunInfo.emptyTubesFactor), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#9#'), pInsertString:= ADR(GVL_DB.stPostRunInfo.fillTubesFactor), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#10#'), pInsertString:= ADR(GVL_DB.stPostRunInfo.solvent1NameRevision), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#11#'), pInsertString:= ADR(GVL_DB.stPostRunInfo.solvent2NameRevision), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#12#'), pInsertString:= ADR(GVL_DB.stPostRunInfo.solvent3NameRevision), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#13#'), pInsertString:= ADR(GVL_DB.stPostRunInfo.solvent4NameRevision), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#14#'), pInsertString:= ADR(GVL_DB.stPostRunInfo.timeEventStarted), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#15#'), pInsertString:= ADR(GVL_DB.stPostRunInfo.timeEventCompleted), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#16#'), pInsertString:= ADR(methodID), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#17#'), pInsertString:= ADR(CalibrationNo), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="insertSolvent" Id="{72d5efef-5f2e-4a79-85ba-b7b766cc3cd9}">
      <Declaration><![CDATA[METHOD insertSolvent : BOOL
VAR_INPUT
	start: BOOL;
END_VAR


VAR

END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[

IF start THEN
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#1#'), pInsertString:= ADR(GVL_DB.stSolvents.solventName1), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#2#'), pInsertString:= ADR(GVL_DB.stSolvents.solventName2), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#3#'), pInsertString:= ADR(GVL_DB.stSolvents.solventName3), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#4#'), pInsertString:= ADR(GVL_DB.stSolvents.solventName4), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#5#'), pInsertString:= ADR(GVL_DB.stSolvents.density1), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#6#'), pInsertString:= ADR(GVL_DB.stSolvents.density2), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#7#'), pInsertString:= ADR(GVL_DB.stSolvents.density3), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#8#'), pInsertString:= ADR(GVL_DB.stSolvents.density4), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#9#'), pInsertString:= ADR(GVL_DB.stSolvents.addedBy), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#10#'), pInsertString:= ADR(GVL_DB.stSolvents.addedDate), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="insertSys" Id="{53667956-19d2-445b-bdaf-4b8baaabd0fa}">
      <Declaration><![CDATA[METHOD insertSys : BOOL
VAR_INPUT
	start: BOOL;
END_VAR

VAR
	bGeneralSealAndPump: STRING;
	rAcceptanceCriteria: STRING;
	iAllowableFailures: STRING;
	iReplicatesSetpoint: STRING;
	iCalIntervalDays: STRING;
	iAirDryTimeSec: STRING;
	iAllowableLeakTestFailures: STRING;
	tLeakTestBuildUpTime: STRING;
	tLeakTestMonitorTime: STRING;
	rLeakTestPressureLimit: STRING;
	sealPosition: STRING;
	dryposition: STRING;
	rM1Velocity: STRING;
	iMeterVelocity: STRING;
	iRunVelocity: STRING;
	iEmptyFactor: STRING;
	iFillolventTubesFactor: STRING;
	abovecalibration: STRING;
	vialsetspacing: STRING;
	intoresbottom: STRING;
	intodispense: STRING;
	intoweight: STRING;
	intovials: STRING;
	bDisplayManualControl: STRING;
	bCheckLogonEachRun: STRING;
	abovevialset1: STRING;
	intoWaste: STRING;
	userName: STRING;
	savedDate: STRING;
	
	// Timestamp generation (local system time)
    fbLocalSystemTime : FB_LocalSystemTime;
    stLocal           : TIMESTRUCT;
    sStamp            : STRING(32);
    sHH               : STRING(2);
    sMM               : STRING(2);
    sSS               : STRING(2);
    sMMo              : STRING(3);
    sDD               : STRING(2);
	bDTReady		  : BOOL := FALSE;

END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[bGeneralSealAndPump := BOOL_TO_STRING(GVL_Settings.bGeneralSealAndPump);
rAcceptanceCriteria := LREAL_TO_STRING(GVL_Settings.stCalibParameters.rAcceptanceCriteria);
iAllowableFailures  := USINT_TO_STRING(GVL_Settings.stCalibParameters.iAllowableFailures);
iReplicatesSetpoint := UINT_TO_STRING(GVL_Settings.stCalibParameters.iReplicatesSetpoint);
iCalIntervalDays := UINT_TO_STRING(GVL_Settings.stCalibParameters.iCalIntervalDays);
iAirDryTimeSec := UINT_TO_STRING(GVL_Settings.stCalibParameters.iAirDryTimeSec);
iAllowableLeakTestFailures := UINT_TO_STRING(GVL_Settings.stLeakTestParameters.iAllowableLeakTestFailures);
tLeakTestBuildUpTime := UINT_TO_STRING(GVL_Settings.stLeakTestParameters.tLeakTestBuildUpTime);
tLeakTestMonitorTime := UINT_TO_STRING(GVL_Settings.stLeakTestParameters.tLeakTestMonitorTime);
rLeakTestPressureLimit := REAL_TO_STRING(GVL_Settings.stLeakTestParameters.rLeakTestPressureLimit);
sealPosition := INT_TO_STRING(GVL_Settings.stMachineParam.aM1Position[2]);
dryposition := INT_TO_STRING(GVL_Settings.stMachineParam.aM1Position[3]);
rM1Velocity := LREAL_TO_STRING(GVL_Settings.stMachineParam.rM1Velocity);
iMeterVelocity := UINT_TO_STRING(GVL_Settings.stPumpParameters.iMeterVelocity);
iRunVelocity := UINT_TO_STRING(GVL_Settings.stPumpParameters.iRunVelocity);
iEmptyFactor := UINT_TO_STRING(GVL_Settings.stPumpParameters.iEmptyFactor);
iFillolventTubesFactor := UINT_TO_STRING(GVL_Settings.stPumpParameters.iFillolventTubesFactor);
abovecalibration := INT_TO_STRING(GVL_Settings.stMachineParam.aM3Position[4]);
vialsetspacing := INT_TO_STRING(GVL_Settings.stMachineParam.aM3Position[3]);
intoresbottom := INT_TO_STRING(GVL_Settings.stMachineParam.aM2Position[4]);
intodispense := INT_TO_STRING(GVL_Settings.stMachineParam.aM2Position[5]);
intoweight := INT_TO_STRING(GVL_Settings.stMachineParam.aM2Position[6]);
intovials := INT_TO_STRING(GVL_Settings.stMachineParam.aM2Position[3]);
bDisplayManualControl := BOOL_TO_STRING(GVL_Settings.bDisplayManualControl);
bCheckLogonEachRun := BOOL_TO_STRING(GVL_Settings.bCheckLogonEachRun);
abovevialset1 := INT_TO_STRING(GVL_Settings.stMachineParam.aM3Position[2]);
intoWaste := INT_TO_STRING(GVL_Settings.stMachineParam.aM2Position[2]);
userName := GVL_HMI.sUserNameEventTriggered;
savedDate := GVL_HMI.sDateAndTimeEventTriggered;

IF start THEN
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#1#'), pInsertString:= ADR(bGeneralSealAndPump), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#2#'), pInsertString:= ADR(rAcceptanceCriteria), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#3#'), pInsertString:= ADR(iAllowableFailures), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#4#'), pInsertString:= ADR(iReplicatesSetpoint), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#5#'), pInsertString:= ADR(iCalIntervalDays), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#6#'), pInsertString:= ADR('N/A'), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#7#'), pInsertString:= ADR(iAirDryTimeSec), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#8#'), pInsertString:= ADR(iAllowableLeakTestFailures), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#9#'), pInsertString:= ADR(tLeakTestBuildUpTime), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#10#'), pInsertString:= ADR(tLeakTestMonitorTime), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#11#'), pInsertString:= ADR(rLeakTestPressureLimit), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
