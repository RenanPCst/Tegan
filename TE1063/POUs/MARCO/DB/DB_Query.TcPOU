      <Declaration><![CDATA[METHOD selectVD : BOOL
VAR_INPUT
	start: BOOL;
	methodID: STRING;
END_VAR


]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF start THEN
FindAndReplace(pSrcString:= ADR(cmdSlc), pDeleteString:= ADR('#1#'), pInsertString:= ADR(methodID), pDstString:= ADR(cmdSlc), nDstSize:= SIZEOF(cmdSlc));
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="updateMethod" Id="{5b8b5bab-8814-45bd-98b5-1066903aae2f}">
      <Declaration><![CDATA[METHOD updateMethod : BOOL
VAR_INPUT
	start: BOOL;
	methodName: STRING;
	methodRevision: STRING;
END_VAR


]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF start THEN
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#1#'), pInsertString:= ADR(methodName), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#2#'), pInsertString:= ADR(methodRevision), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
END_IF]]></ST>
      </Implementation>
    </Method>
