<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="DB_Query" Id="{041a0fa5-6dba-4aa5-91f2-97a1fbd1ea5d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM DB_Query
VAR
	FB_SelectArray: FB_DBRecordArraySelect;
	FB_Insert: FB_DBRecordInsert_EX;
	cmd         : T_Maxstring := 'SELECT [ID], [userID], [accessLevel], [addDate], [enteredBy], [test] FROM [dbo].[TABLE01] ';
	insertString		: STRING(5000) := 'INSERT INTO [dbo].[TABLE01] ([NAME]) VALUES ( $'#1#$' )';
    (* Unter ARM*) 
    (*cmd       : T_Maxstring := 'SELECT ID,Timestamp,Value,Name FROM myTable'*)
    (*----------*)
    recordArray : ARRAY [1..5] OF ST_Data_CUL;
    busy        : BOOL;
    err         : BOOL;
    errid       : UDINT;
    sqlstate    : ST_DBSQLError;
    recAnz      : UDINT;
	bExecute	: BOOL;
	bExecute2	: BOOL;
	bExecuteIn	: BOOL;
	nome: STRING;
	cmdIn: STRING(5000);
	state: (IDLE_STATE, ERROR_STATE, SELECT_POST_LAST_RUN, SELECT_POST_LAST_RUN_ID, SELECT_VD_BY_NO, INSERT_RUN, INSERT_RUN_VD);
	status: STRING;
	str: STRING;
	lastRunID: STRING;
	i: INT;
	tempCmd: string(5000);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[FindAndReplace(pSrcString:= ADR(insertString), pDeleteString:= ADR('#1#'), pInsertString:= ADR(nome), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));

(*
FB_SelectArray(
    sNetID:= ,
    hDBID:= 1,
    cbCmdSize:= SIZEOF(cmd),
    pCmdAddr:= ADR(cmd),
    nStartIndex:= 0,
    nRecordCount:= 5,
    cbRecordArraySize:= SIZEOF(recordArray),
    pDestAddr:= ADR(recordArray),
    bExecute:= bExecute2,
    tTimeout:= T#15s,
    bBusy=> busy,
    bError=> err,
    nErrID=> errid,
    sSQLState=> sqlstate,
    nRecords=> recAnz);
	
FB_Insert(

	sNetID:= ,
	hDBID:= 1,
	cbCmdSize:= SIZEOF(cmdIn),
	pCmdAddr:= ADR(cmdIn),
	bExecute:= bExecuteIn,
	tTimeout:= T#15S,
	bBusy=> busy,
    bError=> err,
    nErrID=> errid,
    sSQLState=> sqlstate);*)
	

CASE state OF
	
IDLE_STATE:
	
	IF bExecuteIn THEN
 	state:= INSERT_RUN;
	ELSIF bExecute THEN
	state:= SELECT_POST_LAST_RUN;	
	ELSE
	state:= IDLE_STATE;
	END_IF
	
SELECT_POST_LAST_RUN:
	
	FB_SelectArray(
    sNetID:= ,
    hDBID:= 1,
    cbCmdSize:= SIZEOF(GVL_Report.slctLastRun),
    pCmdAddr:= ADR(GVL_Report.slctLastRun),
    nStartIndex:= 0,
    nRecordCount:= 5,
    cbRecordArraySize:= SIZEOF(GVL_Report.stPostRunReport),
    pDestAddr:= ADR(GVL_Report.stPostRunReport),
    bExecute:= bExecute,
    tTimeout:= T#15s,
    bBusy=> busy,
    bError=> err,
    nErrID=> errid,
    sSQLState=> sqlstate,
    nRecords=> recAnz);
	
	IF NOT FB_SelectArray.bBusy THEN
		state:= IDLE_STATE;
		bExecute:= FALSE;
	ELSIF FB_SelectArray.bError THEN	
		state:= ERROR_STATE;
	ELSE
		state:= SELECT_POST_LAST_RUN;
		bExecute:= FALSE;
	END_IF
	
	
SELECT_POST_LAST_RUN_ID:
	
	FB_SelectArray(
    sNetID:= ,
    hDBID:= 1,
    cbCmdSize:= SIZEOF(GVL_Report.slctLastRunID),
    pCmdAddr:= ADR(GVL_Report.slctLastRunID),
    nStartIndex:= 0,
    nRecordCount:= 1,
    cbRecordArraySize:= SIZEOF(GVL_Report.lastRunID),
    pDestAddr:= ADR(GVL_Report.lastRunID),
    bExecute:= bExecute,
    tTimeout:= T#15s,
    bBusy=> busy,
    bError=> err,
    nErrID=> errid,
    sSQLState=> sqlstate,
    nRecords=> recAnz);
	
	IF NOT FB_SelectArray.bBusy THEN
		state:= IDLE_STATE;
		bExecute:= FALSE;
	ELSIF FB_SelectArray.bError THEN	
		state:= ERROR_STATE;
	ELSE
		state:= SELECT_POST_LAST_RUN_ID;
		bExecute:= FALSE;
	END_IF
	
SELECT_VD_BY_NO:
	insertString:= GVL_Report.slctVDbyNo;
	lastRunID := INT_TO_STRING(GVL_Report.lastRunID[0]);
	FindAndReplace(pSrcString:= ADR(insertString), pDeleteString:= ADR('#1#'), pInsertString:= ADR(lastRunID), pDstString:= ADR(GVL_Report.slctVDbyNo), nDstSize:= SIZEOF(GVL_Report.slctVDbyNo));
	
	FB_SelectArray(
    sNetID:= ,
    hDBID:= 1,
    cbCmdSize:= SIZEOF(GVL_Report.slctVDbyNo),
    pCmdAddr:= ADR(GVL_Report.slctVDbyNo),
    nStartIndex:= 0,
    nRecordCount:= 10,
    cbRecordArraySize:= SIZEOF(GVL_Report.astVolData),
    pDestAddr:= ADR(GVL_Report.astVolData),
    bExecute:= bExecute,
    tTimeout:= T#15s,
    bBusy=> busy,
    bError=> err,
    nErrID=> errid,
    sSQLState=> sqlstate,
    nRecords=> recAnz);
	
	IF NOT FB_SelectArray.bBusy THEN
		state:= IDLE_STATE;
		bExecute:= FALSE;
	ELSIF FB_SelectArray.bError THEN	
		state:= ERROR_STATE;
	ELSE
		state:= SELECT_VD_BY_NO;
		bExecute:= FALSE;
	END_IF
	

INSERT_RUN:
	
	cmdIn:= GVL_Report.isrtRun;
	insertRunValues(start:=bExecuteIn);
	FB_Insert(
		sNetID:= ,
		hDBID:= 1,
		cbCmdSize:= SIZEOF(cmdIn),
		pCmdAddr:= ADR(cmdIn),
		bExecute:= bExecuteIn,
		tTimeout:= T#15S,
		bBusy=> busy,
    	bError=> err,
    	nErrID=> errid,
    	sSQLState=> sqlstate);
	
	IF NOT FB_Insert.bBusy THEN
		state:= IDLE_STATE;
		bExecuteIn:= FALSE;
	ELSIF FB_Insert.bError THEN	
		state:= ERROR_STATE;
	ELSE
		state:= INSERT_RUN;
		bExecuteIn:= FALSE;
	END_IF

INSERT_RUN_VD:
	cmdIn:= GVL_Report.isrtVD;
	insertRunVD(start:=bExecuteIn);
	FB_Insert(
		sNetID:= ,
		hDBID:= 1,
		cbCmdSize:= SIZEOF(cmdIn),
		pCmdAddr:= ADR(cmdIn),
		bExecute:= bExecuteIn,
		tTimeout:= T#15S,
		bBusy=> busy,
    	bError=> err,
    	nErrID=> errid,
    	sSQLState=> sqlstate);
	
	IF NOT FB_Insert.bBusy THEN
		state:= IDLE_STATE;
		bExecuteIn:= FALSE;
	ELSIF FB_Insert.bError THEN	
		state:= ERROR_STATE;
	ELSE
		state:= INSERT_RUN_VD;
		bExecuteIn:= FALSE;
	END_IF
	
ERROR_STATE:
	bExecute:= FALSE;
	status:= 'SQL Error!';
	state:= IDLE_STATE;
	
	
END_CASE]]></ST>
    </Implementation>
    <Method Name="insertRunValues" Id="{0319136d-2abf-43a1-b3bf-c358d6f9b273}">
      <Declaration><![CDATA[METHOD insertRunValues : BOOL
VAR_INPUT
	start: bool;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF start THEN
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#1#'), pInsertString:= ADR(GVL_Report.stPostRunReport[0].methodName), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#2#'), pInsertString:= ADR(GVL_Report.stPostRunReport[0].methodRevision), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#3#'), pInsertString:= ADR(GVL_Report.stPostRunReport[0].methodCreatedBy), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#4#'), pInsertString:= ADR(GVL_Report.stPostRunReport[0].methodCreatedOn), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#5#'), pInsertString:= ADR(GVL_Report.stPostRunReport[0].solvent_R1), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#6#'), pInsertString:= ADR(GVL_Report.stPostRunReport[0].solvent_R2), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#7#'), pInsertString:= ADR(GVL_Report.stPostRunReport[0].solvent_W1), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#8#'), pInsertString:= ADR(GVL_Report.stPostRunReport[0].solvent_W2), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#9#'), pInsertString:= ADR(GVL_Report.stPostRunReport[0].time_R1), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#10#'), pInsertString:= ADR(GVL_Report.stPostRunReport[0].time_R2), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#11#'), pInsertString:= ADR(GVL_Report.stPostRunReport[0].time_W1), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#12#'), pInsertString:= ADR(GVL_Report.stPostRunReport[0].time_W2), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#13#'), pInsertString:= ADR(GVL_Report.stPostRunReport[0].velocity_R1), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#14#'), pInsertString:= ADR(GVL_Report.stPostRunReport[0].velocity_R2), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#15#'), pInsertString:= ADR(GVL_Report.stPostRunReport[0].velocity_W1), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#16#'), pInsertString:= ADR(GVL_Report.stPostRunReport[0].velocity_W2), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#17#'), pInsertString:= ADR(GVL_Report.stPostRunReport[0].soakTime), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#18#'), pInsertString:= ADR(GVL_Report.stPostRunReport[0].agitate_1_Time), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#19#'), pInsertString:= ADR(GVL_Report.stPostRunReport[0].agitate_2_Time), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#20#'), pInsertString:= ADR(GVL_Report.stPostRunReport[0].vialsToFill), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#21#'), pInsertString:= ADR(GVL_Report.stPostRunReport[0].vialPrimeVol), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
