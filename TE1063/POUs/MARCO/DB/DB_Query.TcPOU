    <Method Name="selectMethodReportSearchByDate" Id="{ba118487-bb6a-4561-a914-622c9ea0ecf3}">
      <Declaration><![CDATA[METHOD selectMethodReportSearchByDate : BOOL
VAR_INPUT
	start    : BOOL;
	dateFrom : STRING;
	dateTo   : STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Builds the date-filtered method report search query (latest revision per method).
// Replaces #1# with dateFrom and #2# with dateTo.
IF start THEN
    cmdSlc := GVL_DB.slctMethodReportSearchLatestByDate;

    FindAndReplace(
        pSrcString    := ADR(cmdSlc),
        pDeleteString := ADR('#1#'),
        pInsertString := ADR(dateFrom),
        pDstString    := ADR(cmdSlc),
        nDstSize      := SIZEOF(cmdSlc)
    );

    FindAndReplace(
        pSrcString    := ADR(cmdSlc),
        pDeleteString := ADR('#2#'),
        pInsertString := ADR(dateTo),
        pDstString    := ADR(cmdSlc),
        nDstSize      := SIZEOF(cmdSlc)
    );
END_IF]]></ST>
      </Implementation>
    </Method>
