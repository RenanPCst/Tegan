E_DB_QUERY_STATE.SELECT_ALL_CURRENT_USERS:
	
	cmdSlc:= GVL_DB.slctCurrentUser;
	FB_SelectArray(sNetID:= , hDBID:= 1, cbCmdSize:= SIZEOF(cmdSlc), pCmdAddr:= ADR(cmdSlc), nStartIndex:= 0, nRecordCount:= 500, cbRecordArraySize:= SIZEOF(GVL_DB.astData_CUL), pDestAddr:= ADR(GVL_DB.astData_CUL), bExecute:= TRUE, tTimeout:= T#15S, bBusy=> busy, bError=> err, nErrID=> errid, sSQLState=> sqlstate, nRecords=> recAnz);
	
	IF NOT FB_SelectArray.bBusy THEN
		state:= E_DB_QUERY_STATE.IDLE_STATE;
		bExecute:= FALSE;
	ELSIF FB_SelectArray.bError THEN	
		state:= E_DB_QUERY_STATE.ERROR_STATE;
	ELSE
		state:= E_DB_QUERY_STATE.SELECT_ALL_CURRENT_USERS;
		bExecute:= FALSE;
	END_IF
	
E_DB_QUERY_STATE.SELECT_ALL_USERS:
	
	cmdSlc:= GVL_DB.slctAllUsers;
	FB_SelectArray(sNetID:= , hDBID:= 1, cbCmdSize:= SIZEOF(cmdSlc), pCmdAddr:= ADR(cmdSlc), nStartIndex:= 0, nRecordCount:= 1000, cbRecordArraySize:= SIZEOF(GVL_DB.astData_CUL), pDestAddr:= ADR(GVL_DB.astData_CUL), bExecute:= TRUE, tTimeout:= T#15S, bBusy=> busy, bError=> err, nErrID=> errid, sSQLState=> sqlstate, nRecords=> recAnz);
	
	IF NOT FB_SelectArray.bBusy THEN
		state:= E_DB_QUERY_STATE.IDLE_STATE;
		bExecute:= FALSE;
	ELSIF FB_SelectArray.bError THEN	
		state:= E_DB_QUERY_STATE.ERROR_STATE;
	ELSE
		state:= E_DB_QUERY_STATE.SELECT_ALL_USERS;
		bExecute:= FALSE;
	END_IF
	
E_DB_QUERY_STATE.SELECT_LAST_SOLVENT:
	
	cmdSlc:= GVL_DB.slctSolvent;

	FB_SelectArray(
		sNetID:= ,
		hDBID:= 1,
		cbCmdSize:= SIZEOF(cmdSlc),
		pCmdAddr:= ADR(cmdSlc),
		nStartIndex:= 0,
		nRecordCount:= 1,
		cbRecordArraySize:= SIZEOF(GVL_DB.stSolvents),
		pDestAddr:= ADR(GVL_DB.stSolvents),
		bExecute:= TRUE,
		tTimeout:= T#15S,
		bBusy=> busy,
		bError=> err,
		nErrID=> errid,
		sSQLState=> sqlstate,
		nRecords=> recAnz
	);
	
	IF NOT FB_SelectArray.bBusy THEN
		state:= E_DB_QUERY_STATE.IDLE_STATE;
		bExecute:= FALSE;

