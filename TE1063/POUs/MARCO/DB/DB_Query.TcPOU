E_DB_QUERY_STATE.SELECT_COMPLETE_METHOD_REPORT:

    GVL_Reports.bLoadBusy   := TRUE;
    GVL_Reports.bLoadDone   := FALSE;
    GVL_Reports.bLoadError  := FALSE;
    GVL_Reports.sLoadStatus := 'Loading complete method history report...';

    IF NOT bInitSelectCompleteMethodReport THEN
        bInitSelectCompleteMethodReport := TRUE;
        bInitSelectCompleteMethodVolumes := FALSE;
        iCompleteMethodIndex := 1;

        Clear_CompleteMethodHeaderBuffer();
        Clear_CompleteMethodReportBuffer();

        cmdSlc := GVL_DB.slctAllMethodsForCompleteReport;
        bExecute := TRUE;
    ELSE
        bExecute := FALSE;
    END_IF

    FB_SelectArray(
        sNetID := ,
        hDBID := 1,
        cbCmdSize := SIZEOF(cmdSlc),
        pCmdAddr := ADR(cmdSlc),
        nStartIndex := 0,
        nRecordCount := 50,
        cbRecordArraySize := SIZEOF(GVL_Reports.aCompleteMethodHeader),
        pDestAddr := ADR(GVL_Reports.aCompleteMethodHeader),
        bExecute := bExecute,
        tTimeout := T#15S,
        bBusy => busy,
        bError => err,
        nErrID => errid,
        sSQLState => sqlstate,
        nRecords => recAnz
    );

    IF FB_SelectArray.bError THEN
        bInitSelectCompleteMethodReport := FALSE;
        GVL_Reports.bLoadBusy   := FALSE;
        GVL_Reports.bLoadDone   := FALSE;
        GVL_Reports.bLoadError  := TRUE;
        GVL_Reports.sLoadStatus := 'Error loading complete method history report';
        state := E_DB_QUERY_STATE.ERROR_STATE;

    ELSIF NOT FB_SelectArray.bBusy AND bInitSelectCompleteMethodReport THEN
        bInitSelectCompleteMethodReport := FALSE;

        IF recAnz > 0 THEN
            iCompleteMethodIndex := 1;
            state := E_DB_QUERY_STATE.SELECT_COMPLETE_METHOD_REPORT_VOLUMES;
        ELSE
            GVL_Reports.bLoadBusy   := FALSE;
            GVL_Reports.bLoadDone   := FALSE;
            GVL_Reports.bLoadError  := TRUE;
            GVL_Reports.sLoadStatus := 'No method history records found';
            state := E_DB_QUERY_STATE.IDLE_STATE;
        END_IF

    ELSE
        state := E_DB_QUERY_STATE.SELECT_COMPLETE_METHOD_REPORT;
    END_IF

E_DB_QUERY_STATE.SELECT_COMPLETE_METHOD_REPORT_VOLUMES:

    GVL_Reports.bLoadBusy   := TRUE;
    GVL_Reports.bLoadDone   := FALSE;
    GVL_Reports.bLoadError  := FALSE;
    GVL_Reports.sLoadStatus := 'Loading method volume data...';

    IF iCompleteMethodIndex > 50 OR GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].methodID = 0 THEN
        GVL_Reports.bLoadBusy      := FALSE;
        GVL_Reports.bLoadDone      := TRUE;
        GVL_Reports.bLoadError     := FALSE;
        GVL_Reports.bPdfDataReady  := TRUE;
        GVL_Reports.bPdfConsumed   := FALSE;
        GVL_Reports.sLoadStatus    := 'Complete method history report loaded';
        state := E_DB_QUERY_STATE.IDLE_STATE;

    ELSE
        // Copy flat header into final struct
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].methodName := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].methodName;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].methodRevision := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].methodRevision;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].methodCreatedBy := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].methodCreatedBy;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].methodCreatedOn := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].methodCreatedOn;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].solvent_R1 := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].solvent_R1;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].solvent_R2 := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].solvent_R2;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].solvent_W1 := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].solvent_W1;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].solvent_W2 := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].solvent_W2;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].time_R1 := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].time_R1;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].time_R2 := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].time_R2;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].time_W1 := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].time_W1;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].time_W2 := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].time_W2;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].velocity_R1 := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].velocity_R1;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].velocity_R2 := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].velocity_R2;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].velocity_W1 := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].velocity_W1;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].velocity_W2 := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].velocity_W2;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].soakTime := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].soakTime;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].agitate_1_Time := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].agitate_1_Time;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].agitate_2_Time := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].agitate_2_Time;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].vialsToFill := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].vialsToFill;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].vialPrimeVol := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].vialPrimeVol;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].vial_1_FillVol := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].vial_1_FillVol;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].vial_2_4_FillVol := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].vial_2_4_FillVol;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].airDryTime := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].airDryTime;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].methodID := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].methodID;
        GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].methodStatus := GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].methodStatus;

        sCompleteMethodID := INT_TO_STRING(GVL_Reports.aCompleteMethodHeader[iCompleteMethodIndex].methodID);

        IF NOT bInitSelectCompleteMethodVolumes THEN
            bInitSelectCompleteMethodVolumes := TRUE;

            selectRecipeVolumeByID(start := TRUE, methodID := sCompleteMethodID);
            bExecute := TRUE;
        ELSE
            bExecute := FALSE;
        END_IF

        FB_SelectArray(
            sNetID := ,
            hDBID := 1,
            cbCmdSize := SIZEOF(cmdSlc),
            pCmdAddr := ADR(cmdSlc),
            nStartIndex := 0,
            nRecordCount := 10,
            cbRecordArraySize := SIZEOF(GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].volumeData),
            pDestAddr := ADR(GVL_Reports.aCompleteMethodReport[iCompleteMethodIndex].volumeData),
            bExecute := bExecute,
            tTimeout := T#15S,
            bBusy => busy,
            bError => err,
            nErrID => errid,
            sSQLState => sqlstate,
            nRecords => recAnz
        );

        IF FB_SelectArray.bError THEN
            bInitSelectCompleteMethodVolumes := FALSE;
            GVL_Reports.bLoadBusy   := FALSE;
            GVL_Reports.bLoadDone   := FALSE;
            GVL_Reports.bLoadError  := TRUE;
            GVL_Reports.sLoadStatus := 'Error loading method volume data';
            state := E_DB_QUERY_STATE.ERROR_STATE;

        ELSIF NOT FB_SelectArray.bBusy AND bInitSelectCompleteMethodVolumes THEN
            bInitSelectCompleteMethodVolumes := FALSE;
            iCompleteMethodIndex := iCompleteMethodIndex + 1;
            state := E_DB_QUERY_STATE.SELECT_COMPLETE_METHOD_REPORT_VOLUMES;

        ELSE
            state := E_DB_QUERY_STATE.SELECT_COMPLETE_METHOD_REPORT_VOLUMES;
        END_IF
    END_IF

E_DB_QUERY_STATE.INSERT_USER_MGMT_HISTORY:

    cmdIn := GVL_DB.isrtUserMgmtHistory;

    insertUserMgmtHistory(start := TRUE);

    GVL_HMI.stUserMgmtHistoryEvent.bBusy := TRUE;
    GVL_HMI.stUserMgmtHistoryEvent.bDone := FALSE;
    GVL_HMI.stUserMgmtHistoryEvent.bError := FALSE;
    GVL_HMI.stUserMgmtHistoryEvent.sErrorText := '';

    FB_Insert(
        sNetID := ,
        hDBID := 1,
        cbCmdSize := SIZEOF(cmdIn),
        pCmdAddr := ADR(cmdIn),
        bExecute := TRUE,
        tTimeout := T#15S,
        bBusy => busy,
        bError => err,
        nErrID => errid,
        sSQLState => sqlstate
    );

    IF FB_Insert.bError THEN

		GVL_HMI.stUserMgmtHistoryEvent.bExecute := FALSE;
		GVL_HMI.stUserMgmtHistoryEvent.bBusy := FALSE;
		GVL_HMI.stUserMgmtHistoryEvent.bDone := FALSE;
		GVL_HMI.stUserMgmtHistoryEvent.bError := TRUE;
		GVL_HMI.stUserMgmtHistoryEvent.sErrorText := CONCAT('DB insert error. SQLState: ', sqlstate.sSQLState);
	
		state := E_DB_QUERY_STATE.ERROR_STATE;
		bExecuteIn := FALSE;
	
	ELSIF NOT FB_Insert.bBusy THEN
	
		GVL_HMI.stUserMgmtHistoryEvent.bExecute := FALSE;
		GVL_HMI.stUserMgmtHistoryEvent.bBusy := FALSE;
		GVL_HMI.stUserMgmtHistoryEvent.bDone := TRUE;
		GVL_HMI.stUserMgmtHistoryEvent.bError := FALSE;
		GVL_HMI.stUserMgmtHistoryEvent.sErrorText := '';
	
		state := E_DB_QUERY_STATE.IDLE_STATE;
		bExecuteIn := FALSE;
	
	ELSE
	
		state := E_DB_QUERY_STATE.INSERT_USER_MGMT_HISTORY;
		bExecuteIn := FALSE;
	
	END_IF
	
E_DB_QUERY_STATE.ERROR_STATE:

	bExecute:= FALSE;
	status:= 'SQL Error!';
	state:= E_DB_QUERY_STATE.IDLE_STATE;
		
END_CASE]]></ST>
    </Implementation>
