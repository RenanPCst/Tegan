	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#3#'), pInsertString:= ADR(GVL_DB.astData_CUL[line].transactionType), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#4#'), pInsertString:= ADR(GVL_DB.astData_CUL[line].transactionDate), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#5#'), pInsertString:= ADR(GVL_DB.astData_CUL[line].transactedBy), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#6#'), pInsertString:= ADR(GVL_DB.astData_CUL[line].addDate), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#7#'), pInsertString:= ADR(GVL_DB.astData_CUL[line].enteredBy), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="insertUserMgmtHistory" Id="{75d095ba-0b46-45e1-8ab8-13663351d9ac}">
      <Declaration><![CDATA[METHOD insertUserMgmtHistory : BOOL
VAR_INPUT
	start : BOOL := FALSE;
END_VAR
VAR
    sOldAutoLogoutMin : STRING(20);
    sNewAutoLogoutMin : STRING(20);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[sOldAutoLogoutMin := INT_TO_STRING(GVL_HMI.stUserMgmtHistoryEvent.iOldAutoLogoutMin);
sNewAutoLogoutMin := INT_TO_STRING(GVL_HMI.stUserMgmtHistoryEvent.iNewAutoLogoutMin);

IF start THEN

    FindAndReplace(
        pSrcString := ADR(cmdIn), 
        pDeleteString := ADR('#1#'), 
        pInsertString := ADR(GVL_HMI.stUserMgmtHistoryEvent.sTargetUser), 
        pDstString := ADR(cmdIn), 
        nDstSize := SIZEOF(cmdIn)
    );

    FindAndReplace(
        pSrcString := ADR(cmdIn), 
        pDeleteString := ADR('#2#'), 
        pInsertString := ADR(GVL_HMI.stUserMgmtHistoryEvent.sEventType), 
        pDstString := ADR(cmdIn), 
        nDstSize := SIZEOF(cmdIn)
    );

    FindAndReplace(
        pSrcString := ADR(cmdIn), 
        pDeleteString := ADR('#3#'), 
        pInsertString := ADR(GVL_HMI.stUserMgmtHistoryEvent.sOldGroup), 
        pDstString := ADR(cmdIn), 
        nDstSize := SIZEOF(cmdIn)
    );

    FindAndReplace(
        pSrcString := ADR(cmdIn), 
        pDeleteString := ADR('#4#'), 
        pInsertString := ADR(GVL_HMI.stUserMgmtHistoryEvent.sNewGroup), 
        pDstString := ADR(cmdIn), 
        nDstSize := SIZEOF(cmdIn)
    );

    FindAndReplace(
        pSrcString := ADR(cmdIn), 
        pDeleteString := ADR('#5#'), 
        pInsertString := ADR(sOldAutoLogoutMin), 
        pDstString := ADR(cmdIn), 
        nDstSize := SIZEOF(cmdIn)
    );

    FindAndReplace(
        pSrcString := ADR(cmdIn), 
        pDeleteString := ADR('#6#'), 
        pInsertString := ADR(sNewAutoLogoutMin), 
        pDstString := ADR(cmdIn), 
        nDstSize := SIZEOF(cmdIn)
    );

    FindAndReplace(
        pSrcString := ADR(cmdIn), 
        pDeleteString := ADR('#7#'), 
        pInsertString := ADR(GVL_HMI.stUserMgmtHistoryEvent.sPerformedBy), 
        pDstString := ADR(cmdIn), 
        nDstSize := SIZEOF(cmdIn)
    );

    FindAndReplace(
        pSrcString := ADR(cmdIn), 
        pDeleteString := ADR('#8#'), 
        pInsertString := ADR(GVL_HMI.stUserMgmtHistoryEvent.sSourceScreen), 
        pDstString := ADR(cmdIn), 
        nDstSize := SIZEOF(cmdIn)
    );

    FindAndReplace(
        pSrcString := ADR(cmdIn), 
        pDeleteString := ADR('#9#'), 
        pInsertString := ADR(GVL_HMI.stUserMgmtHistoryEvent.sEventComment), 
        pDstString := ADR(cmdIn), 
        nDstSize := SIZEOF(cmdIn)
    );

END_IF]]></ST>
      </Implementation>
    </Method>
