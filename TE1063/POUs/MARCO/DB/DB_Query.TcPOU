    <Method Name="insertUser" Id="{0694d5fd-7d7a-4599-91eb-5aed0d1f83d7}">
      <Declaration><![CDATA[METHOD insertUser : BOOL
VAR_INPUT
	start: BOOL;
	line: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[

IF start THEN
	FindAndReplace(pSrcString:= ADR(cmdIn), pDeleteString:= ADR('#1#'), pInsertString:= ADR(GVL_DB.astData_CUL[line].userID), pDstString:= ADR(cmdIn), nDstSize:= SIZEOF(cmdIn));
