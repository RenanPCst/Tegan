<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="PRG_Calibration" Id="{f2ab8e02-eb8c-441d-b1b0-c2b3833b2b19}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_Calibration
VAR_OUTPUT
    bCalibrationFinished : BOOL;  // Done Flag
END_VAR
VAR
	fbLeakTest : FB_LeakTest;
	bLeakTestReset : BOOL := FALSE;
	
	fbCalibrationManager : FB_CalibrationManager;
	fbSaveCalReport		 : FB_SaveCalibrationReport;

    bStartCalibrationPrev : BOOL;
    bStartCalibrationEdge : BOOL;
	
	iLastRepSetpoint : INT := -1;
	iDataCount : INT;
    i : INT;
	
	fbSolenoidControl	: FB_SolenoidControl;
	eStopState 			: E_StopState 		:= E_StopState.Init;
	ePState 			: E_PState 			:= E_PState.Init;	
	eLeakTestState 		: E_LeakTestState	:= E_LeakTestState.IDLE;
	
	bPressureUpExecute 		: BOOL := FALSE;
    bPressureUpRequested 	: BOOL := FALSE;
	bSealStages				: BOOL := FALSE;
	bPressureUpSolenoids	: BOOL := FALSE;
	bHoldPressureExecute 	: BOOL := FALSE;
    bHoldPressureRequested 	: BOOL := FALSE;
	bHoldPressureSolenoids	: BOOL := FALSE;
	bStopLeakTestExecute 	: BOOL := FALSE;
    bStopLeakTestRequested 	: BOOL := FALSE;
	bStopLeakTestSolenoids 	: BOOL := FALSE;
	
	
	bMoveIssued     : BOOL := FALSE;
	bNeedsSet 		: BOOL := FALSE;
    tonSealTimeout  : TON;
	
	bStopM1Motor 			: BOOL := FALSE;
	bResetM1Motor 			: BOOL := FALSE;
	tonResetMotorDelay 		: ton;
	
	bLinearPumpsEnabled		: BOOL := FALSE;
	bLinearPumpsHomed		: BOOL := FALSE;
	bLinearPumpsOldPosStart	: BOOL := FALSE;
	bLinearPumpsOldPosDone	: BOOL := FALSE;
	bLinearPumpsMove		: BOOL := FALSE;
	aLinearPumpsEnable 		: ARRAY[1..10] OF BOOL;
	aLinearPumpsDisable		: ARRAY[1..10] OF BOOL;
	aLinearPumpsHoming 		: ARRAY[1..10] OF BOOL;
	bLinearPumpsOldPosMove	: ARRAY[1..10] OF BOOL;
	aLinearPumpsMoveDone 	: ARRAY[1..10] OF BOOL; // Tracks per-axis move completion
	
	bCalPressureUpSystemBt: BOOL;
	
	//Valves movement
	bMoveValves	: ARRAY[1..5] OF BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF GVL_HMI.bCalLeakTestButton THEN
	bLeakTestReset := FALSE;
END_IF

(* Scale *) //------------------------------------------------------------------------------------------------------------------------------------------------------------
// Instancing and calling fbScaleDevice object
GVL_Calibration.fbScaleDevice(sRemoteHost := GVL_Settings.aBalanceIP, nRemotePort := GVL_Settings.nBalancePort);

(* Leak Test *) //--------------------------------------------------------------------------------------------------------------------------------------------------------
// Leak Test request from HMI
fbLeakTest(bExecute := GVL_HMI.bCalLeakTestButton, eSolenoidPosition := E_SolenoidSet.LEAKTEST, tMonitorTime := GVL_Settings.stLeakTestParameters.tLeakTestMonitorTime);

// Leak Test post treatment
IF fbLeakTest.bLeakTestDone AND NOT fbLeakTest.bLeakTestError THEN
	GVL_HMI.bCalLeakTestPass := TRUE;
	GVL_HMI.bCalLeakTestError := FALSE;
	GVL_HMI.bCalLeakTestButton := FALSE;
	IF NOT bLeakTestReset THEN
		bLeakTestReset := fbLeakTest.Reset();
	END_IF
END_IF

IF fbLeakTest.bLeakTestError THEN
	GVL_HMI.bCalLeakTestError := TRUE;
	GVL_HMI.bCalLeakTestPass := FALSE;
	GVL_HMI.bCalLeakTestButton := FALSE;
	IF NOT bLeakTestReset THEN
		bLeakTestReset := fbLeakTest.Reset();
	END_IF
END_IF

// HMI Button responsible for pressurize the system
IF GVL_HMI.bCalPressureUpSystemBt THEN
	GVL_HMI.bCalPressureUpSystemBt := NOT PressureUp();
END_IF

// HMI Button responsible for hold the air in the system after the system pressure up
IF GVL_HMI.bCalHoldSysPressureBt THEN
	GVL_HMI.bCalHoldSysPressureBt := NOT HoldSystemPressure();
END_IF

// HMI Button responsible for stopping the leak test
IF GVL_HMI.bCalStopLeakTestBt THEN
	GVL_HMI.bCalStopLeakTestBt := NOT StopLeakTest();
END_IF

// Leak test stage Analog input pressure HMI shown
IF eLeakTestState <> E_LeakTestState.IDLE THEN
	GVL_HMI.rCalLeakTestPressure := GVL_IO.gAnalogInputs.rLeakTestPressureSensor;
ELSE
	GVL_HMI.rCalLeakTestPressure := 0.00;
END_IF


(* Calibration Procedure *) //---------------------------------------------------------------------------------------------------------------------------------------------
//Calibration procedure trigger
IF GVL_HMI.bStartCalibrationBt THEN
	GVL_Calibration.bStartCalibration := TRUE;
	GVL_Calibration.aCalibPumps := GVL_HMI.aCalibPumps;
	GVL_Calibration.iReplicatesSetpoint := GVL_Settings.stCalibParameters.iReplicatesSetpoint; //Modifided 10/11/2025 //GVL_HMI.stHMICalibParameters.iReplicatesSetpoint;
	GVL_Calibration.rAcceptanceCriteria := GVL_Settings.stCalibParameters.rAcceptanceCriteria; //Modifided 10/11/2025 //GVL_HMI.stHMICalibParameters.rAcceptanceCriteria;
	GVL_Calibration.iAllowableFailures	:= GVL_HMI.stHMICalibParameters.iAllowableFailures;
	GVL_Calibration.tDelayStart := DINT_TO_TIME(INT_TO_DINT(GVL_HMI.stHMICalibParameters.iDelayTimeMin) * 1000 * 60); //int convertion from minutes to ms
	GVL_HMI.bStartCalibrationBt := FALSE;
	GVL_Calibration.stPumpCalibrationInfo.rSolventDensity := 0.9972; //TODO
	DB_Create_Calibration();	//Create a new calibration inside the DB.
END_IF

//calibration procedure calling
fbCalibrationManager(
    bExecute := GVL_Calibration.bStartCalibration,
    bAbort := GVL_Calibration.bAbortCalibration,
	rSolventDensity := GVL_Calibration.stPumpCalibrationInfo.rSolventDensity,
    eSolvent := GVL_Calibration.eCalibSolvent, 
    aPumpSettings := GVL_HMI.aCalibPumps, //Temp GVL_Calibration.aCalibPumps
    tDelayStart := GVL_Calibration.tDelayStart,
    bPrintReport := GVL_Calibration.bPrintWhenComplete,
    aPumpResults => GVL_Calibration.aCalibPumps,
    bDone => GVL_Calibration.bCalibrationDone,
    bBusy => GVL_Calibration.bCalibrationRunning,
    sStatus => GVL_Calibration.sGlobalStatus,
	iDataCount => iDataCount
);

GVL_Calibration.sGlobalStatus := fbCalibrationManager.sStatus;


IF fbCalibrationManager.bDone THEN
	GVL_Calibration.bStartCalibration := FALSE;
	GVL_Calibration.bStartCreationCalJson := TRUE;
END_IF

fbSaveCalReport(
    bExecute          := GVL_Calibration.bStartCreationCalJson,
    sUser             := GVL_Calibration.stPumpCalibrationInfo.iUserID,
    stReportInfo      := GVL_Calibration.stPumpCalReportInfo,
    stCalibrationInfo := GVL_Calibration.stPumpCalibrationInfo,
    aCalibrationData  := GVL_Calibration.stPumpCalibrationData,
    iDataCount        := iDataCount
);

IF fbSaveCalReport.bDone THEN
    GVL_Calibration.bCreationCalJsonDone  := TRUE;
    GVL_Calibration.bCreationCalJsonError := FALSE;
    GVL_Calibration.bStartCreationCalJson := FALSE;  // auto-reset trigger
	fbCalibrationManager.Reset(bHard := TRUE);
	fbSaveCalReport.Reset();
	GVL_HMI.eMachineMode := E_MachineMode.STOPPED;
ELSIF fbSaveCalReport.bError THEN
    GVL_Calibration.bCreationCalJsonDone  := FALSE;
    GVL_Calibration.bCreationCalJsonError := TRUE;
    fbSaveCalReport.Reset();
END_IF

(* Linear Pumps Enable *) //---------------------------------------------------------------------------------------------------------------------------------------------
IF GVL_HMI.bCalLinearPumpsEnableBt THEN
    // Ensure we have the latest HMI snapshot
    GVL_Calibration.aCalibLinearPumps := GVL_HMI.aCalibLinearPumps;

    IF EnableLinearPumps() THEN
        // Operation finished successfully
        GVL_HMI.bCalLinearPumpsEnableBt := FALSE; // Set Dirty flag that does not allow closing the popup
		GVL_HMI.bCalLinearPumpsDirty := TRUE;
    END_IF
END_IF

(* Linear Pumps Homing *) //---------------------------------------------------------------------------------------------------------------------------------------------
IF GVL_HMI.bCalLinearPumpsHomeBt THEN
    // Ensure we have the latest HMI snapshot
    GVL_Calibration.aCalibLinearPumps := GVL_HMI.aCalibLinearPumps;

    IF HomeLinearPumps() THEN
        GVL_HMI.bCalLinearPumpsHomeBt := FALSE;
		GVL_HMI.bCalLinearPumpsDirty := TRUE; // Set Dirty flag that does not allow closing the popup
    END_IF
END_IF

(* Linear Pumps Moving *) //---------------------------------------------------------------------------------------------------------------------------------------------
IF GVL_HMI.bCalLinearPumpsMoveBt THEN
    // Ensure we have the latest HMI snapshot
    GVL_Calibration.aCalibLinearPumps := GVL_HMI.aCalibLinearPumps;

    IF MoveLinearPumps() THEN
        GVL_HMI.bCalLinearPumpsMoveBt := FALSE;
		GVL_HMI.bCalLinearPumpsDirty := TRUE; // Set Dirty flag that does not allow closing the popup
    END_IF
END_IF

(* Linear Pumps Stop - stops ALL pumps regardless of selection *) // ---------------------------------------------------------------------------------------------------
IF GVL_HMI.bCalLinearPumpsStopBt THEN
    // Immediately requests a "Stop" on every linear pump.
    FOR i := 1 TO 10 DO
        GVL_Motion.aPumpsLinear[i].Stop();
        // Clear any local latches
        aLinearPumpsEnable[i] := FALSE;
        aLinearPumpsHoming[i] := FALSE;
        bLinearPumpsOldPosMove[i] := FALSE;
    END_FOR
    // Reset trigger
    GVL_HMI.bCalLinearPumpsStopBt := FALSE;
END_IF

(* Linear Pumps Save - Gets all new motors position and saves on old position | Disable all pumps that are enabled *)
IF GVL_HMI.bCalLinearPumpsSaveBt THEN
	FOR i := 1 TO 10 DO
		IF GVL_Motion.aPumps[i].Linear.iOperational AND GVL_Motion.aPumps[i].Linear.iHomed THEN // if axis enabled then disables it
			GVL_Calibration.stLinearCalibrationData[i].sOldPosition := TO_STRING(GVL_Retain.rLinearPumpOldPosition[i]); // Old Position changed - DB insert
			GVL_Retain.rLinearPumpOldPosition[i] := GVL_Motion.aPumps[i].Linear.rActualPos; // Save the old axis position
			GVL_Calibration.stLinearCalibrationData[i].sNewPosition := TO_STRING(GVL_Motion.aPumps[i].Linear.rActualPos); // New Position changed - DB insert
			IF NOT aLinearPumpsDisable[i] THEN
				aLinearPumpsDisable[i] := GVL_Motion.aPumpsLinear[i].Disable(); // Disable the axis
			END_IF
		ELSE
			aLinearPumpsDisable[i] := TRUE; // Fallback if motor is no operational
			GVL_Calibration.stLinearCalibrationData[i].sOldPosition := TO_STRING(GVL_Retain.rLinearPumpOldPosition[i]); // Position not changed - DB insert
			GVL_Calibration.stLinearCalibrationData[i].sNewPosition := TO_STRING(GVL_Retain.rLinearPumpOldPosition[i]); // Position not changed - DB insert
		END_IF
		GVL_Calibration.stLinearCalibrationData[i].sPumpNumber 	 := TO_STRING(i); // Pump Number - DB insert
		GVL_Calibration.stLinearCalibrationData[i].sUserName 	 := GVL_HMI.sUserNameEventTriggered; // HMI User name when button pressed - DB insert
		GVL_Calibration.stLinearCalibrationData[i].sDateOfChange := GVL_HMI.sDateAndTimeEventTriggered; // HMI Date and time when button pressed  - DB insert
	END_FOR
	IF 	aLinearPumpsDisable[1] AND aLinearPumpsDisable[2] AND aLinearPumpsDisable[3] AND aLinearPumpsDisable[4] AND aLinearPumpsDisable[5] AND 
		aLinearPumpsDisable[6] AND aLinearPumpsDisable[7] AND aLinearPumpsDisable[8] AND aLinearPumpsDisable[9] AND aLinearPumpsDisable[10] THEN
		
		FOR i := 1 TO 10 DO
			aLinearPumpsDisable[i] := FALSE; // Resets the disable motors flag
		END_FOR
		
		GVL_HMI.bCalLinearPumpsSaveBt := FALSE;  // Resets the button trigger 
		GVL_HMI.bCalLinearPumpsDirty := TRUE; 	 // Resets the Dirty flag that allow the popup closes
		GVL_HMI.sUserNameEventTriggered := '';	 // Resets Username triggered from HMI
		GVL_HMI.sDateAndTimeEventTriggered := '';// Resets Date and Time trigerred from HMI
	END_IF
END_IF

(* Valves Manual Movement *) //-----------------------------------------------------------------------------------------------------------------------------------------------------
IF GVL_HMI.bCalMoveValves THEN
	FOR i := 1 TO 5 DO
		IF NOT bMoveValves[i] THEN
			bMoveValves[i] := GVL_Motion.aValvesObj[i].MoveValve( iPosition := GVL_HMI.iCalMoveValvesPosition ,rVelocity := 1500, rAcc := 1000, rDec := 1000);
		END_IF
	END_FOR
END_IF

IF bMoveValves[1] AND bMoveValves[2] AND bMoveValves[3] AND bMoveValves[4] AND bMoveValves[5] THEN
	FOR i := 1 TO 5 DO
			bMoveValves[i] := FALSE;
	END_FOR
	GVL_HMI.bCalMoveValves := FALSE;
END_IF

(* M1 Motor Manual Movement *) //-----------------------------------------------------------------------------------------------------------------------------------------------------
IF GVL_HMI.bCalMoveM1Motor AND GVL_IO.gDigInputs.bThroatJigPresent THEN
	GVL_HMI.bCalMoveM1Motor := NOT GVL_Motion.aMotors[1].MoveAbsolute(	rPosition := GVL_Settings.stMachineParam.aM1Position[GVL_HMI.iCalMoveM1MotorPosition],
                        														rVelocity := GVL_Settings.stMachineParam.rM1Velocity,
                        														rAcc := GVL_Settings.stMachineParam.rM1Accleration,
                       															rDec := GVL_Settings.stMachineParam.rM1Deceleration
																				);
END_IF

]]></ST>
    </Implementation>
    <Method Name="EnableLinearPumps" Id="{22115b95-e372-40ed-a15e-77965f9e6360}">
      <Declaration><![CDATA[METHOD EnableLinearPumps : BOOL
VAR_INPUT
END_VAR
VAR
    bAnySelected : BOOL;
    bAllOperational : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Track if at least one pump is selected
bAnySelected := FALSE;
bAllOperational := TRUE;

// Issue enable only for selected pumps
FOR i := 1 TO 10 DO
    IF GVL_Calibration.aCalibLinearPumps[i].bActivate THEN
        bAnySelected := TRUE;
        // Call axis enable if not yet operational
        IF NOT IsAxisOperational(iAxis := i) THEN
            // Fire the enable command to the axis object
            aLinearPumpsEnable[i] := GVL_Motion.aPumpsLinear[i].Enable();
        END_IF
        // After command, check current status
        IF NOT IsAxisOperational(iAxis := i) THEN
            bAllOperational := FALSE; // At least one still not operational
        END_IF
    END_IF
END_FOR

// No selection: nothing to do (fail-safe FALSE)
IF NOT bAnySelected THEN
    EnableLinearPumps := FALSE; // Nothing selected
    RETURN;
END_IF

// Finish when all selected are operational
IF bAllOperational THEN
    // Clear latches
    FOR i := 1 TO 10 DO
        aLinearPumpsEnable[i] := FALSE;
    END_FOR
    EnableLinearPumps := TRUE;
	RETURN;
ELSE
    EnableLinearPumps := FALSE;
END_IF

(*------------------------------------------------------------------------------------------*)
(*
//Enabling Linear Pumps
FOR i := 1 TO 10 DO
	aLinearPumpsEnable[i] := GVL_Motion.aPumpsLinear[i].Enable();
END_FOR

//Testing if all motors were anabled
IF aLinearPumpsEnable[1] AND aLinearPumpsEnable[2] AND aLinearPumpsEnable[3] AND aLinearPumpsEnable[4] AND aLinearPumpsEnable[5] AND aLinearPumpsEnable[6] AND aLinearPumpsEnable[7] AND aLinearPumpsEnable[8] AND aLinearPumpsEnable[9] AND aLinearPumpsEnable[10] THEN
	FOR i := 1 TO 10 DO
		aLinearPumpsEnable[i] := FALSE;
	END_FOR
	EnableLinearPumps := TRUE;
	RETURN;
ELSE
	EnableLinearPumps := FALSE;
END_IF
*)]]></ST>
      </Implementation>
    </Method>
    <Method Name="HoldSystemPressure" Id="{b53ac1a1-3cdf-4e1b-96c9-26b0e48279bc}">
      <Declaration><![CDATA[METHOD PRIVATE HoldSystemPressure : BOOL
VAR_INPUT
END_VAR
VAR
	bDoneSeen : BOOL := FALSE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Queremos: A=TRUE, B=FALSE, C=FALSE
bNeedsSet :=
    (GVL_IO.gDigOutputs.bSolenoidValveA <> TRUE) OR
    (GVL_IO.gDigOutputs.bSolenoidValveB <> FALSE) OR
    (GVL_IO.gDigOutputs.bSolenoidValveC <> FALSE);

IF bNeedsSet THEN
    // Aplica apenas se precisar alterar algo
    GVL_IO.gDigOutputs.bSolenoidValveA := TRUE;
    GVL_IO.gDigOutputs.bSolenoidValveB := FALSE;
    GVL_IO.gDigOutputs.bSolenoidValveC := FALSE;

    // (opcional) limpar flags de outras fases
    bPressureUpSolenoids := FALSE;
    bPressureUpExecute   := FALSE;
	
	eLeakTestState := E_LeakTestState.HOLD_PRESSURE;

    HoldSystemPressure := TRUE;   // retornamos TRUE somente quando houve mudança
ELSE
    HoldSystemPressure := FALSE;  // já estava no estado desejado
END_IF
(*//FB Execute 
fbSolenoidControl( bExecute := bHoldPressureSolenoids, eSolenoidSet := E_SolenoidSet.LEAKTESTMONITORING);

// 0. Trigger
IF NOT bHoldPressureRequested THEN
    bHoldPressureExecute := TRUE;
    bHoldPressureRequested := TRUE;
END_IF

// 1. Close Solenoid B and keep A Open to hold the system pressure
IF bHoldPressureExecute AND bHoldPressureRequested THEN
	bHoldPressureSolenoids := TRUE;
END_IF

IF fbSolenoidControl.bDone THEN
	bDoneSeen := TRUE;
END_IF

// 3. Done - Reset and Return True
IF NOT bHoldPressureSolenoids AND NOT bHoldPressureExecute AND bHoldPressureRequested THEN
	bHoldPressureRequested := FALSE;
	bDoneSeen := FALSE;
	HoldSystemPressure := TRUE;
	RETURN;
ELSE
	HoldSystemPressure := FALSE;
END_IF

// Resetamos o bExecute SOMENTE DEPOIS de ter visto o Done
IF bDoneSeen THEN
	bHoldPressureSolenoids := FALSE;
	bHoldPressureExecute := FALSE;
END_IF*)

]]></ST>
      </Implementation>
    </Method>
    <Method Name="HomeLinearPumps" Id="{6200dfda-dea4-466c-9cdb-75115aff6d05}">
      <Declaration><![CDATA[METHOD HomeLinearPumps : BOOL
VAR_INPUT
END_VAR
VAR
	bAnySelected : BOOL;
	bAllHomed : BOOL;
	bAllOldPosMovesDone : BOOL;
	bAllPumpsHomedone : BOOL;
	rPositionTolerance : REAL := 0.05;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[bAnySelected := FALSE;
// 1) Trigger homing only for selected & operational axes
FOR i := 1 TO 10 DO
    IF GVL_Calibration.aCalibLinearPumps[i].bActivate THEN
        bAnySelected := TRUE;

        // Interlock: must be Operational before Home
        IF IsAxisOperational(iAxis := i) THEN
            // If not homed yet, keep requesting Home
            IF NOT aLinearPumpsHoming[i] THEN
                aLinearPumpsHoming[i] := GVL_Motion.aPumpsLinear[i].Home(
                    pHomeSensor := ADR(GVL_Motion.aPumps[i].Linear.iHomeSensor.0),
                    rVelocity   := GVL_Motion.aPumps[i].Linear.rHomeVel,
                    rAcc        := GVL_Motion.aPumps[i].Linear.rHomeAcc,
                    rDec        := GVL_Motion.aPumps[i].Linear.rHomeDec
                );
            END_IF
        ELSE
            // Not operational -> cannot home yet
            bAllHomed := FALSE;
        END_IF
	ELSE
		aLinearPumpsHoming[i] := TRUE;
    END_IF
END_FOR

// If none selected, nothing to do
IF NOT bAnySelected THEN
    HomeLinearPumps := FALSE;
    RETURN;
END_IF

// 2) After all selected are homed, move them to OldPosition
bAllHomed := aLinearPumpsHoming[1] AND aLinearPumpsHoming[2] AND aLinearPumpsHoming[3] AND aLinearPumpsHoming[4] AND 
			 aLinearPumpsHoming[5] AND aLinearPumpsHoming[6] AND aLinearPumpsHoming[7] AND aLinearPumpsHoming[8] AND 
			 aLinearPumpsHoming[9] AND aLinearPumpsHoming[10];

IF bAllHomed THEN
    bLinearPumpsOldPosStart := TRUE;
END_IF

// 3) Move to old position only the selected pumps
IF bLinearPumpsOldPosStart THEN
	FOR i := 1 TO 10 DO
		IF GVL_Calibration.aCalibLinearPumps[i].bActivate THEN
			IF NOT bLinearPumpsOldPosMove[i] THEN
				bLinearPumpsOldPosMove[i] := GVL_Motion.aPumpsLinear[i].MoveAbsolute(
					rPosition := GVL_Retain.rLinearPumpOldPosition[i],
					rVelocity := GVL_Motion.aPumps[i].Linear.rHomeVel,
					rAcc      := GVL_Motion.aPumps[i].Linear.rHomeAcc,
					rDec      := GVL_Motion.aPumps[i].Linear.rHomeDec
				);
			END_IF
			IF GVL_Motion.aPumps[i].Linear.rActualPos <= (GVL_Motion.aPumps[i].Linear.rActualPos + rPositionTolerance) AND  GVL_Motion.aPumps[i].Linear.rActualPos >= (GVL_Motion.aPumps[i].Linear.rActualPos - rPositionTolerance) THEN
				bLinearPumpsOldPosMove[i] := TRUE;
			END_IF
		ELSE
			bLinearPumpsOldPosMove[i] := TRUE;
		END_IF
	END_FOR
END_IF

bAllOldPosMovesDone := bLinearPumpsOldPosMove[1] AND bLinearPumpsOldPosMove[2] AND bLinearPumpsOldPosMove[3] AND bLinearPumpsOldPosMove[4] AND bLinearPumpsOldPosMove[5] AND bLinearPumpsOldPosMove[6] AND bLinearPumpsOldPosMove[7] AND bLinearPumpsOldPosMove[8] AND bLinearPumpsOldPosMove[9] AND bLinearPumpsOldPosMove[10];

// 4) Completion and cleanup
IF bAllHomed AND bAllOldPosMovesDone THEN
    FOR i := 1 TO 10 DO
        aLinearPumpsHoming[i] := FALSE;
        bLinearPumpsOldPosMove[i] := FALSE;
    END_FOR
    bLinearPumpsOldPosStart := FALSE;
	bAllHomed	:= FALSE;
	bAllPumpsHomedone := FALSE;
    HomeLinearPumps := TRUE;
	RETURN;
ELSE
    HomeLinearPumps := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsAxisHomed" Id="{f46bd424-1b13-4226-b5e9-51bcc113183d}">
      <Declaration><![CDATA[METHOD IsAxisHomed : BOOL
VAR_INPUT
	iAxis : INT; // axis linear pumps index
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Returns TRUE if axis i is homed in NC
CASE iAxis OF
    1: IsAxisHomed := GVL_HMI.stIOTerm23.bAxisHomed[1]; 
    2: IsAxisHomed := GVL_HMI.stIOTerm24.bAxisHomed[1];
    3: IsAxisHomed := GVL_HMI.stIOTerm25.bAxisHomed[1];
    4: IsAxisHomed := GVL_HMI.stIOTerm26.bAxisHomed[1];
    5: IsAxisHomed := GVL_HMI.stIOTerm27.bAxisHomed[1];
    6: IsAxisHomed := GVL_HMI.stIOTerm28.bAxisHomed[1];
    7: IsAxisHomed := GVL_HMI.stIOTerm29.bAxisHomed[1];
    8: IsAxisHomed := GVL_HMI.stIOTerm30.bAxisHomed[1];
    9: IsAxisHomed := GVL_HMI.stIOTerm31.bAxisHomed[1];
    10: IsAxisHomed := GVL_HMI.stIOTerm32.bAxisHomed[1];
ELSE
    IsAxisHomed := FALSE;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsAxisOperational" Id="{f15d06ef-67aa-4699-b856-e63278cb7261}">
      <Declaration><![CDATA[METHOD IsAxisOperational : BOOL
VAR_INPUT
	iAxis : INT; // axis linear pumps index
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Returns TRUE if axis i is operational (enabled) in NC
CASE iAxis OF
    1: IsAxisOperational := GVL_HMI.stIOTerm23.bAxisOperational[1]; 
    2: IsAxisOperational := GVL_HMI.stIOTerm24.bAxisOperational[1];
    3: IsAxisOperational := GVL_HMI.stIOTerm25.bAxisOperational[1];
    4: IsAxisOperational := GVL_HMI.stIOTerm26.bAxisOperational[1];
    5: IsAxisOperational := GVL_HMI.stIOTerm27.bAxisOperational[1];
    6: IsAxisOperational := GVL_HMI.stIOTerm28.bAxisOperational[1];
    7: IsAxisOperational := GVL_HMI.stIOTerm29.bAxisOperational[1];
    8: IsAxisOperational := GVL_HMI.stIOTerm30.bAxisOperational[1];
    9: IsAxisOperational := GVL_HMI.stIOTerm31.bAxisOperational[1];
    10: IsAxisOperational := GVL_HMI.stIOTerm32.bAxisOperational[1];
ELSE
    IsAxisOperational := FALSE;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveLinearPumps" Id="{a0c275c8-aa7c-4658-a9aa-22f5e5559463}">
      <Declaration><![CDATA[METHOD MoveLinearPumps : BOOL
VAR_INPUT
END_VAR
VAR
	bAnySelected : BOOL;
    bAllMovesDone : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bAnySelected := FALSE;

FOR i := 1 TO 10 DO
    IF GVL_Calibration.aCalibLinearPumps[i].bActivate THEN
        bAnySelected := TRUE;

        // Interlocks: must be Operational and Homed before move
        IF IsAxisOperational(iAxis := i) AND IsAxisHomed(iAxis := i) THEN
            // Issue move if not already "in progress/done" (implement your latch if needed)
            // We'll reuse bLinearPumpsOldPosMove[] as generic "move latch"
            IF NOT bLinearPumpsOldPosMove[i] THEN
                bLinearPumpsOldPosMove[i] := GVL_Motion.aPumpsLinear[i].MoveAbsolute(
                    rPosition := GVL_Calibration.aCalibLinearPumps[i].rNewPosition,
                    rVelocity := GVL_Motion.aPumps[i].Linear.rHomeVel,
                    rAcc      := GVL_Motion.aPumps[i].Linear.rHomeAcc,
                    rDec      := GVL_Motion.aPumps[i].Linear.rHomeDec
                );
            END_IF
        ELSE
            // Interlock not satisfied -> cannot move
            bAllMovesDone := FALSE;
        END_IF
	ELSE
		bLinearPumpsOldPosMove[i] := TRUE;
    END_IF
END_FOR

IF NOT bAnySelected THEN
    MoveLinearPumps := FALSE; // nothing selected
    RETURN;
END_IF

bAllMovesDone := bLinearPumpsOldPosMove[1] AND bLinearPumpsOldPosMove[2] AND bLinearPumpsOldPosMove[3] AND 
				 bLinearPumpsOldPosMove[4] AND bLinearPumpsOldPosMove[5] AND bLinearPumpsOldPosMove[6] AND 
				 bLinearPumpsOldPosMove[7] AND bLinearPumpsOldPosMove[8] AND bLinearPumpsOldPosMove[9] AND 
				 bLinearPumpsOldPosMove[10];

IF bAllMovesDone THEN
    // Clear latches for next command
    FOR i := 1 TO 10 DO
        bLinearPumpsOldPosMove[i] := FALSE;
    END_FOR
	bAllMovesDone := FALSE;
	bAnySelected := FALSE;
    MoveLinearPumps := TRUE;
	RETURN;
ELSE
    MoveLinearPumps := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="PressureUp" Id="{4cc623c4-aa5f-412a-9079-553ef54306c5}">
      <Declaration><![CDATA[METHOD PRIVATE PressureUp : BOOL
VAR_INPUT
END_VAR
VAR
	bDoneSeen : BOOL := FALSE;
	bPressureDone : BOOL := FALSE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Saída padrão
PressureUp := FALSE;

// --- FSM ---
CASE ePState OF

    E_PState.Init:
        // Disparo único por chamada (se quiser condicionar, coloque aqui um bExecute)
        bMoveIssued := FALSE;
        tonSealTimeout(IN := FALSE);
        ePState := E_PState.SealIssue;

    E_PState.SealIssue:
        // Interlock: sem jig, não segue
        IF NOT GVL_IO.gDigInputs.bThroatJigPresent THEN
            GVL_HMI.bM1MoveNotAllowedTrigger := TRUE;  // opcional: gatilho de alarme
            ePState := E_PState.Fault;
        ELSE
            // Emite o comando uma única vez
            bMoveIssued := GVL_Motion.aMotors[1].MoveAbsolute(
                rPosition := GVL_Settings.stMachineParam.aM1Position[2],   // Seal pos
                rVelocity := GVL_Settings.stMachineParam.rM1Velocity,
                rAcc      := GVL_Settings.stMachineParam.rM1Accleration,
                rDec      := GVL_Settings.stMachineParam.rM1Deceleration
            );
            tonSealTimeout(IN := TRUE, PT := T#10S);
            ePState := E_PState.SealWait;
        END_IF

    E_PState.SealWait:
        // Aguarda o Done do movimento
        IF GVL_Motion.aMotors[1].MoveAbsolute(
            rPosition := GVL_Settings.stMachineParam.aM1Position[2],
            rVelocity := GVL_Settings.stMachineParam.rM1Velocity,
            rAcc      := GVL_Settings.stMachineParam.rM1Accleration,
            rDec      := GVL_Settings.stMachineParam.rM1Deceleration
        ) THEN
            tonSealTimeout(IN := FALSE);
            ePState := E_PState.OpenValves;
        ELSE
            // Timeout de segurança
            tonSealTimeout(IN := TRUE);
            IF tonSealTimeout.Q THEN
                ePState := E_PState.Fault;
            END_IF
        END_IF

    E_PState.OpenValves:
        // Pressuriza o sistema: A/B abertas, C fechada
        IF GVL_IO.gSetSolenoidControl.PressureUp() THEN
			ePState := E_PState.Done;
		END_IF

    E_PState.Done:
		eLeakTestState := E_LeakTestState.PRESSURE_UP;
        bMoveIssued := FALSE;
        tonSealTimeout(IN := FALSE);
		PressureUp := TRUE;          // pulso de sucesso nesta chamada
        ePState := E_PState.Init;    // pronto para próximo ciclo
        RETURN;                      // encerra o método neste ciclo

    E_PState.Fault:
        // Falha: garanta estado seguro (não pressuriza)
        (*GVL_IO.gDigOutputs.bSolenoidValveA := FALSE;
        GVL_IO.gDigOutputs.bSolenoidValveB := FALSE;
        GVL_IO.gDigOutputs.bSolenoidValveC := FALSE;*)
		GVL_IO.gSetSolenoidControl.Idle();
        bMoveIssued := FALSE;
        tonSealTimeout(IN := FALSE);
        PressureUp := FALSE;
        ePState := E_PState.Init;             // ou mantenha em Fault até um reset externo
        RETURN;

ELSE
    // Recuperação defensiva
    ePState := E_PState.Init;
END_CASE

(*//FB Execute 
fbSolenoidControl( bExecute := bPressureUpSolenoids, eSolenoidSet := E_SolenoidSet.LEAKTEST);

// 0. Trigger
IF NOT bPressureUpRequested THEN
    bPressureUpExecute := TRUE;
	bSealStages	:= TRUE;
    bPressureUpRequested := TRUE;
END_IF

// 1. Sealing Stages (M1 axis)
IF bSealStages THEN
	bSealStages := NOT GVL_Motion.aMotors[1].MoveAbsolute( rPosition := GVL_Settings.stMachineParam.aM1Position[2], rVelocity := GVL_Settings.stMachineParam.rM1Velocity, rAcc := GVL_Settings.stMachineParam.rM1Accleration, rDec := GVL_Settings.stMachineParam.rM1Deceleration);
END_IF

// 2. Open Solenoid B and A to pressure up the system
IF NOT bSealStages AND bPressureUpRequested THEN
	bPressureUpSolenoids := TRUE;
END_IF

IF fbSolenoidControl.bDone THEN
	bDoneSeen := TRUE;
END_IF

// 3. Done - Reset and Return True
IF bPressureUpRequested AND NOT bPressureUpExecute AND NOT bSealStages THEN
	bPressureUpRequested := FALSE;
	bDoneSeen	:= FALSE;
	PressureUp 	:= TRUE;
	RETURN;
ELSE
	PressureUp := FALSE;
END_IF

// Resetamos o bExecute SOMENTE DEPOIS de ter visto o Done
IF bDoneSeen THEN
	bPressureUpSolenoids := FALSE;
	bPressureUpExecute := FALSE;
END_IF

*)
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{27813d8d-2df7-44d9-b974-4b44cba9f55d}">
      <Declaration><![CDATA[METHOD Reset : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Reset Calibration Flags
bLeakTestReset := FALSE;

bStartCalibrationPrev := FALSE;
bStartCalibrationEdge := FALSE;

bLinearPumpsEnabled		 := FALSE;
bLinearPumpsHomed		 := FALSE;
bLinearPumpsOldPosStart	 := FALSE;
bLinearPumpsOldPosDone	 := FALSE;

eStopState 	 	:= E_StopState.Init;
ePState 		:= E_PState.Init;	
eLeakTestState 	:= E_LeakTestState.IDLE;

bPressureUpExecute 		 := FALSE;
bPressureUpRequested 	 := FALSE;
bSealStages				 := FALSE;
bPressureUpSolenoids	 := FALSE;
bHoldPressureExecute 	 := FALSE;
bHoldPressureRequested 	 := FALSE;
bHoldPressureSolenoids	 := FALSE;
bStopLeakTestExecute 	 := FALSE;
bStopLeakTestRequested 	 := FALSE;
bStopLeakTestSolenoids 	 := FALSE;

bMoveIssued      := FALSE;
bNeedsSet 		 := FALSE;

tonSealTimeout(IN := FALSE);
tonResetMotorDelay(IN := FALSE);

bStopM1Motor 			 := FALSE;
bResetM1Motor 			 := FALSE;


bLinearPumpsEnabled		 := FALSE;
bLinearPumpsHomed		 := FALSE;
bLinearPumpsOldPosStart	 := FALSE;
bLinearPumpsOldPosDone	 := FALSE;
bLinearPumpsMove		 := FALSE;

bCalPressureUpSystemBt	 := FALSE;

FOR i := 1 TO 5 DO
	bMoveValves[i] := FALSE;
END_FOR

FOR i := 1 TO 10 DO
	aLinearPumpsEnable[i] := FALSE;
	aLinearPumpsHoming[i] := FALSE;
	bLinearPumpsOldPosMove[i] := FALSE;
	aLinearPumpsMoveDone[i] := FALSE;
END_FOR

FOR i := 1 TO 100 DO
	GVL_Calibration.stPumpCalibrationData[i].dDateTime 			:= '';
	GVL_Calibration.stPumpCalibrationData[i].iPumpNumber 		:= 0;
	GVL_Calibration.stPumpCalibrationData[i].iPumpRevs 			:= 0;
	GVL_Calibration.stPumpCalibrationData[i].rCriteria 			:= 0.0;
	GVL_Calibration.stPumpCalibrationData[i].rDifferencePercent := 0.0;
	GVL_Calibration.stPumpCalibrationData[i].rDifferenceUl 		:= 0.0;
	GVL_Calibration.stPumpCalibrationData[i].rGrossWeigth 		:= 0.0;
	GVL_Calibration.stPumpCalibrationData[i].rNetVolume 		:= 0.0;
	GVL_Calibration.stPumpCalibrationData[i].rNetWeigth 		:= 0.0;
	GVL_Calibration.stPumpCalibrationData[i].rTareWeigth 		:= 0.0;
	GVL_Calibration.stPumpCalibrationData[i].rTargetVolume 		:= 0.0;
	GVL_Calibration.stPumpCalibrationData[i].sStep 				:= '';
END_FOR

fbCalibrationManager.Reset(bHard := TRUE);

Reset := TRUE;
RETURN;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StopLeakTest" Id="{881665d9-2804-4b8d-9d93-9edb8f3e78d7}">
      <Declaration><![CDATA[METHOD PRIVATE StopLeakTest : BOOL
VAR_INPUT
END_VAR
VAR
	bDoneSeen : BOOL := FALSE;
	bMoveM1HomePos : BOOL := FALSE;
	bMotorMoving : BOOL := FALSE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE eStopState OF
    E_StopState.Init:
		StopLeakTest := FALSE;
        bStopLeakTestRequested := TRUE;
		tonResetMotorDelay(IN := FALSE); 
        eStopState := E_StopState.StopMotor;

    E_StopState.StopMotor:
        IF GVL_Motion.aMotors[1].Stop() THEN
            eStopState := E_StopState.CloseSolenoids;
        END_IF

    E_StopState.CloseSolenoids:
        GVL_IO.gDigOutputs.bSolenoidValveA := FALSE;
        GVL_IO.gDigOutputs.bSolenoidValveB := FALSE;
        GVL_IO.gDigOutputs.bSolenoidValveC := FALSE;
        tonResetMotorDelay(IN := TRUE, PT := T#1S);
        eStopState := E_StopState.Delay;

    E_StopState.Delay:
        tonResetMotorDelay(IN := TRUE);
        IF tonResetMotorDelay.Q THEN
            tonResetMotorDelay(IN := FALSE);
            eStopState := E_StopState.ResetMotor;
        END_IF

    E_StopState.ResetMotor:
        IF GVL_Motion.aMotors[1].Reset() THEN
            eStopState := E_StopState.MoveHome;
        END_IF

    E_StopState.MoveHome:
        IF GVL_Motion.aMotors[1].MoveAbsolute(
            rPosition := GVL_Settings.stMachineParam.aM1Position[1],
            rVelocity := GVL_Settings.stMachineParam.rM1Velocity,
            rAcc      := GVL_Settings.stMachineParam.rM1Accleration,
            rDec      := GVL_Settings.stMachineParam.rM1Deceleration) THEN
            eStopState := E_StopState.Done;
        END_IF

    E_StopState.Done:
		eLeakTestState := E_LeakTestState.IDLE;
		bStopLeakTestRequested := FALSE;
        StopLeakTest         := TRUE;
        eStopState := E_StopState.Init; // ou manter em Done até novo comando
		RETURN;
END_CASE

(*// FB Execute 
fbSolenoidControl( bExecute := bStopLeakTestSolenoids, eSolenoidSet := E_SolenoidSet.IDLE);

//Timer Delay between stop and reset the motor
IF bStopM1Motor AND bStopLeakTestSolenoids THEN
	tonResetMotorDelay(in := TRUE, pt := T#1S);
ELSE
	tonResetMotorDelay(in := FALSE, pt := T#1S);
END_IF

// CLean Internal flags
GVL_HMI.bCalPressureUpSystemBt := FALSE;
GVL_HMI.bCalHoldSysPressureBt := FALSE;

// 0. Trigger
IF NOT bStopLeakTestRequested THEN
    bStopLeakTestExecute := TRUE;
    bStopLeakTestRequested := TRUE;
END_IF

// 1. Stop Motor M1
IF NOT bStopM1Motor THEN
	bStopM1Motor := GVL_Motion.aMotors[1].Stop();
END_IF

// 2. Close Solenoid B and C 
IF bStopM1Motor AND NOT bStopLeakTestExecute AND bStopLeakTestRequested THEN
	bStopLeakTestSolenoids := TRUE;
END_IF

IF fbSolenoidControl.bDone THEN
	bDoneSeen := TRUE;
END_IF

// 3. Reset Motor M1
IF tonResetMotorDelay.Q AND NOT bResetM1Motor THEN
	bResetM1Motor := GVL_Motion.aMotors[1].Reset();
END_IF

// 4. Done - Reset and Return True
IF NOT bStopLeakTestSolenoids AND NOT bStopLeakTestExecute AND bStopLeakTestRequested AND bResetM1Motor THEN
	bStopM1Motor := FALSE;
	bResetM1Motor := FALSE;
	bStopLeakTestRequested := FALSE;
	tonResetMotorDelay(in := FALSE);
	bDoneSeen := TRUE;
	StopLeakTest := TRUE;
	RETURN;
ELSE
	StopLeakTest := FALSE;
END_IF

// Resetamos o bExecute SOMENTE DEPOIS de ter visto o Done
IF bDoneSeen THEN
	bStopLeakTestSolenoids := FALSE;
	bStopLeakTestExecute := FALSE;
END_IF*)


]]></ST>
      </Implementation>
    </Method>
