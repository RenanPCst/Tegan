<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_CalibrationManager" Id="{f5b6651e-f67d-465b-b243-425be4d72cd5}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_CalibrationManager
VAR_INPUT
    bExecute         : BOOL; // Trigger to start calibration
    eSolvent         : E_SolventType; // Selected solvent type
	rSolventDensity  : LREAL; //Solvent Density
    aPumpSettings    : ARRAY[1..10] OF ST_CalibrationPump; // Pump input settings
    tDelayStart      : TIME; // Optional delay before calibration starts
    bPrintReport     : BOOL; // Option to print report at end
END_VAR

VAR_OUTPUT
    aPumpResults     : ARRAY[1..10] OF ST_CalibrationPump; // Pump result structure
    bDone            : BOOL; // Signals end of calibration
    bBusy            : BOOL; // Calibration in progress
    sStatus          : STRING; // Textual status
	iDataCount		 : INT; // Number of positions used into GVL_Calibration.aCalibCheckResult array
END_VAR

VAR
    eStep             	  : E_CalibStep := E_CalibStep.IDLE; // Main step enum
    iPumpIndex        	  : UINT := 1; // Tracks current pump
    iReplicate        	  : UINT := 0; // Tracks current replicate
	bStartCalibration 	  : BOOL := FALSE;
	bCalibrationRequested : BOOL := FALSE;

    tonCalDelay      : TON; // General delay timer
    tonStepTimeout   : TON; // Timeout per step
	tonMotorsDelay	 : TON; // Delay time after positioning the motors
	tonAirDry		 : TON; // Timer to be using air if needed after calibration
	tonWeigthStabilization : TON; //Time after the pump finish to wait for stable weigth
	
	bExecutePulse   : R_TRIG; // Edge detection for bExecute

    aPumpMask        : ARRAY[1..10] OF BOOL; // Mask for pump selection
    aVolumeSetpoint  : ARRAY[1..10] OF REAL; // Target volume for each pump
    aDirection       : ARRAY[1..10] OF E_PumpDirection; // Direction per pump
    aVelocity        : ARRAY[1..10] OF REAL; // Velocity per pump

    fbPumps          	: FB_AllPumpsController; // Instance of pump controller
    rWeightBefore    	: LREAL; // Weight before pump operation
    rWeightAfter     	: LREAL; // Weight after pump operation
    rWeightDelta     	: LREAL; // Weight difference
	rVolume			 	: LREAL; // Volume calculated
	rPumpVolumeSum	 	: LREAL := 0.00; // Sum volume for each pump for average calculus
	rTareWeightSum		: LREAL := 0.00; // Sum Tare Weigth for each pump for average calculus
	rGrossWeightSum		: LREAL := 0.00; // Sum Gross Weigth for each pump for average calculus
	rPumpAverageVolume 	: LREAL := 0.00; // Calculated average volume of each pump at the end of replicates 
	rPumpAvgTareWeigth 	: LREAL := 0.00; // Calculated average Tare Weitgh of each pump at the end of replicates 
	rPumpAvgGrossWeigth	: LREAL := 0.00; // Calculated average Gross Weigth of each pump at the end of replicates 
    bRequestWeight   	: BOOL := FALSE; // Trigger for requesting scale
	bWeightReady	 	: BOOL := FALSE; // Trigger when weigth is ready
	bPumpAdjustNeed	 	: BOOL := FALSE; // Flag that indicates if the checking pump needs to be adjusted or not. 
	bAirDryTrigger		: BOOL := FALSE; // Flag to trigger the air dry timer. 
    rScaleWeight     	: LREAL; // Latest scale result
	rDistanceByVol	 	: LREAL; // MoveRelative distance
	rPercentDifference 	: LREAL; // Percentual Difference between net volume and tagert volume
	iNumberOfAdjusts	: UINT;  // Count of adjustments needed for each pump index
	rPosTolerance		: LREAL := 5.0; // Position Tolerance in mm to make sure there is no noise in the reading
	rFillJarTotalVol 	: LREAL;
	rEmptyJarTotalVol	: LREAL;
	
    rAcceptanceCrit  : REAL := 0.5; // Acceptance percentage (from HMI)
    iAllowableFail   : INT := 2; 	// Max failures from pump settings
    iMaxReplicates   : INT := 2; 	// Replicate count (from HMI)
	iResultIndex	 : INT;	// Array index on calibration results
	
	bMovePump		 : BOOL := FALSE;
	bMoveMotorM1     : BOOL := FALSE; // Motion trigger M1
    bMoveMotorM2     : BOOL := FALSE; // Motion trigger M2
    bMoveMotorM3     : BOOL := FALSE; // Motion trigger M3
	bSetSolenoids	 : BOOL := FALSE; // SetSolenoids flag
    bMoveValve       : ARRAY[1..5] OF BOOL; // Valve position tracking
	bDataBaseSeq	 : BOOL := FALSE;
	

    i                : USINT;// Loop index helper
    bBoxPresent      : BOOL; // True if calibration box detected
    bBoxWeightOK     : BOOL; // True if calibration box has valid weight

    tStepTimeout     : TIME := T#60S; // Default timeout per step;
	tWeightStable	 : TIME := T#10S; // Default waiting time befe request weight
	
	bScalePlausible : BOOL := FALSE; // Plausibility window flag
    bScaleInvalid   : BOOL := FALSE; // Invalid scale response flag
	
	// Scale-attention handling (9999 pause)
    bScaleAttention  : BOOL := FALSE; // TRUE while waiting operator
	bCalBoxAttention : BOOL := FALSE; // TRUE while waiting operator
    eStepResume      : E_CalibStep := E_CalibStep.IDLE; // Step to return to after fix
	
	// Timestamp generation (local system time)
    fbLocalSystemTime : FB_LocalSystemTime;
    stLocal           : TIMESTRUCT;
    sStamp            : STRING(32);
    sHH               : STRING(2);
    sMM               : STRING(2);
    sSS               : STRING(2);
    sMMo              : STRING(3);
    sDD               : STRING(2);
	bDTReady		  : BOOL := FALSE;
	
	//LoadBar UI
	tonProgress : TON;
    sPrev       : STRING(120);
    tPT         : TIME;

    // helpers time calc (seconds)
    rDeltaM2, rDeltaM3, rVM2, rVM3  : LREAL;
    rPumpVelDeg, rRunVelDeg         : LREAL;
    rSecs  							: LREAL;
	
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// bExecute Rising edge
bExecutePulse(CLK := bExecute);

// FB Trigger
IF bExecutePulse.Q AND eStep = E_CalibStep.IDLE THEN
    bStartCalibration := TRUE;
END_IF

// Abort logic
IF GVL_HMI.bAbortCalibrationBT THEN
    eStep := E_CalibStep.ERROR;
END_IF

// State machine
CASE eStep OF

    E_CalibStep.IDLE:
    	bBusy := FALSE;
		bDone := FALSE;
		sStatus := 'Idle';
		IF bStartCalibration THEN
			bBusy := TRUE;
			ACT_CleanStart();
			eStep := E_CalibStep.DELAY;
		END_IF

    E_CalibStep.DELAY:

        tonCalDelay(IN := TRUE, PT := tDelayStart);
        sStatus := 'Waiting delay...';
        IF tonCalDelay.Q THEN
            tonCalDelay(IN := FALSE);
            tonStepTimeout(IN := FALSE);
            eStep := E_CalibStep.CHECKING_WEIGH;
			bRequestWeight := TRUE;
			bBoxWeightOK := FALSE;
			bWeightReady := FALSE;
        END_IF

	
    E_CalibStep.CHECKING_WEIGH:
		// ----------------------------------------------------
		// Step guards / status
		// ----------------------------------------------------
		tonStepTimeout(IN := TRUE, PT := tStepTimeout);
		sStatus := 'Checking the Calibration Box Weigth';
	
		bBoxPresent := GVL_IO.gDigInputs.bCalibrationBoxPresent;
	
		// ----------------------------------------------------
		// 1) Global guards first (avoid processing stale values)
		// ----------------------------------------------------
		IF tonStepTimeout.Q THEN
			sStatus := 'Timeout while checking scale';
			eStep := E_CalibStep.ERROR;
	
		ELSIF NOT bBoxPresent THEN
			sStatus := 'Calibration box not present!';
	
			// Defensive cleanup (avoid sticky UI flags)
			GVL_HMI.bCalBoxNeedsAttention := FALSE;
			bCalBoxAttention := FALSE;
	
			// Clear local request state
			bRequestWeight := FALSE;
	
			eStep := E_CalibStep.IDLE;
	
		ELSE
			// ----------------------------------------------------
			// 2) Request weight (non-blocking)
			// ----------------------------------------------------
			IF bRequestWeight THEN
				// This returns the "current" weight value (may be old until ready)
				rScaleWeight := GVL_Calibration.fbScaleDevice.RequestWeight();
	
				// ------------------------------------------------
				// 3) Process only when the device says it's ready
				//    (treat bWeightReady as an event)
				// ------------------------------------------------
				IF GVL_Calibration.fbScaleDevice.bWeightReady THEN
	
					// ---- scale response plausibility window
					bScalePlausible := (rScaleWeight > 0.0) AND (rScaleWeight < 1215.0);
					bScaleInvalid   := (rScaleWeight = 9999.0) OR (NOT bScalePlausible);
	
					// ------------------------------------------------
					// 3a) Scale invalid -> SCALE_ATTENTION (priority)
					// ------------------------------------------------
					IF bScaleInvalid THEN
						tonCalDelay(IN := FALSE);
						tonStepTimeout(IN := FALSE);
						tonWeigthStabilization(IN := FALSE);
	
						// Prevent cascade: if scale is faulty, do not allow CalBox popup to stack behind
						GVL_HMI.bCalBoxNeedsAttention := FALSE;
						bCalBoxAttention := FALSE;
	
						GVL_HMI.bScaleNeedsAtention := TRUE;
						bScaleAttention := TRUE;
	
						// Stop requesting until operator continues
						bRequestWeight := FALSE;
	
						eStepResume := E_CalibStep.CHECKING_WEIGH;
						eStep := E_CalibStep.SCALE_ATTENTION;
	
					ELSE
						// ------------------------------------------------
						// 3b) Scale valid -> evaluate box weight range
						// ------------------------------------------------
						bBoxWeightOK := (rScaleWeight >= 1100.0) AND (rScaleWeight <= 1300.0);
	
						IF NOT bBoxWeightOK THEN
							tonCalDelay(IN := FALSE);
							tonStepTimeout(IN := FALSE);
							tonWeigthStabilization(IN := FALSE);
	
							// Ask operator to fill calbox
							GVL_HMI.bCalBoxNeedsAttention := TRUE;
							bCalBoxAttention := TRUE;
	
							// Stop requesting until operator continues
							bRequestWeight := FALSE;
	
							eStepResume := E_CalibStep.CHECKING_WEIGH;
							eStep       := E_CalibStep.CALBOX_ATTENTION;
	
						ELSE
							// Proceed
							bBoxWeightOK := FALSE;
							bRequestWeight := FALSE;
	
							eStep := E_CalibStep.FEED_HMI_RESULTS;
							rAcceptanceCrit := GVL_Settings.stCalibParameters.rAcceptanceCriteria;
						END_IF
					END_IF
	
					// ------------------------------------------------
					// 4) Always reset the device session AFTER processing
					//    (so bWeightReady doesn't stay stuck TRUE / repeat)
					// ------------------------------------------------
					// If Reset() returns BOOL and you need to ensure completion, you can loop it outside.
					// For now, keep your pattern:
					GVL_Calibration.fbScaleDevice.Reset();
				END_IF
			END_IF
		END_IF
	
	E_CalibStep.FEED_HMI_RESULTS:
	
		FOR i := 1 TO 10 DO
			IF aPumpSettings[i].bSelected THEN
				GVL_HMI.aCalPumpResults[i].eStatus := E_CalibrationStatus.PENDING;
			END_IF
		END_FOR
		
		eStep := E_CalibStep.POSITION_MOTORS;
		
		
	E_CalibStep.POSITION_MOTORS:
	
		sStatus := 'Positioning motors M2 and M3';
		
		// Positioning motors M2 and M3 to calibration position 
		IF NOT bMoveMotorM3 THEN
			bMoveMotorM3 := GVL_Motion.aMotors[3].MoveAbsolute(GVL_Settings.stMachineParam.aM3Position[4], GVL_Settings.stMachineParam.rM3Velocity, GVL_Settings.stMachineParam.rM3Accleration, GVL_Settings.stMachineParam.rM3Deceleration);
		END_IF
		IF NOT bMoveMotorM2 AND bMoveMotorM3 THEN
			bMoveMotorM2 := GVL_Motion.aMotors[2].MoveAbsolute(GVL_Settings.stMachineParam.aM2Position[5], GVL_Settings.stMachineParam.rM2Velocity, GVL_Settings.stMachineParam.rM2Accleration, GVL_Settings.stMachineParam.rM2Deceleration);
		END_IF
	
		IF bMoveMotorM2 AND bMoveMotorM3 THEN
			tonMotorsDelay(in := TRUE, pt := T#200MS);
		END_IF
		
		IF tonMotorsDelay.Q THEN
			tonStepTimeout(IN := FALSE);
			eStep := E_CalibStep.POSITION_VALVES;
		END_IF

    E_CalibStep.POSITION_VALVES:
		//Reset Motors Flags
		bMoveMotorM2 := FALSE;
		bMoveMotorM3 := FALSE;	
		tonMotorsDelay(in := FALSE);
	
		tonStepTimeout(IN := TRUE, PT := tStepTimeout);
        sStatus := 'Positioning valves to Position 6';
		// Positioning the valves to the needles, position 6 
        FOR i := 1 TO 5 DO
            IF NOT bMoveValve[i] THEN
                bMoveValve[i] := GVL_Motion.aValvesObj[i].MoveValve(iPosition := 6, rVelocity := GVL_Motion.aValves[i].rTargetVel, rAcc := GVL_Motion.aValves[i].rAcceleration, rDec := GVL_Motion.aValves[i].rDeceleration);
            END_IF
        END_FOR
       IF bMoveValve[1] AND bMoveValve[2] AND bMoveValve[3] AND bMoveValve[4] AND bMoveValve[5] THEN
			FOR i := 1 TO 5 DO bMoveValve[i] := FALSE; END_FOR
			tonStepTimeout(IN := FALSE);
			eStep := E_CalibStep.FILLJAR_FORWARD; 
		ELSIF tonStepTimeout.Q THEN
			sStatus := 'Timeout while positioning valves';
			eStep := E_CalibStep.ERROR;
		END_IF

	E_CalibStep.FILLJAR_FORWARD:
		
		
		sStatus := CONCAT('Filling up the jar: ', F_JarName(iPumpIndex := iPumpIndex));
		
		IF aPumpSettings[iPumpIndex].bSelected THEN
			IF iPumpIndex = 1 THEN
				rFillJarTotalVol := aPumpSettings[iPumpIndex].rTargetVolume + GVL_Settings.stPumpParameters.iFillolventTubesFactor;
			ELSE
				rFillJarTotalVol := GVL_Settings.stPumpParameters.iFillolventTubesFactor;
			END_IF
			
			GVL_HMI.aCalPumpResults[iPumpIndex].eStatus := E_CalibrationStatus.RUNNING;
			
			//Move Motor M2 for IntoResBottom
			IF NOT bMoveMotorM2 THEN
				bMoveMotorM2 := GVL_Motion.aMotors[2].MoveAbsolute(GVL_Settings.stMachineParam.aM2Position[4], GVL_Settings.stMachineParam.rM2Velocity, GVL_Settings.stMachineParam.rM2Accleration, GVL_Settings.stMachineParam.rM2Deceleration);
			END_IF
				
			rDistanceByVol := F_VolumeToSteps_Path(rVolume := rFillJarTotalVol, iPumpIndex := iPumpIndex, ePath := E_PumpPath.FromCalBox);
			// Filling up the jar to start the calibration
			IF bMoveMotorM2 AND NOT bMovePump THEN
				bMovePump := GVL_Motion.aPumpsRotary[iPumpIndex].MoveRelative(	Distance := rDistanceByVol, 
																				Velocity := GVL_Settings.stPumpParameters.iMeterVelocity * 6, 	//RPM to Degree/sec
																				Acc := GVL_Settings.stPumpParameters.iMeterVelocity * 6,   		//RPM to Degree/sec
																				Dec := GVL_Settings.stPumpParameters.iMeterVelocity * 6			//RPM to Degree/sec
																			 );
			END_IF
	
			IF bMovePump THEN
				tonWeigthStabilization(IN := TRUE, PT := tWeightStable);
				sStatus := 'Waiting for weight stabilization...';
				IF tonWeigthStabilization.Q THEN
					bMovePump := FALSE;
					bMoveMotorM2 := FALSE;
					tonWeigthStabilization(IN := FALSE);
					bRequestWeight := TRUE;
					bWeightReady := FALSE;
					eStep := E_CalibStep.WEIGH_BEFORE;
				END_IF
			END_IF
		ELSE
			// If the pumps was not selected go to next one
			eStep := E_CalibStep.NEXT_PUMP;
		END_IF

	
    E_CalibStep.WEIGH_BEFORE:
		
        sStatus := CONCAT('Pump ', CONCAT(TO_STRING(iPumpIndex), CONCAT(' | Check ', CONCAT(TO_STRING(iReplicate + 1), ' | Taring Scale..'))));
		
		//Move Motor M2 for IntoResWEight
		IF NOT bMoveMotorM2 THEN
			bMoveMotorM2 := GVL_Motion.aMotors[2].MoveAbsolute(GVL_Settings.stMachineParam.aM2Position[6], GVL_Settings.stMachineParam.rM2Velocity, GVL_Settings.stMachineParam.rM2Accleration, GVL_Settings.stMachineParam.rM2Deceleration);
		END_IF
		
        IF bMoveMotorM2 AND bRequestWeight AND NOT bWeightReady THEN
            rScaleWeight := GVL_Calibration.fbScaleDevice.RequestWeight();
            IF GVL_Calibration.fbScaleDevice.bWeightReady THEN
                IF rScaleWeight = 9999.0 THEN
					tonCalDelay(IN := FALSE);
					tonStepTimeout(IN := FALSE);
					tonWeigthStabilization(IN := FALSE);
	
					GVL_HMI.bScaleNeedsAtention := TRUE;
					bScaleAttention := TRUE;
	
					bRequestWeight := FALSE;
					bWeightReady   := FALSE;
	
					eStepResume := E_CalibStep.WEIGH_BEFORE;
					eStep := E_CalibStep.SCALE_ATTENTION;
				ELSE
					rWeightBefore := rScaleWeight;
					
					GVL_calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].rTareWeigth := rWeightBefore;
					GVL_Calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].iPumpNumber := TO_USINT(iPumpIndex);
	
					bWeightReady   := TRUE;
					bRequestWeight := NOT GVL_Calibration.fbScaleDevice.Reset();
				END_IF
            END_IF
		END_IF
		IF bWeightReady THEN
			IF (rWeightBefore >= 0 AND rWeightBefore <= 1300) THEN
				GVL_calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].rTareWeigth := rWeightBefore;
				GVL_Calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].iPumpNumber := TO_USINT(iPumpIndex);
				rDistanceByVol := 0.0;
				bWeightReady := FALSE;
				bMoveMotorM2 := FALSE;
				eStep := E_CalibStep.WITHDRAW_BACKWARDS;
			ELSE
				eStep := E_CalibStep.ERROR;
			END_IF
		END_IF        

	
    E_CalibStep.WITHDRAW_BACKWARDS:

		sStatus := CONCAT(CONCAT('Pump ',CONCAT(TO_STRING(iPumpIndex),CONCAT(' | Check ',TO_STRING(iReplicate + 1)))),CONCAT(' | Pumping to calibration box: ',CONCAT(TO_STRING(aVolumeSetpoint[iPumpIndex]),' ml')));
		
		//Move Motor M2 for IntoResDispense
		IF NOT bMoveMotorM2 THEN
			bMoveMotorM2 := GVL_Motion.aMotors[2].MoveAbsolute(GVL_Settings.stMachineParam.aM2Position[5], GVL_Settings.stMachineParam.rM2Velocity, GVL_Settings.stMachineParam.rM2Accleration, GVL_Settings.stMachineParam.rM2Deceleration);
		END_IF
		
		aVolumeSetpoint[iPumpIndex] := aPumpSettings[iPumpIndex].rTargetVolume;

		GVL_calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].rTargetVolume := aPumpSettings[iPumpIndex].rTargetVolume;
		
		rDistanceByVol := F_VolumeToSteps_Path(rVolume := aVolumeSetpoint[iPumpIndex], iPumpIndex := iPumpIndex, ePath := E_PumpPath.FillCalBox );
		
		GVL_calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].iPumpRevs := TO_UINT(rDistanceByVol/360);
		GVL_HMI.aCalPumpResults[iPumpIndex].iRevsDone := GVL_calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].iPumpRevs; // Mirror pump revs done to the results table on HMI
		
		IF bMoveMotorM2 AND NOT bMovePump THEN
			bMovePump := GVL_Motion.aPumpsRotary[iPumpIndex].MoveRelative( 	Distance := - rDistanceByVol, 
																			Velocity := GVL_Settings.stPumpParameters.iMeterVelocity * 6, 	//RPM to Degree/sec
																			Acc := GVL_Settings.stPumpParameters.iMeterVelocity * 6, 		//RPM to Degree/sec
																			Dec := GVL_Settings.stPumpParameters.iMeterVelocity				//RPM to Degree/sec
																		 	);
		END_IF
		
		IF bMovePump THEN
			tonWeigthStabilization(in := TRUE, pt := tWeightStable);
			sStatus :='Waiting for weight stabilization...';
			IF bMoveMotorM2 AND tonWeigthStabilization.Q THEN
				bRequestWeight := TRUE;
				bMovePump := FALSE;
				bMoveMotorM2 := FALSE;
				tonWeigthStabilization(IN := FALSE);
				fbLocalSystemTime(bEnable := FALSE);
				bDTReady := FALSE;
				eStep := E_CalibStep.WEIGH_AFTER;
			END_IF
		END_IF


	
    E_CalibStep.WEIGH_AFTER:

		sStatus := CONCAT('Pump ', CONCAT(TO_STRING(iPumpIndex), CONCAT(' | Check ', CONCAT(TO_STRING(iReplicate + 1), ' | Requesting Gross Weight...'))));
	
		//Move Motor M2 for IntoResWeight
		IF NOT bMoveMotorM2 THEN
			bMoveMotorM2 := GVL_Motion.aMotors[2].MoveAbsolute(GVL_Settings.stMachineParam.aM2Position[6], GVL_Settings.stMachineParam.rM2Velocity, GVL_Settings.stMachineParam.rM2Accleration, GVL_Settings.stMachineParam.RM2Deceleration);
		END_IF
		
        IF bMoveMotorM2 AND bRequestWeight AND NOT bWeightReady THEN
            rScaleWeight := GVL_Calibration.fbScaleDevice.RequestWeight();
            IF GVL_Calibration.fbScaleDevice.bWeightReady THEN
                IF rScaleWeight = 9999.0 THEN
					tonCalDelay(IN := FALSE);
					tonStepTimeout(IN := FALSE);
					tonWeigthStabilization(IN := FALSE);
	
					GVL_HMI.bScaleNeedsAtention := TRUE;
					bScaleAttention := TRUE;
	
					bRequestWeight := FALSE;
					bWeightReady   := FALSE;
	
					eStepResume := E_CalibStep.WEIGH_AFTER;
					eStep := E_CalibStep.SCALE_ATTENTION;
				ELSE
					rWeightAfter := rScaleWeight;
					bWeightReady := TRUE;
					// NET (weight delta)
					rWeightDelta := rWeightAfter - rWeightBefore;
	
					// Mirror to logs
					GVL_calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].rGrossWeigth := rWeightAfter;
					GVL_calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].rNetWeigth := rWeightDelta;
	
					// Density-based volume
					GVL_calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].rNetVolume := rWeightDelta / rSolventDensity;
					
					rVolume := GVL_calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].rNetVolume;
					
					//Getting Sum Values to calculate the average on the end of replicates
					rPumpVolumeSum  := rPumpVolumeSum + rVolume;
					rTareWeightSum  := rTareWeightSum + rWeightBefore;
					rGrossWeightSum := rGrossWeightSum + rWeightAfter;
	
					bRequestWeight := NOT GVL_Calibration.fbScaleDevice.Reset();
				END_IF
			END_IF	
		END_IF	
		
		 // Produce a timestamp: DD-MMM-YYYY HH:MM:SS
        fbLocalSystemTime(bEnable := TRUE, dwCycle := 5);
		
        IF fbLocalSystemTime.bValid THEN
            stLocal := fbLocalSystemTime.systemTime;

            sMMo := F_MonthString(stLocal.wMonth);
            sDD  := F_TwoDigits(stLocal.wDay);
            sHH  := F_TwoDigits(stLocal.wHour);
            sMM  := F_TwoDigits(stLocal.wMinute);
            sSS  := F_TwoDigits(stLocal.wSecond);

			sStamp := CONCAT(sDD, '-');			//DD-
			sStamp := CONCAT(sStamp, sMMo);		//DD-MMM
			sStamp := CONCAT(sStamp, '-');		//DD-MMM-
			sStamp := CONCAT(sStamp, INT_TO_STRING(stLocal.wYear)); //DD-MMM-YYYY
			sStamp := CONCAT(sStamp, ' '); 		//DD-MMM-YYYY 
			sStamp := CONCAT(sStamp, sHH);		//DD-MMM-YYYY HH
			sStamp := CONCAT(sStamp, ':');		//DD-MMM-YYYY HH:
			sStamp := CONCAT(sStamp, sMM);		//DD-MMM-YYYY HH:MM
			sStamp := CONCAT(sStamp, ':');		//DD-MMM-YYYY HH:MM:
			sStamp := CONCAT(sStamp, sSS); 		//DD-MMM-YYYY HH:MM:SS

			bDTReady := TRUE;			
        ELSE
            sStamp := '00000000_000000'; // Fallback if system time is not valid
        END_IF
		
		IF bWeightReady AND bDTReady THEN
			
			rPercentDifference := ((rVolume - aPumpSettings[iPumpIndex].rTargetVolume)  / aPumpSettings[iPumpIndex].rTargetVolume) * 100;
			GVL_Calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].rDifferenceUl := rVolume - aPumpSettings[iPumpIndex].rTargetVolume;
			GVL_Calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].dDateTime := sStamp;
			GVL_Calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].rDifferencePercent := rPercentDifference;
			GVL_Calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].rCriteria := rAcceptanceCrit;
			
			//pupulate gross weight and net weight
			IF ABS(rPercentDifference) <= rAcceptanceCrit THEN
				aPumpResults[iPumpIndex].eStatus := E_CalibrationStatus.PASSED;
			ELSE
				// Adjust Needed flag 
				bPumpAdjustNeed := TRUE;
			END_IF
			
			iReplicate := iReplicate + 1;
			
			GVL_Calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].sStep := CONCAT('Check ', TO_STRING(iReplicate));
			
			//DB_Query.state:= E_DB_QUERY_STATE.INSERT_CALIBRATION_VALUES; //Insert new register of data on DB.
			GVL_Calibration.iResultIndex := GVL_Calibration.iResultIndex + 1;
			
			IF iReplicate >= GVL_Settings.stCalibParameters.iReplicatesSetpoint THEN
				
				// Calculating the average pump results
				rPumpAverageVolume  := rPumpVolumeSum / iReplicate;
				rPumpAvgTareWeigth  := rTareWeightSum / iReplicate;
				rPumpAvgGrossWeigth := rGrossWeightSum / iReplicate;
				
				// Mirror the pump status to HMI
				GVL_HMI.aCalPumpResults[iPumpIndex].rAvgNetVolume := rPumpAverageVolume;
				GVL_HMI.aCalPumpResults[iPumpIndex].rAvgTareWeight := rPumpAvgTareWeigth;
				GVL_HMI.aCalPumpResults[iPumpIndex].rAvgGrossWeight := rPumpAvgGrossWeigth;
				
				IF bPumpAdjustNeed THEN
					
					IF GVL_Calibration.iAllowableFailures > iNumberOfAdjusts THEN
						iReplicate := 0;
						iNumberOfAdjusts := iNumberOfAdjusts + 1;
						bPumpAdjustNeed := FALSE;
						DB_Query.state:= E_DB_QUERY_STATE.INSERT_CALIBRATION_VALUES; //Insert new register of data on DB.
						eStep := E_CalibStep.PUMPFACTOR_ADJUST;
					ELSE
						bPumpAdjustNeed := FALSE;
						eStep := E_CalibStep.PUMPFACTOR_FAILED;
					END_IF
					
				ELSE
					GVL_HMI.aCalPumpResults[iPumpIndex].eStatus := E_CalibrationStatus.PASSED;
					eStep := E_CalibStep.EMPTYJAR_BACKWARDS;
				END_IF
			ELSE
				eStep := E_CalibStep.RETURN_FORWARD;
			END_IF
			bMoveMotorM2 := FALSE;
			bWeightReady := FALSE;
		END_IF
		
	E_CalibStep.PUMPFACTOR_ADJUST: // Calculate the new factor
	
		IF NOT DB_Query.FB_Insert.bBusy AND bDataBaseSeq THEN
			GVL_Calibration.iResultIndex := GVL_Calibration.iResultIndex + 1;
			eStep := E_CalibStep.RETURN_FORWARD;
			bDataBaseSeq := FALSE;
		
		ELSIF NOT DB_Query.FB_Insert.bBusy AND NOT bDataBaseSeq THEN
			
			// Mirror the pump status to HMI
			GVL_HMI.aCalPumpResults[iPumpIndex].eStatus := E_CalibrationStatus.ADJUSTMENT_NEEDED;
			GVL_HMI.aCalPumpResults[iPumpIndex].rAvgNetVolume := rPumpAverageVolume;
			GVL_HMI.aCalPumpResults[iPumpIndex].rAvgTareWeight := rPumpAvgTareWeigth;
			GVL_HMI.aCalPumpResults[iPumpIndex].rAvgGrossWeight := rPumpAvgGrossWeigth;
			
			// new factor := target / Trunc((target / (Average / revs) ) + 0.5)  
			GVL_Retain.aCalibrationPumpFactor[iPumpindex] := aPumpSettings[iPumpIndex].rTargetVolume / TO_LREAL(TRUNC((aPumpSettings[iPumpIndex].rTargetVolume/(rPumpAverageVolume/GVL_calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex - 1].iPumpRevs))+ 0.5));
			
			GVL_Motion.aPumps[iPumpindex].Rotary.rPumpFactorFillCalBox := GVL_Retain.aCalibrationPumpFactor[iPumpindex];
			GVL_Motion.aPumps[iPumpindex].Rotary.rPumpFactorFillJars   := GVL_Retain.aCalibrationPumpFactor[iPumpindex];
			GVL_Motion.aPumps[iPumpindex].Rotary.rPumpFactorFromCalBox := GVL_Retain.aCalibrationPumpFactor[iPumpindex];
			
			// Populate the adjustment row	
			GVL_Calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].iPumpNumber := TO_USINT(iPumpIndex);
			GVL_Calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].sStep := 'Adjustment';
			GVL_Calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].dDateTime := sStamp;
			GVL_Calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].rTareWeigth := 0.00;
	
			GVL_calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].rGrossWeigth := 0.00;
	
			GVL_calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].rNetWeigth := 0.00;
			
	
			GVL_Calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].rNetVolume := 0.00;
	
			GVL_Calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].rTargetVolume := 0.00;
			GVL_Calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].rDifferencePercent := 0.00;
			
			GVL_Calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].rCriteria := 0.00;
			GVL_Calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex].iPumpRevs := TO_UINT(aPumpSettings[iPumpIndex].rTargetVolume / GVL_Motion.aPumps[iPumpindex].Rotary.rPumpFactorFillCalBox);	
			
			// final transition
			rPumpAverageVolume := 0.00;
			rPumpAvgTareWeigth := 0.00;
			rPumpAvgGrossWeigth := 0.00;
			rPumpVolumeSum := 0.00;
			rTareWeightSum := 0.00;
			rGrossWeightSum := 0.00;
			iReplicate := 0;
			
			DB_Query.state:= E_DB_QUERY_STATE.INSERT_CALIBRATION_VALUES; //Insert new register of data on DB.
			bDataBaseSeq := TRUE;
		END_IF
		
		
	E_CalibStep.PUMPFACTOR_FAILED:
		// Update the HMI pump status
		GVL_HMI.aCalPumpResults[iPumpIndex].eStatus := E_CalibrationStatus.FAILED;
		GVL_HMI.aCalPumpResults[iPumpIndex].rAvgNetVolume := rPumpAverageVolume;
		GVL_HMI.aCalPumpResults[iPumpIndex].rAvgTareWeight := rPumpAvgTareWeigth;
		GVL_HMI.aCalPumpResults[iPumpIndex].rAvgGrossWeight := rPumpAvgGrossWeigth;
		
		// Changing the Step string to have failed in it
		GVL_Calibration.stPumpCalibrationData[GVL_Calibration.iResultIndex - 1].sStep := CONCAT(CONCAT('Check ', TO_STRING(iReplicate)), CONCAT(' ***', CONCAT(CHR(13) , CONCAT(CHR(10), 'FAILED ***'))));
		
		// final transition
		iNumberOfAdjusts := 0;
		rPumpAverageVolume := 0.00;
		rPumpAvgTareWeigth := 0.00;
		rPumpAvgGrossWeigth := 0.00;
		rPumpVolumeSum := 0.00;
		rTareWeightSum := 0.00;
		rGrossWeightSum := 0.00;
		iReplicate := 0;
		eStep := E_CalibStep.EMPTYJAR_BACKWARDS;
		
    E_CalibStep.RETURN_FORWARD:

		sStatus := CONCAT(CONCAT('Pump ',CONCAT(TO_STRING(iPumpIndex), CONCAT(' | Check ', CONCAT(TO_STRING(iReplicate + 1), ' | ')))), CONCAT('Returning solvent back to the Jar : ', F_JarName(iPumpIndex := iPumpIndex)));
		rDistanceByVol := F_VolumeToSteps_Path(rVolume := (aPumpSettings[iPumpIndex].rTargetVolume + 5), iPumpIndex := iPumpIndex, ePath := E_PumpPath.FromCalBox);
		
		//Move Motor M2 for IntoResWeight
		IF NOT bMoveMotorM2 THEN
			bMoveMotorM2 := GVL_Motion.aMotors[2].MoveAbsolute(GVL_Settings.stMachineParam.aM2Position[4], GVL_Settings.stMachineParam.rM2Velocity, GVL_Settings.stMachineParam.rM2Accleration, GVL_Settings.stMachineParam.rM2Deceleration);
		END_IF
			
        IF bMoveMotorM2 AND NOT bMovePump THEN
			bMovePump := GVL_Motion.aPumpsRotary[iPumpIndex].MoveRelative( 	Distance := rDistanceByVol, 
																			Velocity := GVL_Settings.stPumpParameters.iMeterVelocity * 6, 	//RPM to Degree/sec
																			Acc := GVL_Settings.stPumpParameters.iMeterVelocity * 6, 		//RPM to Degree/sec
																			Dec := GVL_Settings.stPumpParameters.iMeterVelocity * 6			//RPM to Degree/sec
																		  	);
		END_IF
		
		IF bMovePump THEN
			tonWeigthStabilization(IN := TRUE, PT := tWeightStable);
			sStatus := 'Waiting for weight stabilization...';
			IF tonWeigthStabilization.Q THEN
				bMovePump := FALSE;
				bMoveMotorM2 := FALSE;
				tonWeigthStabilization(IN := FALSE);
				bRequestWeight := TRUE;
				bWeightReady := FALSE;
				eStep := E_CalibStep.WEIGH_BEFORE; // Starts next replication
			END_IF
		END_IF
		DB_Query.state:= E_DB_QUERY_STATE.INSERT_CALIBRATION_VALUES; //Insert new register of data on DB.
		
	E_CalibStep.EMPTYJAR_BACKWARDS:

		sStatus := CONCAT('Pump ',CONCAT(TO_STRING(iPumpIndex),CONCAT(' | Empty the jar number: ',TO_STRING(iPumpIndex))));
		aVolumeSetpoint[iPumpIndex] := aPumpSettings[iPumpIndex].rTargetVolume;
		
		//Move Motor M2 for IntoResDispense
		IF NOT bMoveMotorM2 THEN
			bMoveMotorM2 := GVL_Motion.aMotors[2].MoveAbsolute(GVL_Settings.stMachineParam.aM2Position[5], GVL_Settings.stMachineParam.rM2Velocity, GVL_Settings.stMachineParam.rM2Accleration, GVL_Settings.stMachineParam.rM2Deceleration);
		END_IF
		
		IF iPumpIndex = 1 THEN
			rEmptyJarTotalVol := aVolumeSetpoint[iPumpIndex] + GVL_Settings.stPumpParameters.iEmptyFactor;
		ELSE
			rEmptyJarTotalVol := GVL_Settings.stPumpParameters.iEmptyFactor;
		END_IF
		
		rDistanceByVol := F_VolumeToSteps_Path(rVolume := rEmptyJarTotalVol, iPumpIndex := iPumpIndex, ePath := E_PumpPath.FromCalBox );
		
        IF bMoveMotorM2 AND NOT bMovePump THEN
			bMovePump := GVL_Motion.aPumpsRotary[iPumpIndex].MoveRelative( 	Distance := - rDistanceByVol, 
																			Velocity := GVL_Settings.stPumpParameters.iRunVelocity * 6, 	//RPM to Degree/sec
																			Acc := GVL_Settings.stPumpParameters.iRunVelocity * 6, 			//RPM to Degree/sec
																			Dec := GVL_Settings.stPumpParameters.iRunVelocity * 6			//RPM to Degree/sec
																		  	);
		END_IF
		
		IF bMovePump THEN
			bMoveMotorM2 := FALSE;
			bMovePump := FALSE;
			eStep := E_CalibStep.NEXT_PUMP;
		END_IF
		DB_Query.state:= E_DB_QUERY_STATE.INSERT_CALIBRATION_VALUES; //Insert new register of data on DB.
	
    E_CalibStep.NEXT_PUMP:
		// Reset sum and avg values	
        iPumpIndex := iPumpIndex + 1;
        iReplicate := 0;
		iNumberOfAdjusts := 0;
		rPumpAverageVolume := 0.00;
		rPumpAvgTareWeigth := 0.00;
		rPumpAvgGrossWeigth := 0.00;
		rPumpVolumeSum := 0.00;
		rTareWeightSum := 0.00;
		rGrossWeightSum := 0.00;
        IF iPumpIndex <= 10 THEN
            eStep := E_CalibStep.FILLJAR_FORWARD;
        ELSE
            eStep := E_CalibStep.HOMING_MOTORS;
        END_IF

	
    E_CalibStep.HOMING_MOTORS:
        sStatus := 'Returning M2 and M3 to home';
				
		IF NOT bMoveMotorM2 THEN
			bMoveMotorM2 := GVL_Motion.aMotors[2].MoveAbsolute(	GVL_Settings.stMachineParam.aM2Position[1], 
																GVL_Settings.stMachineParam.rM2Velocity, 
																GVL_Settings.stMachineParam.rM2Accleration, 
																GVL_Settings.stMachineParam.rM2Deceleration
																);
		END_IF
		IF NOT bMoveMotorM3 AND bMoveMotorM2 THEN
			bMoveMotorM3 := GVL_Motion.aMotors[3].MoveAbsolute(	GVL_Settings.stMachineParam.aM3Position[1], 
																GVL_Settings.stMachineParam.rM3Velocity, 
																GVL_Settings.stMachineParam.rM3Accleration, 
																GVL_Settings.stMachineParam.rM3Deceleration
																);
		END_IF
				
		IF bMoveMotorM2 AND bMoveMotorM3 THEN
			tonMotorsDelay(in := TRUE, pt := T#200MS);
		END_IF
		
		IF tonMotorsDelay.Q THEN
			tonStepTimeout(IN := FALSE);
			IF GVL_Settings.stCalibParameters.iAirDryTimeSec > 0 THEN // IF Air Dry time settings is greater than zero go to air dry step
				eStep := E_CalibStep.REPORT_INFO_UPDATE; // AIR_DRY_TIME
			ELSE
				eStep := E_CalibStep.REPORT_INFO_UPDATE;
			END_IF
		END_IF
   
		
	E_CalibStep.AIR_DRY_TIME:
		IF NOT bSetSolenoids THEN
			//Check if the M1 motor is not on seal stages position
			IF GVL_Settings.stMachineParam.aM1Position[2] >= (GVL_Motion.M1Motor.rActualPos + rPosTolerance) AND NOT bMoveMotorM1 THEN
				IF NOT bMoveMotorM1 THEN
					bMoveMotorM1 := NOT GVL_Motion.aMotors[1].MoveAbsolute(	rPosition := GVL_Settings.stMachineParam.aM1Position[2],
																			rVelocity := GVL_Settings.stMachineParam.rM1Velocity,
																			rAcc	  := GVL_Settings.stMachineParam.rM1Accleration,
																			rDec	  := GVL_Settings.stMachineParam.rM1Deceleration);
				END_IF
			ELSE
				//M1 Position ok
				bSetSolenoids := GVL_IO.gSetSolenoidControl.AirDry(); //Open Solenoids
				bMoveMotorM1 := TRUE;
			END_IF
		ELSE
			bMoveMotorM1 := FALSE;
			bAirDryTrigger := TRUE;
		END_IF
		
		// Air Dry Timer
		tonAirDry( IN := bAirDryTrigger, PT := UINT_TO_TIME(GVL_Settings.stCalibParameters.iAirDryTimeSec*1000));
		
		IF tonAirDry.Q THEN
			//Return Solenoids to Idle state
			IF GVL_IO.gSetSolenoidControl.Idle() THEN
				bSetSolenoids := FALSE;
				//Transition
				eStep := E_CalibStep.REPORT_INFO_UPDATE;
			END_IF
		END_IF
	
	E_CalibStep.REPORT_INFO_UPDATE: //TODO: Update the variables without hardcode
		//Reset Motors Flags
		bMoveMotorM2 := FALSE;
		bMoveMotorM3 := FALSE;	
		tonMotorsDelay(in := FALSE);
		
		//Report Info
		GVL_Calibration.stPumpCalReportInfo.sReportName := GVL_Constant.sPumpCalibrationReportName;
		GVL_Calibration.stPumpCalReportInfo.sReoportSubName := GVL_Constant.sPumpCalibrationReportSubName;
		GVL_Calibration.stPumpCalReportInfo.sDatabaseName := GVL_Constant.sDatabaseName;
		GVL_Calibration.stPumpCalReportInfo.sReportDate := sStamp;
		GVL_Calibration.stPumpCalReportInfo.sPrintedBy := 'Administrator';
		GVL_Calibration.stPumpCalReportInfo.sSystemID := GVL_Constant.sSystemID;
		GVL_Calibration.stPumpCalReportInfo.iPage := 0;
		
		//Calibration Info
		GVL_Retain.iCalibrationNumber := GVL_Retain.iCalibrationNumber + 1;
		//GVL_Calibration.stPumpCalibrationInfo.iCalibrationNumber := TO_UINT(GVL_Retain.iCalibrationNumber);
		GVL_Calibration.stPumpCalibrationInfo.iAllowableFailures := GVL_Calibration.iAllowableFailures;
		GVL_Calibration.stPumpCalibrationInfo.iCalIntervalDays := 0;
		GVL_Calibration.stPumpCalibrationInfo.iReplicates := GVL_Calibration.iReplicatesSetpoint;
		GVL_Calibration.stPumpCalibrationInfo.iSolventID := '1';
		GVL_Calibration.stPumpCalibrationInfo.iSysMasterListRev := 0;
		GVL_Calibration.stPumpCalibrationInfo.iSysSettingsRev := 0;
		GVL_Calibration.stPumpCalibrationInfo.iUserID := 'vd24';
		
		eStep := E_CalibStep.COMPLETE; 		
		
	E_CalibStep.CALBOX_ATTENTION:
    // Pause here while the operator adjusts the box weight on the scale.
    // No timeouts are running in this state.

    bBusy   := TRUE;
    sStatus := 'Calibration box requires attention. Please fix and press continue.';

    // Continue pressed on HMI?
    IF GVL_HMI.bCalBoxFixed THEN
        // Clear HMI flags
        GVL_HMI.bCalBoxNeedsAttention := FALSE;
        GVL_HMI.bCalBoxFixed := FALSE;

        bCalBoxAttention := FALSE;

        // Re-arm the same step to re-request a fresh weight
        bRequestWeight := TRUE;
        bWeightReady   := FALSE;

        // Return exactly where we paused (CHECKING_WEIGH)
        eStep := eStepResume;

		ELSIF GVL_Calibration.bAbortCalibration THEN
			sStatus := 'Calibration aborted during calibration box attention.';
			eStep   := E_CalibStep.ERROR;
		END_IF	
		
	E_CalibStep.SCALE_ATTENTION:
		bBusy := TRUE;
		sStatus := 'Scale requires attention. Please fix on the device and press Continue.';
		
		// Resets calibration box attention
		GVL_HMI.bCalBoxNeedsAttention := FALSE;
		GVL_HMI.bCalBoxFixed := FALSE;
		bCalBoxAttention := FALSE;
		
		// Wait for operator to press "Continue" (HMI toggles this)
		IF GVL_HMI.bScaleFixed THEN
			GVL_HMI.bScaleNeedsAtention := FALSE;
			GVL_HMI.bScaleFixed := FALSE;
			bScaleAttention := FALSE;
	
			// Re-arm reading for the same step
			bRequestWeight := TRUE;
			bWeightReady   := FALSE;
	
			// Resume exactly where we were
			eStep := eStepResume;
	
		ELSIF GVL_Calibration.bAbortCalibration THEN
			sStatus := 'Calibration aborted during scale attention.';
			eStep := E_CalibStep.ERROR;
		END_IF
	
		
    E_CalibStep.COMPLETE:
        sStatus := 'Calibration Complete';
		iDataCount := GVL_Calibration.iResultIndex - 1;
        bDone := TRUE;
        bBusy := FALSE;
		
        // Remains here till external reset
	
    E_CalibStep.ERROR:
        bBusy := FALSE;
        bDone := FALSE;
        sStatus := 'Calibration aborted due to error. Press Stop button to start over';
		
		// FIX: The header row was already inserted into [CALIBRATION_HEAD] at
		// calibration start. If no measurements were recorded (iResultIndex <= 1),
		// that header row is now orphaned — it appears in the view with NULL
		// date columns because [CALIBRATION] has no matching rows.
		// Delete the orphaned header row so the view stays clean.
		IF iResultIndex <= 1 AND DB_Query.state = E_DB_QUERY_STATE.IDLE_STATE THEN
			DB_Query.state := E_DB_QUERY_STATE.DELETE_CALIBRATION_HEAD;
		END_IF
		
		// Remains here till external reset

END_CASE

ACT_ProgressUI_Real();]]></ST>
    </Implementation>
    <Action Name="ACT_CleanStart" Id="{aab31dd9-654e-418d-bd8f-64f5f4ef8ac0}">
      <Implementation>
        <ST><![CDATA[iPumpIndex := 1;
iReplicate := 0;
iNumberOfAdjusts := 0;
GVL_Calibration.iResultIndex := 1; // first log row
rPumpAverageVolume := 0.00;
rPumpAvgTareWeigth := 0.00;
rPumpAvgGrossWeigth := 0.00;
rPumpVolumeSum := 0.00;
rTareWeightSum := 0.00;
rGrossWeightSum := 0.00;
bPumpAdjustNeed := FALSE;
bStartCalibration := FALSE;

FOR i := 1 TO 10 DO
	GVL_HMI.aCalPumpResults[i].eStatus := E_CalibrationStatus.IDLE;
	GVL_HMI.aCalPumpResults[i].rAvgNetVolume := 0.00;
	GVL_HMI.aCalPumpResults[i].rAvgTareWeight := 0.00;
	GVL_HMI.aCalPumpResults[i].rAvgGrossWeight := 0.00;
END_FOR
]]></ST>
      </Implementation>
    </Action>
    <Action Name="ACT_ProgressUI_Real" Id="{c46d8e09-1679-4dd6-9c09-902e98888281}">
      <Implementation>
        <ST><![CDATA[// --- 1) Detecta troca de sStatus e define PT com base real ---
IF sStatus <> sPrev THEN
    tPT := T#0MS; // default: sem barra

    // POSITION_MOTORS  (usa |alvo - atual| / vel e pega o mais lento + 200ms)
    IF FIND(sStatus, 'Positioning motors M2 and M3') = 1 THEN
        rDeltaM2 := ABS(GVL_Settings.stMachineParam.aM2Position[4] - GVL_Motion.M2Motor.rActualPos);
        rDeltaM3 := ABS(GVL_Settings.stMachineParam.aM3Position[4] - GVL_Motion.M3Motor.rActualPos); 
        rVM2 := MAX(0.1, GVL_Settings.stMachineParam.rM2Velocity);
        rVM3 := MAX(0.1, GVL_Settings.stMachineParam.rM3Velocity);
        rSecs := MAX(rDeltaM2 / rVM2, rDeltaM3 / rVM3) + 0.2;
        tPT := F_sec_to_time(rSecs);

    ELSIF FIND(sStatus, 'Positioning valves to Position 6') = 1 THEN
        tPT := T#2S;

    ELSIF FIND(sStatus, 'Filling up the jar') = 1 THEN
        rPumpVelDeg := MAX(1.0, GVL_Settings.stPumpParameters.iMeterVelocity) * 6.0; // RPM->deg/s
        rSecs := ABS(rDistanceByVol) / rPumpVelDeg;
        tPT := F_sec_to_time(rSecs);

    ELSIF (FIND(sStatus, 'Taring Scale') > 0) OR (FIND(sStatus, 'Requesting Gross Weight') = 1) THEN
        tPT := T#3S;

    ELSIF FIND(sStatus, 'Pumping to calibration box') > 0 THEN
        rPumpVelDeg := MAX(1.0, GVL_Settings.stPumpParameters.iMeterVelocity) * 6.0;
        rSecs := ABS(rDistanceByVol) / rPumpVelDeg;
        tPT := F_sec_to_time(rSecs);

    ELSIF FIND(sStatus, 'Returning solvent back to the Jar') > 0 THEN
        rPumpVelDeg := MAX(1.0, GVL_Settings.stPumpParameters.iMeterVelocity) * 6.0;
        rSecs := ABS(rDistanceByVol) / rPumpVelDeg;
        tPT := F_sec_to_time(rSecs);

    ELSIF FIND(sStatus, 'Empty the jar') = 1 THEN
        rRunVelDeg := MAX(1.0, GVL_Settings.stPumpParameters.iRunVelocity) * 6.0;
        rSecs := ABS(rDistanceByVol) / rRunVelDeg;
        tPT := F_sec_to_time(rSecs);

    ELSIF FIND(sStatus, 'Returning M2 and M3 to home') = 1 THEN
        rDeltaM2 := ABS(GVL_Settings.stMachineParam.aM2Position[1] - GVL_Motion.M2Motor.rActualPos);
        rDeltaM3 := ABS(GVL_Settings.stMachineParam.aM3Position[1] - GVL_Motion.M3Motor.rActualPos);
        rVM2 := MAX(0.1, GVL_Settings.stMachineParam.rM2Velocity);
        rVM3 := MAX(0.1, GVL_Settings.stMachineParam.rM3Velocity);
        rSecs := MAX(rDeltaM2 / rVM2, rDeltaM3 / rVM3) + 0.2;
        tPT := F_sec_to_time(rSecs);

    ELSIF (eStep = E_CalibStep.AIR_DRY_TIME) THEN
        tPT := UINT_TO_TIME(GVL_Settings.stCalibParameters.iAirDryTimeSec * 1000);

    ELSIF FIND(sStatus, 'Waiting for weight stabilization') = 1 THEN
        tPT := tonWeigthStabilization.PT;
    END_IF

    // Atualiza label na HMI
    GVL_HMI.sCalibProgressLabel := sStatus;

    // (Re)arma a barra
    IF tPT > T#0MS THEN
        GVL_HMI.bCalibStepLoading := TRUE;
        GVL_HMI.rCalibStepPercent := 0.0;

        // reset do TON (será armado novamente abaixo)
        tonProgress(IN := FALSE);
    ELSE
        GVL_HMI.bCalibStepLoading := FALSE;
        GVL_HMI.rCalibStepPercent := 0.0;
        tonProgress(IN := FALSE);
    END_IF
END_IF;

// --- 2) Chama SEMPRE o TON (enquanto loading estiver ativo) ---
tonProgress(
    IN := GVL_HMI.bCalibStepLoading,
    PT := tPT
);

// --- 3) Atualiza percentual enquanto carrega ---
IF GVL_HMI.bCalibStepLoading AND (tPT > T#0MS) THEN
    GVL_HMI.rCalibStepPercent :=
        LIMIT(0.0, 100.0 * TO_REAL(tonProgress.ET) / TO_REAL(tPT), 100.0);

    IF tonProgress.Q THEN
        GVL_HMI.rCalibStepPercent := 100.0;
        // se quiser apagar a barra no fim:
        // GVL_HMI.bCalibStepLoading := FALSE;
        // tonProgress(IN := FALSE);
    END_IF
END_IF;

// --- 4) Memoriza último status ---
sPrev := sStatus;]]></ST>
      </Implementation>
    </Action>
    <Method Name="Reset" Id="{c7d0a07f-1407-4f39-a43b-1c9fdbfdf587}">
      <Declaration><![CDATA[METHOD Reset : BOOL
VAR_INPUT
	bHard : BOOL := FALSE;
END_VAR
VAR
	iLocal : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// 1) Stop motion/actuators best-effort (ignore returns; repeated calls are safe)
(*
IF (SIZEOF(GVL_Motion.aMotors) >= 3*SIZEOF(GVL_Motion.aMotors[1])) THEN
    GVL_Motion.aMotors[2].Stop();
    GVL_Motion.aMotors[3].Stop();
	GVL_Motion.aMotors[2].Reset();
	GVL_Motion.aMotors[3].Reset();
END_IF

FOR iLocal := 1 TO 10 DO
    GVL_Motion.aPumpsRotary[iLocal].Stop();
	GVL_Motion.aPumpsRotary[iLocal].Reset();
END_FOR

FOR iLocal := 1 TO 5 DO
    GVL_Motion.aValvesObj[iLocal].Stop();
	GVL_Motion.aValvesObj[iLocal].Reset();
END_FOR
*)

FOR iLocal := 1 TO 10 DO
	GVL_HMI.aCalPumpResults[iLocal].eStatus := E_CalibrationStatus.IDLE;
END_FOR

GVL_Calibration.fbScaleDevice.Reset();

// 2) Disarm timers/edge detectors and clear triggers
tonCalDelay(IN := FALSE);
tonStepTimeout(IN := FALSE);
tonWeigthStabilization(IN := FALSE);
tonMotorsDelay(in := FALSE);
tonProgress(in := FALSE);

// Drop R_TRIG by passing CLK := FALSE this cycle
bExecutePulse(CLK := FALSE);

// 3) Clear internal flags and intermediate states
bStartCalibration     := FALSE;
bCalibrationRequested := FALSE;

bRequestWeight        := FALSE;
bWeightReady          := FALSE;

bMovePump             := FALSE;
bMoveMotorM2          := FALSE;
bMoveMotorM3          := FALSE;
bDataBaseSeq 		  := FALSE;

FOR iLocal := 1 TO 5 DO
    bMoveValve[iLocal] := FALSE;
END_FOR

// 4) Reset indexes and temporaries
iPumpIndex    := 1;
iReplicate    := 0;
iResultIndex  := 1;
iNumberOfAdjusts := 0;

rWeightBefore 	 := 0.0;
rWeightAfter  	 := 0.0;
rWeightDelta  	 := 0.0;
rVolume       	 := 0.0;
rScaleWeight  	 := 0.0;
rDistanceByVol   := 0.0;
rFillJarTotalVol := 0.0;

rPumpAverageVolume := 0.00;
rPumpAvgTareWeigth := 0.00;
rPumpAvgGrossWeigth := 0.00;
rPumpVolumeSum := 0.00;
rTareWeightSum := 0.00;
rGrossWeightSum := 0.00;

sPrev       := '';
tPT         := T#0S;
rDeltaM2	:= 0.00;
rDeltaM3	:= 0.00;
rVM2		:= 0.00;
rVM3		:= 0.00;
rPumpVelDeg := 0.00;
rRunVelDeg	:= 0.00;
rSecs		:= 0.00;

// 5) Optional “hard” cleanup: clear selections and results
IF bHard THEN
    FOR iLocal := 1 TO 10 DO
        aPumpMask[iLocal]       := FALSE;
        aVolumeSetpoint[iLocal] := 0.0;
        aVelocity[iLocal]       := 0.0;
        aDirection[iLocal]      := E_PumpDirection.Forward; // default

        // Public result mirror (if you want a clean slate)
        aPumpResults[iLocal].eStatus        := E_CalibrationStatus.UNKNOWN;
        aPumpResults[iLocal].bAdjustment    := FALSE;
        aPumpResults[iLocal].bBusy          := FALSE;
        aPumpResults[iLocal].bSelected      := FALSE;
        aPumpResults[iLocal].iFailures      := 0;
        aPumpResults[iLocal].rActualVolume  := 0.0;
        aPumpResults[iLocal].rTargetVolume  := 0.0;
        aPumpResults[iLocal].tElapsed       := T#0S;
        aPumpResults[iLocal].tStartTime     := T#0S;

        // If you mirror HMI results elsewhere, clear here as needed.
    END_FOR
END_IF

// 6) Normalize outputs and step
bBusy   := FALSE;
bDone   := FALSE;
sStatus := 'Idle (reset)';
GVL_HMI.bAbortCalibrationBT := FALSE;
eStep   := E_CalibStep.IDLE;

// 7) Idempotent return
Reset := TRUE;]]></ST>
      </Implementation>
    </Method>
