<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_InitChecks" Id="{ca2f8e73-30a6-41b7-a1d5-e28e096b5f8e}" SpecialFunc="None">
    <Declaration><![CDATA[(*
==============================================================================
 FB_InitChecks
------------------------------------------------------------------------------
 Purpose:
   Perform the machine initialization safety validation before starting 
   Auto Cycle or any motion-critical operation.

   This block verifies the following conditions in sequence:
     1) 24V and 48V power supply availability  
     2) All safety doors are physically closed  
     3) Doors are locked (interlock engaged)  
     4) Air supply is available and safe to enable  
     5) If all checks pass → bInitOK := TRUE

 Usage:
   - Call cyclically.
   - Set bExecute := TRUE to start evaluation.
   - bInitOK  = TRUE  → All initial conditions satisfied.
   - bError   = TRUE  → A condition failed; machine must not start.
   - bReset   = TRUE  → Asynchronous reset to return FB to state 0.

 Safety Outputs Controlled:
   - GVL_Safety.bAirSupplyEnable   : Enables solenoid / pneumatic air supply.
   - GVL_Safety.bDoorLockCommand   : Locks the safety doors.
   - GVL_Safety.SafetyOutputs.bAirPressureOK : Temporary mock (TODO).

 Notes:
   - State machine steps:
       0 : Reset / Idle  
       1 : Check power  
       2 : Check doors closed  
       3 : Check doors locked  
       4 : Enable air supply  
       5 : Success  
      99 : Error state  
==============================================================================
*)
FUNCTION_BLOCK FB_InitChecks
VAR_INPUT
    bExecute      : BOOL;   // Start initialization check
    bPower24V_OK  : BOOL;   // External 24V supply OK
    bPower48V_OK  : BOOL;   // External 48V supply OK
    bDoorsClosed  : BOOL;   // Physical door closed sensors
    bDoorsLocked  : BOOL;   // Door lock feedback
    bAirEnabled   : BOOL;   // Air supply feedback (valves/sensors)
    bReset        : BOOL;   // Asynchronous reset
END_VAR

VAR_OUTPUT
    bInitOK : BOOL := FALSE; // TRUE when all safety checks pass
    bError  : BOOL := FALSE; // TRUE if any condition fails
END_VAR

VAR
    iState : INT := 0;       // Internal state machine
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ==========================================================================
// Initialization State Machine
// ==========================================================================
CASE iState OF

    // ----------------------------------------------------------------------
    // STATE 0 — RESET / IDLE
    // ----------------------------------------------------------------------
    0:
        // Reset outputs
        bInitOK := FALSE;
        bError  := FALSE;

        // Reset safety commands
        GVL_Safety.bAirSupplyEnable := FALSE;
        GVL_Safety.bDoorLockCommand := FALSE;

        // Start sequence
        IF bExecute AND NOT bReset THEN
            iState := 1;   // Next: power supply check
        END_IF


    // ----------------------------------------------------------------------
    // STATE 1 — POWER SUPPLY CHECK
    // ----------------------------------------------------------------------
    1:
        IF bReset THEN
            iState := 0;   // Full reset if requested

        ELSIF NOT (bPower24V_OK AND bPower48V_OK) THEN
            // Fail: power missing
            bError := TRUE;

            GVL_Safety.bAirSupplyEnable := FALSE;
            GVL_Safety.bDoorLockCommand := FALSE;

            iState := 99;  // Error state

        ELSE
            iState := 2;   // Pass → next check
        END_IF;


    // ----------------------------------------------------------------------
    // STATE 2 — DOORS CLOSED CHECK
    // ----------------------------------------------------------------------
    2:
        IF bReset THEN
            iState := 0;

        ELSIF NOT bDoorsClosed THEN
            // Fail: a door is open
            GVL_Safety.bAirSupplyEnable := FALSE;
            GVL_Safety.bDoorLockCommand := FALSE;

            iState := 99;

        ELSE
            iState := 3;   // Pass → next
        END_IF;


    // ----------------------------------------------------------------------
    // STATE 3 — DOOR LOCK CHECK
    // ----------------------------------------------------------------------
    3:
        IF bReset THEN
            iState := 0;

        ELSIF NOT bDoorsLocked THEN
            (* NOTE:
               In the original system, the door locking command might be issued here.
               For now, it is commented out due to testing state of the machine.
               TODO: Restore door locking command when hardware is validated:
                 GVL_Safety.bDoorLockCommand := TRUE;
            *)
            GVL_Safety.bAirSupplyEnable := FALSE;

        ELSE
            iState := 4;   // Pass → proceed to air supply
        END_IF;


    // ----------------------------------------------------------------------
    // STATE 4 — AIR SUPPLY CHECK
    // ----------------------------------------------------------------------
    4:
        IF bReset THEN
            iState := 0;

        ELSIF NOT bAirEnabled THEN
            // Temporary: assert air pressure OK (mock)
            // TODO: Replace with actual analog pressure measurement
            GVL_Safety.SafetyOutputs.bAirPressureOK := TRUE;

            GVL_Safety.bAirSupplyEnable := TRUE;

        ELSE
            // Air OK → move to final state
            iState := 5;
        END_IF;


    // ----------------------------------------------------------------------
    // STATE 5 — SUCCESS (ALL CHECKS PASSED)
    // ----------------------------------------------------------------------
    5:
        IF bReset THEN
            iState := 0;
        ELSE
            bInitOK := TRUE;
        END_IF;


    // ----------------------------------------------------------------------
    // STATE 99 — ERROR STATE
    // ----------------------------------------------------------------------
    99:
        IF bReset THEN
            iState := 0;
        ELSE
            bError := TRUE;
        END_IF;

END_CASE]]></ST>
    </Implementation>
    <Method Name="Reset" Id="{2e04276d-176d-4cd9-a240-d7674b5986ea}">
      <Declaration><![CDATA[(*
==============================================================================
 Method: Reset
------------------------------------------------------------------------------
 Purpose:
   Restore internal state to default so a new initialization sequence 
   may be executed safely.

 Behaviour:
   - Clears bInitOK, bError.
   - Returns to state 0.
   - Does NOT automatically re-enable safety outputs (left to state machine).
==============================================================================
*)
METHOD Reset : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Reset := FALSE;

// Clear flags
bInitOK := FALSE;
bError  := FALSE;

// Reset internal FSM
iState := 0;

// Method completes successfully
Reset := TRUE;
RETURN;
]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_InitChecks">
      <LineId Id="937" Count="123" />
      <LineId Id="1062" Count="0" />
      <LineId Id="9" Count="0" />
    </LineIds>
    <LineIds Name="FB_InitChecks.Reset">
      <LineId Id="35" Count="11" />
      <LineId Id="15" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>