<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_LeakTest" Id="{21d6925c-1467-47b6-a1a0-80200f2aa3f7}" SpecialFunc="None">
    <Declaration><![CDATA[(*
==============================================================================
 FB_LeakTest
------------------------------------------------------------------------------
 Purpose:
   - Perform an automatic leak test on the Andersen / ASRS system.
   - Sequence:
       1) Move all 6-position valves to leak test position (pos. 6).
       2) Optionally seal stages by moving M1 to the sealing position.
       3) Set solenoids to "PressureUp" and build pressure for a defined time.
       4) Close air and hold pressure.
       5) Monitor the pressure over a configured time window.
       6) Pass criteria: measured pressure >= configured threshold.
       7) If pressure drops below threshold → test fails (ERROR).

 HMI:
   - The action ACT_LoadingIcon handles:
       * Animation of the leak test progress bar.
       * Estimation of the total leak test duration.
   - This FB updates:
       * GVL_HMI.HMIAnimation.sLoadTextLeakTest
       * GVL_HMI.HMIAnimation.rLoadBarLeakTest
       * GVL_HMI.HMIAnimation.eIconStateLeakTest

 Usage:
   - Call cyclically with:
        bExecute := TRUE
        eSolenoidPosition := E_SolenoidSet.LEAKTEST (from AutoCycle)
        tPressureUpTime   := <seconds>
        tMonitorTime      := <seconds>
   - Outputs:
        bLeakTestDone  = TRUE  → leak test passed.
        bLeakTestError = TRUE  → leak test failed or valve error.
        rSystemPressure        → current scaled pressure (PSI).
        sLTMessageError        → error description (on failure).
   - Call Reset() to clear internal state before a new leak test.
==============================================================================
*)

FUNCTION_BLOCK FB_LeakTest
VAR_INPUT
    bExecute          : BOOL;       // Start command for leak test
    eSolenoidPosition : E_SolenoidSet; // Solenoid configuration (not used directly here)
    tMonitorTime      : UINT;       // Monitoring duration [s]
    tPressureUpTime   : UINT;       // Pressurization duration [s]
END_VAR

VAR_OUTPUT
    bLeakTestDone   : BOOL;                 // TRUE when leak test finished successfully
    rSystemPressure : LREAL;                // Current scaled system pressure (PSI)
    bLeakTestError  : BOOL;                 // TRUE if any error or failure during leak test
    sLTMessageError : STRING(100);          // Human readable description of leak test failure
END_VAR

VAR
    // Valve and solenoid / sensor helper blocks
    aValveMoveDone  : ARRAY[1..5] OF BOOL;  // TRUE when each valve finishes moving
    fbSolenoidControl : FB_SolenoidControl; // Not directly used here (we call gSetSolenoidControl)
    fbSensorScaling : FB_SensorScaling;     // Reserved for future scaling use

    // Pressure / timing flags
    bPressureInput  : BOOL := FALSE;        // Internal enable for monitoring TON
    tStartTime      : TIME;                 // Reserved (not used in current implementation)
    rScaledPressure : REAL;                 // Raw scaled pressure in PSI
    eState          : (IDLE, POSITION_VALVES, SET_SOLENOIDS, SEAL_STAGES, PRESSURIZE, CLOSE_AIR, MONITOR, RELEASE_AIR, DONE, ERROR); //Implicit_Enum__FB_LeakTest__eState; // Internal state machine

    bMoveValves        : BOOL := FALSE;     // Internal "valve move" flag
    bPressureTime      : BOOL := FALSE;     // Enables pressurization TON
    bPressureTaken     : BOOL := FALSE;     // TRUE when pressure threshold is captured
    bMoveM1MotorFast   : BOOL := FALSE;     // Fast movement part of M1 sealing (coarse position)
    bMoveM1MotorSlow   : BOOL := FALSE;     // Slow, precise movement of M1 to sealing position
    bM1MoveStartDelay  : BOOL := FALSE;     // Delay between fast and slow M1 movements
	bLeakTestPassed	   : BOOL := FALSE;     // Leak test passed flag
	
    rClosedSystemPressure : REAL := 0.0;    // Pressure threshold limit (from settings)

    // Timers
    tonPressuring   : TON;                  // Timer for pressure build-up phase
    tonMonitoring   : TON;                  // Timer for pressure monitoring phase
    tonM1MoveDelay  : TON;                  // Delay between fast and slow M1 moves
    tonIconLoading  : TON;                  // Progress bar animation timer

    tLoadingTotalTime : TIME;               // Total time used by ACT_LoadingIcon
    bLoadTimeTaken    : BOOL := FALSE;      // TRUE once total time is calculated

    // Actuator status and debug
    stStatus      : ARRAY[1..5] OF ST_ActuatorStatus; // Status of each valve
    i             : USINT := 0;                        // Generic loop index
    fbEventHandler : FB_EventHandler;                  // Event logger instance
    bExecuteEvent : BOOL := FALSE;                     // Trigger for event logger
    bEventDone    : BOOL := FALSE;                     // Event logger completion

    rTargetPosition : INT;                             // Reserved (not used currently)
    bIconAnimation  : BOOL;                            // TRUE when leak-test load bar is active

    bDebug : ARRAY[1..10] OF BOOL;                    // Debug flags (for online analysis)
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[//=============================================================================
// Main body
//=============================================================================

// 1) HMI icon animation and load-bar handling (time estimation)
ACT_LoadingIcon();

ACT_CalScreenStatus();

// 2) Leak-test state machine
CASE eState OF

    //=====================================================================
    // IDLE
    //  - Waiting for bExecute to start a new leak test.
    //=====================================================================
    IDLE:
        // Start only if requested and there is no pending DONE / ERROR
        IF bExecute AND NOT (bLeakTestDone OR bLeakTestError) THEN
            // Initialize HMI animation
            GVL_HMI.HMIAnimation.sLoadTextLeakTest  := 'Starting';
            GVL_HMI.HMIAnimation.rLoadBarLeakTest   := 0.0;
            GVL_HMI.HMIAnimation.eIconStateLeakTest := E_IconState.InProgress;

            // Reset timing flags for new run
            bLoadTimeTaken := FALSE;
            tonMonitoring(IN := FALSE);
            tonPressuring(IN := FALSE);

            // Move to first step: valve positioning
            eState := POSITION_VALVES;
        END_IF;


    //=====================================================================
    // POSITION_VALVES
    //  - Move all 6-position valves to position 6 (LeakTest configuration).
    //  - Decide whether we need to seal stages (M1 movement) before pressure.
    //=====================================================================
    POSITION_VALVES:
        // Update HMI text
        GVL_HMI.HMIAnimation.sLoadTextLeakTest := 'Positioning Valves';
        bMoveValves := bExecute; // currently not used directly, but kept for clarity

        // Move all valves to position 6 (LeakTest / Needles)
        IF NOT aValveMoveDone[1] THEN
            aValveMoveDone[1] := GVL_Motion.aValvesObj[1].MoveValve(
                iPosition := 6,
                rVelocity := GVL_Motion.aValves[1].rTargetVel,
                rAcc      := GVL_Motion.aValves[1].rAcceleration,
                rDec      := GVL_Motion.aValves[1].rDeceleration
            );
        END_IF

        IF NOT aValveMoveDone[2] THEN
            aValveMoveDone[2] := GVL_Motion.aValvesObj[2].MoveValve(
                iPosition := 6,
                rVelocity := GVL_Motion.aValves[2].rTargetVel,
                rAcc      := GVL_Motion.aValves[2].rAcceleration,
                rDec      := GVL_Motion.aValves[2].rDeceleration
            );
        END_IF

        IF NOT aValveMoveDone[3] THEN
            aValveMoveDone[3] := GVL_Motion.aValvesObj[3].MoveValve(
                iPosition := 6,
                rVelocity := GVL_Motion.aValves[3].rTargetVel,
                rAcc      := GVL_Motion.aValves[3].rAcceleration,
                rDec      := GVL_Motion.aValves[3].rDeceleration
            );
        END_IF

        IF NOT aValveMoveDone[4] THEN
            aValveMoveDone[4] := GVL_Motion.aValvesObj[4].MoveValve(
                iPosition := 6,
                rVelocity := GVL_Motion.aValves[4].rTargetVel,
                rAcc      := GVL_Motion.aValves[4].rAcceleration,
                rDec      := GVL_Motion.aValves[4].rDeceleration
            );
        END_IF

        IF NOT aValveMoveDone[5] THEN
            aValveMoveDone[5] := GVL_Motion.aValvesObj[5].MoveValve(
                iPosition := 6,
                rVelocity := GVL_Motion.aValves[5].rTargetVel,
                rAcc      := GVL_Motion.aValves[5].rAcceleration,
                rDec      := GVL_Motion.aValves[5].rDeceleration
            );
        END_IF

        // Read status of each valve actuator
        stStatus[1] := GVL_Motion.aValvesObj[1].GetStatus();
        stStatus[2] := GVL_Motion.aValvesObj[2].GetStatus();
        stStatus[3] := GVL_Motion.aValvesObj[3].GetStatus();
        stStatus[4] := GVL_Motion.aValvesObj[4].GetStatus();
        stStatus[5] := GVL_Motion.aValvesObj[5].GetStatus();

        // All valves in position 6 → continue
        IF    aValveMoveDone[1]
           AND aValveMoveDone[2]
           AND aValveMoveDone[3]
           AND aValveMoveDone[4]
           AND aValveMoveDone[5] THEN

            bMoveValves := FALSE;

            // Decide whether we must re-seal stages (M1 position check)
            IF GVL_Motion.M1Motor.rActualPos <= (GVL_Settings.stMachineParam.aM1Position[2] + 0.5) THEN
                // Already at or very close to sealing position, set solenoids
                eState := SET_SOLENOIDS;
            ELSE
                // Need to move M1 through the sealing sequence first
                eState := SEAL_STAGES;
            END_IF

            // Reset valve move flags for next use
            FOR i := 1 TO 5 DO
                aValveMoveDone[i] := FALSE;
            END_FOR
        END_IF

        // If any valve reports an error → leak test error
        IF    stStatus[1].bError
           OR stStatus[2].bError
           OR stStatus[3].bError
           OR stStatus[4].bError
           OR stStatus[5].bError THEN

            bLeakTestError  := TRUE;
            sLTMessageError := 'Failed to position valves';

            eState := ERROR;
        END_IF;


    //=====================================================================
    // SEAL_STAGES
    //  - 2-step motion of M1 to the sealing position:
    //      1) Fast move to an offset near target.
    //      2) Delayed slow move to precise sealing position.
    //=====================================================================
    SEAL_STAGES:
        // Delay between fast and slow movement
        tonM1MoveDelay(IN := bM1MoveStartDelay, PT := T#500MS);

        // Start delay once fast move is triggered
        IF bMoveM1MotorFast THEN
            bM1MoveStartDelay := TRUE;
        END_IF

        // Step 1: fast move close to target (with deceleration offset)
        IF NOT bMoveM1MotorFast THEN
            bMoveM1MotorFast := GVL_Motion.aMotors[1].MoveAbsolute(
                rPosition := GVL_Settings.stMachineParam.aM1Position[2] + GVL_Settings.stMachineParam.fM1PositionDeceleration,
                rVelocity := GVL_Settings.stMachineParam.rM1Velocity,
                rAcc      := GVL_Settings.stMachineParam.rM1Accleration,
                rDec      := GVL_Settings.stMachineParam.rM1Deceleration
            );
        END_IF

        // Step 2: precise slow move to sealing position (after delay)
        IF NOT bMoveM1MotorSlow AND bMoveM1MotorFast AND tonM1MoveDelay.Q THEN
            bMoveM1MotorSlow := GVL_Motion.aMotors[1].MoveAbsolute(
                rPosition := GVL_Settings.stMachineParam.aM1Position[2],
                rVelocity := GVL_Settings.stMachineParam.rM1PrecisionVelocity,
                rAcc      := GVL_Settings.stMachineParam.rM1Accleration,
                rDec      := GVL_Settings.stMachineParam.rM1Deceleration
            );
        END_IF

        // Both steps completed → clear flags and proceed to solenoids
        IF bMoveM1MotorSlow AND bMoveM1MotorFast THEN
            tonM1MoveDelay(IN := FALSE, PT := T#500MS);
            bM1MoveStartDelay := FALSE;

            bMoveM1MotorSlow := FALSE;
            bMoveM1MotorFast := FALSE;

            eState := SET_SOLENOIDS;
        END_IF


    //=====================================================================
    // SET_SOLENOIDS
    //  - Set solenoids to "PressureUp" configuration to start pressurization.
    //=====================================================================
    SET_SOLENOIDS:
        // Request solenoid group to go to "PressureUp" (air in)
        IF GVL_IO.gSetSolenoidControl.PressureUp() THEN
            bPressureTime := TRUE;
            eState        := PRESSURIZE;
        END_IF


    //=====================================================================
    // PRESSURIZE
    //  - Build pressure for tPressureUpTime seconds.
    //=====================================================================
    PRESSURIZE:
        // Update HMI text
        GVL_HMI.HMIAnimation.sLoadTextLeakTest := 'Pressurizing';

        // Run pressurization timer (tPressureUpTime is in seconds)
        tonPressuring(
            IN := bPressureTime,
            PT := UINT_TO_TIME(tPressureUpTime * 1000)
        );

        IF tonPressuring.Q THEN
            // Stop pressure timing and close air path
            bPressureTime := FALSE;
            eState        := CLOSE_AIR;
        END_IF;


    //=====================================================================
    // CLOSE_AIR
    //  - Switch solenoids to "HoldPressure" to create a closed system for
    //    monitoring.
    //=====================================================================
    CLOSE_AIR:
        // Set the solenoids to "HoldPressure" configuration
        IF GVL_IO.gSetSolenoidControl.HoldPressure() THEN
            bPressureTime := TRUE;
            eState        := MONITOR;
        END_IF


    //=====================================================================
    // MONITOR
    //  - Monitor the leak test pressure over the configured time window.
    //  - If pressure stays above threshold until timer expires → DONE.
    //  - If pressure drops below the threshold at any time → ERROR.
    //=====================================================================
    MONITOR:
        // Update HMI text
        GVL_HMI.HMIAnimation.sLoadTextLeakTest := 'Monitoring';

        // Scale raw sensor input to PSI
        //   NOTE: Calibration based on 4–20 mA range:
        //         220 .. 6100 = 0 .. 3.698 V (example) → PSI
        rScaledPressure :=
            (GVL_IO.gAnalogInputs.rLeakTestPressureSensor - 220.0)
            * (3.698 / (6100.0 - 220.0));

        // First pass: capture the allowed leak-test pressure limit
        IF NOT bPressureTaken THEN
            rClosedSystemPressure := GVL_Settings.stLeakTestParameters.rLeakTestPressureLimit;
            bPressureTaken        := TRUE;
            bPressureInput        := TRUE;  // enable monitoring timer
        ELSE
            // Run monitoring timer (tMonitorTime is in seconds)
            tonMonitoring(
                IN := bPressureInput,
                PT := UDINT_TO_TIME(tMonitorTime * 1000)
            );

            // Check pressure criteria
            IF (rScaledPressure >= rClosedSystemPressure) AND tonMonitoring.Q THEN
                // Pressure stayed above limit during full monitoring window
                bPressureTaken := FALSE;
				bLeakTestPassed := TRUE;
                eState         := RELEASE_AIR;

            ELSIF rScaledPressure < rClosedSystemPressure THEN
                // Pressure dropped below limit before timer expired
                bPressureTaken := FALSE;
				bLeakTestPassed := FALSE;
                eState         := RELEASE_AIR;
            END_IF
        END_IF

        // Export pressure for HMI and external monitoring
        GVL_HMI.rCalLeakTestPressure := rScaledPressure;
        rSystemPressure              := rScaledPressure;

		
	 //=====================================================================
    // RELEASE_AIR
    //  - Release the air inside the system.
    //=====================================================================
    RELEASE_AIR:
		// Set the solenoids to "Idle" configuration
        IF GVL_IO.gSetSolenoidControl.Idle() THEN
            IF bLeakTestPassed THEN
				eState        := DONE;
			ELSE
				eState        := ERROR;
			END_IF
        END_IF
		

    //=====================================================================
    // DONE
    //  - Leak test successfully completed and HMI is updated accordingly.
    //  - Wait for bExecute to go FALSE to return to IDLE for next run.
    //=====================================================================
    DONE:
		// HMI final state for successful leak test if on auto cycle state
		IF (GVL_HMI.eMachineMode = E_MachineMode.AUTO_CYCLE) THEN
			GVL_HMI.HMIAnimation.rLoadBarLeakTest   := 100.0;
			GVL_HMI.HMIAnimation.sLoadTextLeakTest  := 'Completed';
			GVL_HMI.HMIAnimation.eIconStateLeakTest := E_IconState.Completed;
		END_IF
        
        bLeakTestDone := TRUE;

        // Wait for start command to be released before going back to IDLE
        IF NOT bExecute THEN
            eState        := IDLE;
            bLeakTestDone := FALSE;
        END_IF


    //=====================================================================
    // ERROR
    //  - Leak test failed or an error occurred.
    //  - bLeakTestError must be checked by caller.
    //  - Wait for bExecute to go FALSE to return to IDLE.
    //=====================================================================
    ERROR:
        bLeakTestError := TRUE;
        // HMI: error is indicated by load bar / text via ACT_LoadingIcon and
        //      external handling of sLTMessageError.

        IF NOT bExecute THEN
            eState        := IDLE;
            bLeakTestDone := FALSE;
        END_IF

END_CASE;]]></ST>
    </Implementation>
    <Action Name="ACT_CalScreenStatus" Id="{de6dfea6-5ac4-4542-abcb-b531fb141ff7}">
      <Implementation>
        <ST><![CDATA[IF GVL_HMI.bCalLeakTestButton THEN
	CASE eState OF
	
		POSITION_VALVES:
			GVL_HMI.sCalLeakTestStatus := 'Idle';
			GVL_HMI.iCalLeakTestState  := 1;
		
		PRESSURIZE:
			GVL_HMI.sCalLeakTestStatus := 'Pressuring up';
			GVL_HMI.iCalLeakTestState  := 1;
		
		MONITOR:
			GVL_HMI.sCalLeakTestStatus := 'Monitoring';
			GVL_HMI.iCalLeakTestState  := 1;
		
		DONE:
			GVL_HMI.sCalLeakTestStatus := 'Passed';
			GVL_HMI.iCalLeakTestState  := 2;
		
		ERROR:
			GVL_HMI.sCalLeakTestStatus := 'Failed';
			GVL_HMI.iCalLeakTestState  := 3;
			
	END_CASE	
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="ACT_LoadingIcon" Id="{962ba985-7ef5-422c-a6af-d14d915a472d}">
      <Implementation>
        <ST><![CDATA[(*
==============================================================================
 ACT_LoadingIcon
------------------------------------------------------------------------------
 Purpose:
   - Compute a rough estimated time for the leak test (pressurize + monitor).
   - Drive the HMI leak-test progress bar (rLoadBarLeakTest) based on a TON.
   - Only active in AUTO_CYCLE mode; otherwise, the bar is reset to 0%.

 Behaviour:
   - When machine mode is AUTO_CYCLE:
       1) On first activation, calculate tLoadingTotalTime:
             (tPressureUpTime + tMonitorTime) seconds + 500 ms margin.
       2) Run tonIconLoading for that total duration.
       3) HMI bar = (ET / TotalTime) * 100.
   - When not in AUTO_CYCLE:
       - Reset timer, flags and bar.
==============================================================================
*)

// Decide if we should animate the icon based on machine mode
IF GVL_HMI.eMachineMode = E_MachineMode.AUTO_CYCLE THEN
    bIconAnimation := TRUE;
ELSE
    bIconAnimation := FALSE;
END_IF

IF bIconAnimation THEN

    // Compute total estimated time only once per leak-test execution
    IF NOT bLoadTimeTaken THEN
        // tPressureUpTime and tMonitorTime in seconds → convert to TIME in ms
        tLoadingTotalTime :=
            UINT_TO_TIME((tPressureUpTime * 1000) + (tMonitorTime * 1000) + 500);
        bLoadTimeTaken := TRUE;
    END_IF

    // Run TON that will be used as base for the HMI bar
    tonIconLoading(
        IN := bIconAnimation,
        PT := tLoadingTotalTime
    );

    // Protect against division by zero
    IF tLoadingTotalTime > T#0MS THEN
        // Progress bar = (ET / TotalTime) * 100
        GVL_HMI.HMIAnimation.rLoadBarLeakTest :=
            (TIME_TO_REAL(tonIconLoading.ET) * 100.0) / TIME_TO_REAL(tLoadingTotalTime);
    ELSE
        GVL_HMI.HMIAnimation.rLoadBarLeakTest := 0.0;
    END_IF

ELSE
    // When animation is disabled (e.g., not in AUTO_CYCLE):
    // - Stop timer
    // - Clear flag so it will be recalculated next time
    // - Reset HMI bar
    tonIconLoading(IN := FALSE);
    bLoadTimeTaken := FALSE;
    GVL_HMI.HMIAnimation.rLoadBarLeakTest := 0.0;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Method Name="Reset" Id="{d191ae56-dc2e-4383-9575-cd2115c094a7}">
      <Declaration><![CDATA[(*
==============================================================================
 Method: Reset
------------------------------------------------------------------------------
 Purpose:
   - Reset FB_LeakTest internal state and HMI outputs so a new leak test
     can start cleanly.
   - This method does NOT automatically restart the test; the caller must
     set bExecute := TRUE again to run a new cycle.

 Behaviour:
   - Clears:
       * Valve flags, pressure flags, timers, internal state (eState).
       * HMI leak-test icon state (set to Waiting).
       * Outputs related to current run (pressure and error text).
   - Returns:
       Reset = TRUE  when the block is ready for a new start
                     (bLeakTestDone = FALSE and bLeakTestError = FALSE).
       Reset = FALSE otherwise.
==============================================================================
*)
METHOD Reset : BOOL
VAR
    i : USINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Reset per-valve movement flags
FOR i := 1 TO 5 DO
    aValveMoveDone[i] := FALSE;
END_FOR

// Reset pressure-related flags and outputs
bPressureInput   := FALSE;
bPressureTime    := FALSE;
bPressureTaken   := FALSE;
bExecuteEvent    := FALSE;
bEventDone       := FALSE;
bLeakTestError   := FALSE;
bLoadTimeTaken   := FALSE;
bLeakTestDone    := FALSE;
rSystemPressure  := 0.0;
sLTMessageError  := '';
rScaledPressure  := 0.0;

// Reset internal state and motion flags
eState             := IDLE;
bMoveValves        := FALSE;
bMoveM1MotorFast   := FALSE;
bMoveM1MotorSlow   := FALSE;
bM1MoveStartDelay  := FALSE;
rClosedSystemPressure := 0.0;

// Reset timers
tonPressuring(IN := FALSE);
tonMonitoring(IN := FALSE);
tonM1MoveDelay(IN := FALSE);
tonIconLoading(IN := FALSE);

tLoadingTotalTime := T#0S;
rTargetPosition   := 1;
bIconAnimation    := FALSE;

// Reset leak test icon to "Waiting" state in HMI
GVL_HMI.HMIAnimation.eIconStateLeakTest := E_IconState.Waiting;

// Return TRUE only if no DONE or ERROR is currently active
IF NOT bLeakTestDone AND NOT bLeakTestError THEN
    Reset := TRUE;
    RETURN;
ELSE
    Reset := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Method>
