<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_SealStages" Id="{b9c49897-ef39-427d-b9c0-f5c61609c2a7}" SpecialFunc="None">
    <Declaration><![CDATA[(*
    FB_SealStages
    ----------------------------------------
    Purpose:
      - Execute the "sealing" movement of Motor M1 to a predefined position.
      - Uses a two-step positioning strategy:
          1) Fast move to a pre-position (with deceleration offset)
          2) Precise move to the final seal position
      - Provides status back to the caller (bSealSuccess / bSealError).
      - Updates HMI animation (text, icon state and progress bar).

    Usage:
      - Call with bExecute = TRUE cyclically while the auto cycle is in
        the sealing step.
      - bSealSuccess becomes TRUE when M1 reaches the target position
        within tolerance.
      - bSealError becomes TRUE if a motion error is detected.
*)

FUNCTION_BLOCK FB_SealStages
VAR_INPUT
    bExecute : BOOL;   // TRUE to start/maintain the sealing sequence
END_VAR

VAR_OUTPUT
    bSealSuccess : BOOL; // TRUE when sealing sequence completes successfully
    bSealError   : BOOL; // TRUE if an error occurs during execution
END_VAR

VAR
    // -----------------------------
    // Execution & positioning
    // -----------------------------
    bExecuting      : BOOL := FALSE; // TRUE after first cycle with bExecute = TRUE
    rActualPosition : LREAL;         // Current position of M1
    rTargetPosition : LREAL;         // Final sealing position for M1
    rTolerance      : LREAL := 0.5;  // Allowed position tolerance for "in position"
    bInPosition     : BOOL := FALSE; // TRUE when |actual - target| <= tolerance

    // Two-step motion sequence flags
    bMoveM1Pos1 : BOOL := FALSE;     // TRUE when pre-position move is completed
    bMoveM1Pos2 : BOOL := FALSE;     // TRUE when final precision move is completed

    bMotionSequenceDone : BOOL := FALSE; // TRUE when both steps are completed

    // Timer and trigger for second move
    bStartMove2  : BOOL := FALSE;    // Internal trigger to start second move
    tonStartMove2: TON;              // Timer between move 1 and move 2

    stStatus : ST_ActuatorStatus;    // Status structure returned by motor wrapper

    // -----------------------------
    // HMI Icon / Progress Bar
    // -----------------------------
    rElapsedTimeSec : REAL := 0.0;   // Elapsed time since FB start (seconds)
    tStartTime      : TIME := T#0S;  // Time when execution started
    bLoadBarUpdate  : BOOL := FALSE; // TRUE while progress bar should be updated
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ==========================================================================
// 1) Read actual position and evaluate "in position"
// ==========================================================================
rActualPosition := GVL_Motion.M1Motor.rActualPos;                     // Read current motor position
rTargetPosition := GVL_Settings.stMachineParam.aM1Position[2];        // Sealing target position (index 2)
bInPosition     := ABS(rActualPosition - rTargetPosition) <= rTolerance;

// ==========================================================================
// 2) HMI: basic sealing animation state
// ==========================================================================
GVL_HMI.HMIAnimation.sLoadTextSealing   := 'Sealing';
GVL_HMI.HMIAnimation.eIconStateSealing := E_IconState.InProgress;

// ==========================================================================
// 3) HMI: Load bar update (only while executing and not yet in position)
//    - Uses an external function EstimateTotalTime() to estimate total
//      sealing time, and scales elapsed time into 0..100%.
// ==========================================================================
IF bExecuting AND NOT bInPosition THEN
    // Elapsed time in seconds since FB start
    rElapsedTimeSec := TIME_TO_REAL(TIME() - tStartTime) / 1000.0;

    // Protect against division by zero or invalid estimate
    IF EstimateTotalTime() > 0.0 THEN
        GVL_HMI.HMIAnimation.rLoadBarSealing :=
            LIMIT(0.0,
                  (rElapsedTimeSec / EstimateTotalTime()) * 100.0,
                  100.0);
    ELSE
        GVL_HMI.HMIAnimation.rLoadBarSealing := 0.0;
    END_IF
END_IF

// ==========================================================================
// 4) Main execution logic: only runs when bExecute = TRUE
// ==========================================================================
IF bExecute THEN

    // -------------------------------------------------------------
    // 4.1) First entry initialization (rising edge of bExecute)
    //      - Reset internal flags and start timing for the load bar
    // -------------------------------------------------------------
    IF NOT bExecuting THEN
        bExecuting      := TRUE;
        bLoadBarUpdate  := TRUE;

        bMoveM1Pos1     := FALSE;
        bMoveM1Pos2     := FALSE;
        bStartMove2     := FALSE;
        bMotionSequenceDone := FALSE;

        tStartTime      := TIME();       // Reference start time
        tonStartMove2(IN := FALSE);      // Reset timer input

        // Reset progress bar only once at the beginning
        GVL_HMI.HMIAnimation.rLoadBarSealing := 0.0;
    END_IF

    // -------------------------------------------------------------
    // 4.2) Execute two-step motion sequence while:
    //      - M1 is not yet in final position, or
    //      - the motion sequence is not finished
    // -------------------------------------------------------------
    IF NOT bInPosition OR NOT bMotionSequenceDone THEN

        // If both moves are completed, flag sequence as done
        IF bMoveM1Pos1 AND bMoveM1Pos2 THEN
            bStartMove2        := FALSE;
            bMotionSequenceDone := TRUE;
        END_IF

        // ---------------------------------------------------------
        // Step 1: Move M1 to a pre-position (with deceleration offset)
        //         This allows a faster approach before the precision step.
        // ---------------------------------------------------------
        IF NOT bMoveM1Pos1 THEN
            bMoveM1Pos1 := GVL_Motion.aMotors[1].MoveAbsolute(
                rPosition := rTargetPosition + GVL_Settings.stMachineParam.fM1PositionDeceleration,
                rVelocity := GVL_Settings.stMachineParam.rM1Velocity,
                rAcc      := GVL_Settings.stMachineParam.rM1Accleration,
                rDec      := GVL_Settings.stMachineParam.rM1Deceleration
            );
        END_IF

        // When step 1 is completed, start the trigger for step 2
        IF bMoveM1Pos1 AND NOT bMoveM1Pos2 THEN
            bStartMove2 := TRUE;
        END_IF

        // Timer between step 1 and step 2 (settling time)
        tonStartMove2(IN := bStartMove2, PT := T#500MS);

        // ---------------------------------------------------------
        // Step 2: Final precise move to the exact target position
        //         - Uses a lower velocity for better accuracy.
        // ---------------------------------------------------------
        IF NOT bMoveM1Pos2 AND tonStartMove2.Q THEN
            bMoveM1Pos2 := GVL_Motion.aMotors[1].MoveAbsolute(
                rPosition := rTargetPosition,
                rVelocity := GVL_Settings.stMachineParam.rM1PrecisionVelocity,
                rAcc      := GVL_Settings.stMachineParam.rM1Accleration,
                rDec      := GVL_Settings.stMachineParam.rM1Deceleration
            );
        END_IF
    END_IF

    // -------------------------------------------------------------
    // 4.3) Read motor status and evaluate error / success
    // -------------------------------------------------------------
    stStatus := GVL_Motion.aMotors[1].GetStatus();

    // --- Error handling ---
    IF stStatus.bError THEN
        bSealError   := TRUE;
        bSealSuccess := FALSE;

    ELSE
        bSealError := FALSE;

        // --- Success condition: M1 is within target tolerance ---
        IF bInPosition THEN
            bSealSuccess  := TRUE;
            bLoadBarUpdate := FALSE;

            // Force progress bar and HMI icon to "Completed"
            GVL_HMI.HMIAnimation.rLoadBarSealing   := 100.0;
            GVL_HMI.HMIAnimation.eIconStateSealing := E_IconState.Completed;
        ELSE
            bSealSuccess := FALSE;
        END_IF
    END_IF

END_IF]]></ST>
    </Implementation>
    <Method Name="EstimateTotalTime" Id="{ac2174a7-358e-4bee-bb09-a75921d7c1bc}">
      <Declaration><![CDATA[METHOD EstimateTotalTime : REAL
VAR
	rDist1      : LREAL;   // Distance for Move 1 (pre-position with deceleration offset)
    rDist2      : LREAL;   // Distance for Move 2 (final precision move)
    rVel1       : LREAL;   // Velocity for Move 1
    rVel2       : LREAL;   // Velocity for Move 2
    rTimeMove1  : REAL;    // Estimated time for Move 1
    rTimeMove2  : REAL;    // Estimated time for Move 2
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Move 1: from actual position → target + decel offset
rDist1 := ABS(
    (GVL_Settings.stMachineParam.aM1Position[2] +
     GVL_Settings.stMachineParam.fM1PositionDeceleration)
    - GVL_Motion.M1Motor.rActualPos
);

// Move 2: from pre-position → final target
rDist2 := ABS(
    GVL_Settings.stMachineParam.aM1Position[2] -
    (GVL_Settings.stMachineParam.aM1Position[2] +
     GVL_Settings.stMachineParam.fM1PositionDeceleration)
);

// ----------------------------------------------------------
// READ VELOCITIES FOR EACH MOVEMENT
// ----------------------------------------------------------
rVel1 := GVL_Settings.stMachineParam.rM1Velocity;           // Fast move
rVel2 := GVL_Settings.stMachineParam.rM1PrecisionVelocity;  // Precision move

// ----------------------------------------------------------
// ESTIMATE DURATIONS (simple distance / velocity)
// ----------------------------------------------------------

// Estimated time for Move 1
IF rVel1 > 0 THEN
    rTimeMove1 := rDist1 / rVel1 * 1.5;
END_IF

// Estimated time for Move 2
IF rVel2 > 0 THEN
    rTimeMove2 := rDist2 / rVel2 * 1.5;
END_IF

// ----------------------------------------------------------
// FINAL CALCULATION
// Total time = Move 1 + 500 ms delay + Move 2
// ----------------------------------------------------------
EstimateTotalTime := rTimeMove1 + 0.5 + rTimeMove2 + 15;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{f9795723-8eae-40ab-a345-51877b5d2bb9}">
      <Declaration><![CDATA[METHOD Reset : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Reset Flags
bSealSuccess	:= FALSE;
bSealError  	:= FALSE;
bInPosition		:= FALSE;
bMotionSequenceDone	:= FALSE;	


bExecuting		:= FALSE;
rActualPosition	:= 0.0;
rTargetPosition := 0.0;
bMoveM1Pos1	 	:= FALSE;
bMoveM1Pos2	 	:= FALSE;
bStartMove2		:= FALSE;
tonStartMove2( IN := FALSE);

rElapsedTimeSec := 0.0;
tStartTime 		:= T#0S;
bLoadBarUpdate 	:= FALSE;

// Send Reset Return
IF NOT bSealSuccess AND NOT bSealError THEN
	Reset := TRUE;
	RETURN;
ELSE
	Reset := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_SealStages">
      <LineId Id="611" Count="131" />
