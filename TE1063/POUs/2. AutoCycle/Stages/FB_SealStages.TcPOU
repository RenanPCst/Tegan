<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_SealStages" Id="{b9c49897-ef39-427d-b9c0-f5c61609c2a7}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_SealStages

VAR_INPUT
    bExecute 		: BOOL;  	//Start the movement
END_VAR

VAR_OUTPUT
	bSealSuccess 	: BOOL; 	//Indicates whether the process was completed successfully
    bSealError 		: BOOL;  	//Indicates whether there was an error during execution
END_VAR

VAR
	bExecuting		: BOOL := FALSE;
	rActualPosition	: LREAL;
	rTargetPosition : LREAL;
	rTolerance      : LREAL := 0.5;
	bInPosition     : BOOL := FALSE;
	
	bMoveM1Pos1	 	: BOOL := FALSE;
	bMoveM1Pos2	 	: BOOL := FALSE;

	bMotionSequenceDone	: BOOL := FALSE;
	
	bStartMove2		: BOOL := FALSE;
	tonStartMove2	: ton;
	stStatus		: ST_ActuatorStatus;
		
	// HMI Icon Progress bar Variables
	rElapsedTimeSec : REAL := 0.0;
	tStartTime 		: TIME := T#0S;
	bLoadBarUpdate 	: BOOL := FALSE;

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//Get the M1 Motor actual position
rActualPosition := GVL_Motion.M1Motor.rActualPos;
rTargetPosition := GVL_Settings.stMachineParam.aM1Position[2];
bInPosition := ABS(rActualPosition - rTargetPosition) <= rTolerance;

//Provide HMI animation details
GVL_HMI.HMIAnimation.sLoadTextHardware := 'Sealing'; 
GVL_HMI.HMIAnimation.eIconStateHardware := E_IconState.InProgress;

// Update progress bar only while executing and not yet in position
IF bExecuting AND NOT bInPosition THEN
    // Elapsed time in seconds since FB start
    rElapsedTimeSec := TIME_TO_REAL(TIME() - tStartTime) / 1000.0; 

    // Protect against division by zero
    IF EstimateTotalTime() > 0.0 THEN
        GVL_HMI.HMIAnimation.rLoadBarHardware :=
            LIMIT(0.0, (rElapsedTimeSec / EstimateTotalTime()) * 100.0, 100.0);
    ELSE
        GVL_HMI.HMIAnimation.rLoadBarHardware := 0.0;
    END_IF
END_IF

IF bExecute THEN

	// Reset flags on first entry
	IF NOT bExecuting THEN
		bExecuting := TRUE;
		bLoadBarUpdate := TRUE;
		bMoveM1Pos1 := FALSE;
		bMoveM1Pos2 := FALSE;
		bStartMove2 := FALSE;
		tStartTime := TIME();
		tonStartMove2(IN := FALSE);
		GVL_HMI.HMIAnimation.rLoadBarHardware := 0.0; // Reset bar only once
	END_IF

	IF NOT bInPosition OR NOT bMotionSequenceDone THEN
		// Movement sequence finished
		IF bMoveM1Pos1 AND bMoveM1Pos2 THEN
			bStartMove2 := FALSE;
			bMotionSequenceDone := TRUE;
		END_IF

		// Step 1: Move to pre-position with deceleration offset
		IF NOT bMoveM1Pos1 THEN
			bMoveM1Pos1 := GVL_Motion.aMotors[1].MoveAbsolute(
				rPosition := rTargetPosition + GVL_Settings.stMachineParam.fM1PositionDeceleration,
				rVelocity := GVL_Settings.stMachineParam.rM1Velocity,
				rAcc := GVL_Settings.stMachineParam.rM1Accleration,
				rDec := GVL_Settings.stMachineParam.rM1Deceleration
			);
		END_IF

		// Trigger move 2 when move 1 is done
		IF bMoveM1Pos1 AND NOT bMoveM1Pos2 THEN
			bStartMove2 := TRUE;
		END_IF

		tonStartMove2(IN := bStartMove2, PT := T#500MS);

		// Step 2: Final precise move to target
		IF NOT bMoveM1Pos2 AND tonStartMove2.Q THEN
			bMoveM1Pos2 := GVL_Motion.aMotors[1].MoveAbsolute(
				rPosition := rTargetPosition,
				rVelocity := GVL_Settings.stMachineParam.rM1PrecisionVelocity,
				rAcc := GVL_Settings.stMachineParam.rM1Accleration,
				rDec := GVL_Settings.stMachineParam.rM1Deceleration
			);
		END_IF
	END_IF

	// Get status and handle errors or success
	stStatus := GVL_Motion.aMotors[1].GetStatus();

	IF stStatus.bError THEN
		bSealError := TRUE;
		bSealSuccess := FALSE;
	ELSE
		bSealError := FALSE;
		IF bInPosition THEN
			bSealSuccess := TRUE;
			bLoadBarUpdate := FALSE;
			GVL_HMI.HMIAnimation.rLoadBarHardware := 100.0;
			GVL_HMI.HMIAnimation.eIconStateHardware := E_IconState.Completed;
		ELSE
			bSealSuccess := FALSE;
		END_IF
	END_IF
END_IF]]></ST>
    </Implementation>
    <Method Name="EstimateTotalTime" Id="{ac2174a7-358e-4bee-bb09-a75921d7c1bc}">
      <Declaration><![CDATA[METHOD EstimateTotalTime : REAL
VAR
	rDist1      : LREAL;   // Distance for Move 1 (pre-position with deceleration offset)
    rDist2      : LREAL;   // Distance for Move 2 (final precision move)
    rVel1       : LREAL;   // Velocity for Move 1
    rVel2       : LREAL;   // Velocity for Move 2
    rTimeMove1  : REAL;    // Estimated time for Move 1
    rTimeMove2  : REAL;    // Estimated time for Move 2
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Move 1: from actual position → target + decel offset
rDist1 := ABS(
    (GVL_Settings.stMachineParam.aM1Position[2] +
     GVL_Settings.stMachineParam.fM1PositionDeceleration)
    - GVL_Motion.M1Motor.rActualPos
);

// Move 2: from pre-position → final target
rDist2 := ABS(
    GVL_Settings.stMachineParam.aM1Position[2] -
    (GVL_Settings.stMachineParam.aM1Position[2] +
     GVL_Settings.stMachineParam.fM1PositionDeceleration)
);

// ----------------------------------------------------------
// READ VELOCITIES FOR EACH MOVEMENT
// ----------------------------------------------------------
rVel1 := GVL_Settings.stMachineParam.rM1Velocity;           // Fast move
rVel2 := GVL_Settings.stMachineParam.rM1PrecisionVelocity;  // Precision move

// ----------------------------------------------------------
// ESTIMATE DURATIONS (simple distance / velocity)
// ----------------------------------------------------------

// Estimated time for Move 1
IF rVel1 > 0 THEN
    rTimeMove1 := rDist1 / rVel1 * 1.5;
END_IF

// Estimated time for Move 2
IF rVel2 > 0 THEN
    rTimeMove2 := rDist2 / rVel2 * 1.5;
END_IF

// ----------------------------------------------------------
// FINAL CALCULATION
// Total time = Move 1 + 500 ms delay + Move 2
// ----------------------------------------------------------
EstimateTotalTime := rTimeMove1 + 0.5 + rTimeMove2;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{f9795723-8eae-40ab-a345-51877b5d2bb9}">
      <Declaration><![CDATA[METHOD Reset : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Reset Flags
bSealSuccess	:= FALSE;
bSealError  	:= FALSE;
bInPosition		:= FALSE;
bMotionSequenceDone	:= FALSE;	


bExecuting		:= FALSE;
rActualPosition	:= 0.0;
rTargetPosition := 0.0;
bMoveM1Pos1	 	:= FALSE;
bMoveM1Pos2	 	:= FALSE;
bStartMove2		:= FALSE;
tonStartMove2( IN := FALSE);

rElapsedTimeSec := 0.0;
tStartTime 		:= T#0S;
bLoadBarUpdate 	:= FALSE;

// Send Reset Return
IF NOT bSealSuccess AND NOT bSealError THEN
	Reset := TRUE;
	RETURN;
ELSE
	Reset := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
