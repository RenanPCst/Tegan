<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_MeteringSolvent1" Id="{ae03a0ea-4cc6-4ba1-bf89-b7c4f161ddcb}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MeteringSolvent1
VAR_INPUT
	bExecute    : BOOL; 	// start (rising-edge)
END_VAR
VAR_OUTPUT
	bBusy       : BOOL;  	// Busy when running
    bDone       : BOOL;		// Done flag
    bError      : BOOL;		// Error flag
	iErrorCode  : DINT; 	// Erro custom code
END_VAR
VAR
	iStepCounter       : INT := 0;
    bMoveValveDone     : ARRAY[1..5] OF BOOL;
    bMovePumpDone      : ARRAY[1..10] OF BOOL;
    fDistance          : ARRAY[1..10] OF REAL;
	bAllMoveDone	   : BOOL := FALSE;
    fbTmrValves        : TON; 	// watchdog valves
    fbTmrPumps         : TON; 	// watchdog pumps
    bExecutePrev       : BOOL;	// Saves the previous state
    i                  : USINT;	//loop for index
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 0) Disparo por borda de subida
IF (bExecute AND NOT bExecutePrev) AND NOT bBusy AND NOT bDone THEN
    bBusy := TRUE;
    bError := FALSE; iErrorCode := 0;
    iStepCounter := 0;

    // Limpa arrays e timers
    FOR i := 1 TO 5 DO bMoveValveDone[i] := FALSE; END_FOR
    FOR i := 1 TO 10 DO bMovePumpDone[i] := FALSE; END_FOR
END_IF
bExecutePrev := bExecute;

// 1) Máquina de estados só roda quando ocupado
IF bBusy THEN
    CASE iStepCounter OF
        0: // Banner HMI
            GVL_HMI.HMIAnimation.sLoadTextRecovery := 'Metering Rinse 1';
            iStepCounter := 1;

        1: // Solenoides em IDLE
            IF GVL_IO.gSetSolenoidControl.Idle() THEN
                // start watchdog de válvulas
                fbTmrValves(IN:=TRUE, PT:=T#10S);
                iStepCounter := 2;
            END_IF

        2: // Setar válvulas p/ solvente 1
            FOR i := 1 TO 5 DO
                IF NOT bMoveValveDone[i] THEN
                    bMoveValveDone[i] := GVL_Motion.aValvesObj[i].MoveValve(
                        iPosition := GVL_Recipe.stActiveRecipe.stSolventsTimes.aSolventN[1],
                        rVelocity := GVL_Motion.aValves[i].rTargetVel,
                        rAcc      := GVL_Motion.aValves[i].rAcceleration,
                        rDec      := GVL_Motion.aValves[i].rDeceleration
                    );
                END_IF
            END_FOR

            IF bMoveValveDone[1] AND bMoveValveDone[2] AND bMoveValveDone[3] AND bMoveValveDone[4] AND bMoveValveDone[5] THEN
                fbTmrValves(IN:=FALSE);
                FOR i := 1 TO 5 DO bMoveValveDone[i] := FALSE; END_FOR
                iStepCounter := 3;
            ELSIF fbTmrValves.Q THEN
                bError := TRUE; iErrorCode := 1001; // timeout válvulas
                iStepCounter := 6;
            END_IF

        3: // Distâncias por bomba
            // ... seus cálculos F_VolumeToSteps + dead volume ...
            fbTmrPumps(IN:=TRUE, PT:=T#30S);
            iStepCounter := 4;

        4: // Movimentos das bombas
            FOR i := 1 TO 10 DO
                IF NOT bMovePumpDone[i] THEN
                    bMovePumpDone[i] := GVL_Motion.aPumpsRotary[i].MoveRelative(
                        Distance := fDistance[i],
                        Velocity := GVL_Settings.stPumpParameters.iMeterVelocity * 6,
                        Acc      := GVL_SETTINGS.stPumpParameters.iMeterVelocity * 6,
                        Dec      := GVL_SETTINGS.stPumpParameters.iMeterVelocity
                    );
                END_IF
            END_FOR
			
			bAllMoveDone := bMovePumpDone[1] AND bMovePumpDone[2] AND bMovePumpDone[3] AND bMovePumpDone[4] AND 
						   bMovePumpDone[5] AND bMovePumpDone[6] AND bMovePumpDone[7] AND bMovePumpDone[8] AND 
						   bMovePumpDone[9] AND bMovePumpDone[10];
			
            IF bAllMoveDone THEN // helper p/ AND dos 10 itens
                fbTmrPumps(IN:=FALSE);
                FOR i := 1 TO 10 DO bMovePumpDone[i] := FALSE; END_FOR
                iStepCounter := 5;
            ELSIF fbTmrPumps.Q THEN
                bError := TRUE; iErrorCode := 1002; // timeout bombas
                iStepCounter := 6;
            END_IF

        5: // Done
            bBusy := FALSE;
            bDone := TRUE;
            // NÃO limpar aqui; espere bExecute cair para limpar bDone
            // iStepCounter pode permanecer 5 até o chamador reconhecer

        6: // Error
            bBusy := FALSE;
            // bError TRUE e iErrorCode já setados
            // Aguarde reset do chamador
    END_CASE
END_IF

// 2) Limpeza quando o chamador derruba bExecute (ack)
IF NOT bExecute AND NOT bBusy THEN
    // Libera done (acknowledged) para um próximo ciclo
    bDone := FALSE;
    // (Opcional) zere iStepCounter := 0;
END_IF]]></ST>
    </Implementation>
    <LineIds Name="FB_MeteringSolvent1">
      <LineId Id="115" Count="63" />
      <LineId Id="209" Count="1" />
      <LineId Id="213" Count="0" />
      <LineId Id="208" Count="0" />
      <LineId Id="179" Count="26" />
      <LineId Id="9" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>