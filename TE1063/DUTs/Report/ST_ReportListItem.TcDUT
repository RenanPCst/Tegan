<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="ST_ReportListItem" Id="{bc666bf2-1d6f-4a04-942d-f24eb76def14}">
    <Declaration><![CDATA[{attribute 'pack_mode' := '1'}
TYPE ST_ReportListItem :
STRUCT
	ReportType  : STRING(50);    // Ex: Pump Calibration, System Settings, Post Run
    ReportID    : STRING(50);    // Ex: CalibrationNo, RunID, Revision
    CreatedOn   : STRING(30);    // Ex: 2026-04-15 10:35
    CreatedBy   : STRING(50);    // Ex: Renan, Admin
    Description : STRING(200);   // Ex: Pump 3 calibration - Solvent 2
	sPrimaryKey : STRING(50);
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>