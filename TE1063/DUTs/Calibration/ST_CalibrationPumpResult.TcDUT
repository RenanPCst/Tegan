<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="ST_CalibrationPumpResult" Id="{4d633f68-968e-4747-a0e5-6701d9428851}">
    <Declaration><![CDATA[TYPE ST_CalibrationPumpResult :
STRUCT
	(* Pump Calibration screen controls feeding from FB_Calibration Manager *)
    rTargetVolume   : LREAL;              	// Target Volume 
    rAvgNetVolume   : LREAL;              	// Average Net Volume (mL)
	rAvgTareWeight	: LREAL;              	// Average Tare Weight (mg)
	rAvgGrossWeight	: LREAL;              	// Average Gross Weight(mg)
	iRevsDone		: UINT;            		// Number of revolutions done
    eStatus         : E_CalibrationStatus; 	// Actual pump calibration state
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>