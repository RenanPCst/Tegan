                "active": true,
                "symbolExpression": "%ctrl%TcHmiNumericInput_Solvent2Density::IsEnabled%/ctrl%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/Boolean",
                  "value": false
                },
                "asyncWait": true
              },
              {
