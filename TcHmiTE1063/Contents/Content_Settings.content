<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_SaveParam_20.onPressed",
    "actions": [
      {
        "objectType": "Condition",
        "active": true,
        "parts": [
          {
            "if": [
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/Boolean",
                  "symbolExpression": "%ctrl%TcHmiTextbox_Solvent1::IsEnabled%/ctrl%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/Boolean",
                  "value": true
                },
                "compareOperator": "==",
                "logic": null
              }
            ],
            "then": [
              {
                "objectType": "JavaScript",
                "active": true,
                "sourceLines": [
                  "(function () {",
                  "    console.log(\"Starting HMI solvent save process...\");",
                  "",
                  "    const writeEx = (sym, val) => new Promise((res, rej) =>",
                  "        TcHmi.Symbol.writeEx(sym, val, d => d.error === TcHmi.Errors.NONE ? res(true) : rej(d.error))",
                  "    );",
                  "",
                  "    const readEx2 = (sym) => new Promise((res, rej) =>",
                  "        TcHmi.Symbol.readEx2(sym, d => d.error === TcHmi.Errors.NONE ? res(d.value) : rej(d.error))",
                  "    );",
                  "",
                  "    function formatDateTimeNow() {",
                  "        const d = new Date();",
                  "",
                  "        const day = String(d.getDate()).padStart(2, '0');",
                  "        const months = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];",
                  "        const month = months[d.getMonth()];",
                  "        const year = d.getFullYear();",
                  "",
                  "        const hours = String(d.getHours()).padStart(2, '0');",
                  "        const minutes = String(d.getMinutes()).padStart(2, '0');",
                  "        const seconds = String(d.getSeconds()).padStart(2, '0');",
                  "",
                  "        return `${day}-${month}-${year} ${hours}:${minutes}:${seconds}`;",
                  "    }",
                  "",
                  "    var fields = [",
                  "        {",
                  "            input: 'TcHmiTextbox_Solvent1',",
                  "            symbol: '%s%PLC1.GVL_HMI.stHMISolventsInfo[0]::sSolventName%/s%',",
                  "            type: 'text'",
                  "        },",
                  "        {",
                  "            input: 'TcHmiTextbox_Solvent2',",
                  "            symbol: '%s%PLC1.GVL_HMI.stHMISolventsInfo[1]::sSolventName%/s%',",
                  "            type: 'text'",
                  "        },",
                  "        {",
                  "            input: 'TcHmiTextbox_Solvent3',",
                  "            symbol: '%s%PLC1.GVL_HMI.stHMISolventsInfo[2]::sSolventName%/s%',",
                  "            type: 'text'",
                  "        },",
                  "        {",
                  "            input: 'TcHmiTextbox_Solvent4',",
                  "            symbol: '%s%PLC1.GVL_HMI.stHMISolventsInfo[3]::sSolventName%/s%',",
                  "            type: 'text'",
                  "        },",
                  "        {",
                  "            input: 'TcHmiNumericInput_Solvent1Density',",
                  "            symbol: '%s%PLC1.GVL_HMI.stHMISolventsInfo[0]::rDensity%/s%',",
                  "            type: 'number'",
                  "        },",
                  "        {",
                  "            input: 'TcHmiNumericInput_Solvent2Density',",
                  "            symbol: '%s%PLC1.GVL_HMI.stHMISolventsInfo[1]::rDensity%/s%',",
                  "            type: 'number'",
                  "        },",
                  "        {",
                  "            input: 'TcHmiNumericInput_Solvent3Density',",
                  "            symbol: '%s%PLC1.GVL_HMI.stHMISolventsInfo[2]::rDensity%/s%',",
                  "            type: 'number'",
                  "        },",
                  "        {",
                  "            input: 'TcHmiNumericInput_Solvent4Density',",
                  "            symbol: '%s%PLC1.GVL_HMI.stHMISolventsInfo[3]::rDensity%/s%',",
                  "            type: 'number'",
                  "        }",
                  "    ];",
                  "",
                  "    let i = 0;",
                  "",
                  "    function getControlValue(ctrl, field) {",
                  "        let val;",
                  "",
                  "        if (field.type === 'text') {",
                  "            if (typeof ctrl.getText === 'function') {",
                  "                val = ctrl.getText();",
                  "            } else if (typeof ctrl.getValue === 'function') {",
                  "                val = ctrl.getValue();",
                  "            } else {",
                  "                val = '';",
                  "            }",
                  "",
                  "            return String(val || '').trim();",
                  "        }",
                  "",
                  "        if (field.type === 'number') {",
                  "            if (typeof ctrl.getValue === 'function') {",
                  "                val = ctrl.getValue();",
                  "            } else if (typeof ctrl.getText === 'function') {",
                  "                val = ctrl.getText();",
                  "            } else {",
                  "                val = 0;",
                  "            }",
                  "",
                  "            val = Number(val);",
                  "",
                  "            if (Number.isNaN(val)) {",
                  "                return 0;",
                  "            }",
                  "",
                  "            return val;",
                  "        }",
                  "",
                  "        return null;",
                  "    }",
                  "",
                  "    function validateFields() {",
                  "        for (let j = 0; j < fields.length; j++) {",
                  "            let field = fields[j];",
                  "            let ctrl = TcHmi.Controls.get(field.input);",
                  "",
                  "            if (!ctrl) {",
                  "                alert(\"Control not found: \" + field.input);",
                  "                console.error(\"Control not found:\", field.input);",
                  "                return false;",
                  "            }",
                  "",
                  "            let val = getControlValue(ctrl, field);",
                  "",
                  "            if (field.type === 'text' && val === '') {",
                  "                alert(\"Please fill in all solvent names before saving.\");",
                  "                console.warn(\"Empty solvent name:\", field.input);",
                  "                return false;",
                  "            }",
                  "",
                  "            if (field.type === 'number' && Number(val) <= 0) {",
                  "                alert(\"Please enter a valid density for all solvents before saving.\");",
                  "                console.warn(\"Invalid density:\", field.input, val);",
                  "                return false;",
                  "            }",
                  "        }",
                  "",
                  "        return true;",
                  "    }",
                  "",
                  "    function writeNext() {",
                  "        if (i >= fields.length) {",
                  "            console.log(\"All solvent values written. Sending trigger...\");",
                  "",
                  "            TcHmi.Symbol.writeEx('%s%PLC1.GVL_HMI.bSaveSolventsBt%/s%', true, function (triggerResult) {",
                  "                if (triggerResult.error !== TcHmi.Errors.NONE) {",
                  "                    alert(\"Error writing trigger bSaveSolventsBt!\");",
                  "                    console.error(\"Trigger write error:\", triggerResult.error);",
                  "                    return;",
                  "                }",
                  "",
                  "                console.log(\"bSaveSolventsBt trigger sent successfully.\");",
                  "",
                  "                let pollCount = 0;",
                  "                const pollInterval = setInterval(async function () {",
                  "                    try {",
                  "                        const done = await readEx2('%s%PLC1.GVL_HMI.bSaveSolventsDone%/s%');",
                  "                        const error = await readEx2('%s%PLC1.GVL_HMI.bSaveSolventsError%/s%');",
                  "",
                  "                        if (done === true) {",
                  "                            clearInterval(pollInterval);",
                  "                            alert(\"Solvents saved successfully!\");",
                  "                            writeEx('%s%PLC1.GVL_HMI.bSaveSolventsDone%/s%', false).catch(() => {});",
                  "                        } else if (error === true) {",
                  "                            clearInterval(pollInterval);",
                  "                            alert(\"Error saving solvents!\");",
                  "                            writeEx('%s%PLC1.GVL_HMI.bSaveSolventsError%/s%', false).catch(() => {});",
                  "                        } else if (++pollCount > 40) {",
                  "                            clearInterval(pollInterval);",
                  "                            alert(\"Timeout: No response from PLC.\");",
                  "                        }",
                  "                    } catch (e) {",
                  "                        clearInterval(pollInterval);",
                  "                        alert(\"Communication error while polling PLC.\");",
                  "                        console.error(e);",
                  "                    }",
                  "                }, 100);",
                  "            });",
                  "",
                  "            return;",
                  "        }",
                  "",
                  "        let field = fields[i++];",
                  "        let ctrl = TcHmi.Controls.get(field.input);",
                  "",
                  "        if (!ctrl) {",
                  "            console.warn(\"Control not found:\", field.input);",
                  "            writeNext();",
                  "            return;",
                  "        }",
                  "",
                  "        let val = getControlValue(ctrl, field);",
                  "",
                  "        console.log(\"Writing solvent field:\", field.input, \"Value:\", val, \"Symbol:\", field.symbol);",
                  "",
                  "        TcHmi.Symbol.writeEx(field.symbol, val, function (res) {",
                  "            if (res.error !== TcHmi.Errors.NONE) {",
                  "                alert(\"Error writing: \" + field.symbol);",
                  "                console.error(\"Write error:\", res.error, \"Symbol:\", field.symbol, \"Input:\", field.input, \"Value:\", val);",
                  "                return;",
                  "            }",
                  "",
                  "            writeNext();",
                  "        });",
                  "    }",
                  "",
                  "    function startProcess() {",
                  "        try {",
                  "            if (!validateFields()) {",
                  "                return;",
                  "            }",
                  "",
                  "            const currentUser = TcHmi.Server.getCurrentUser() || '';",
                  "            const currentDateTime = formatDateTimeNow();",
                  "",
                  "            console.log(\"Current logged user:\", currentUser);",
                  "            console.log(\"Current date/time:\", currentDateTime);",
                  "",
                  "            // Force trigger false before writing the data.",
                  "            // This guarantees a new rising edge when TRUE is written later.",
                  "            TcHmi.Symbol.writeEx('%s%PLC1.GVL_HMI.bSaveSolventsBt%/s%', false, function (resetRes) {",
                  "                if (resetRes.error !== TcHmi.Errors.NONE) {",
                  "                    alert(\"Error resetting bSaveSolventsBt.\");",
                  "                    console.error(\"Trigger reset error:\", resetRes.error);",
                  "                    return;",
                  "                }",
                  "",
                  "                TcHmi.Symbol.writeEx('%s%PLC1.GVL_HMI.sUserNameEventTriggered%/s%', currentUser, function (userRes) {",
                  "                    if (userRes.error !== TcHmi.Errors.NONE) {",
                  "                        alert(\"Error writing username to PLC.\");",
                  "                        console.error(\"Username write error:\", userRes.error, \"Value:\", currentUser);",
                  "                        return;",
                  "                    }",
                  "",
                  "                    TcHmi.Symbol.writeEx('%s%PLC1.GVL_HMI.sDateAndTimeEventTriggered%/s%', currentDateTime, function (dateRes) {",
                  "                        if (dateRes.error !== TcHmi.Errors.NONE) {",
                  "                            alert(\"Error writing date/time to PLC.\");",
                  "                            console.error(\"Date/time write error:\", dateRes.error, \"Value:\", currentDateTime);",
                  "                            return;",
                  "                        }",
                  "",
                  "                        console.log(\"Username and date/time written successfully. Starting solvent writes...\");",
                  "",
                  "                        // Small delay to ensure PLC sees bSaveSolventsBt = FALSE before the final TRUE trigger.",
                  "                        setTimeout(function () {",
                  "                            writeNext();",
                  "                        }, 200);",
                  "                    });",
                  "                });",
                  "            });",
                  "",
                  "        } catch (e) {",
                  "            alert(\"Error starting solvent save process.\");",
                  "            console.error(e);",
                  "        }",
                  "    }",
                  "",
                  "    startProcess();",
                  "})();"
                ],
                "injectContextObject": false,
                "asyncWait": true,
                "waitMode": "Synchronous"
              },
              {
                "objectType": "WriteToSymbol",
                "active": false,
                "symbolExpression": "%s%PLC1.GVL_DB.stSolvents::solventName1%/s%",
                "value": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/String",
                  "symbolExpression": "%ctrl%TcHmiTextbox_Solvent1::Text%/ctrl%"
                },
                "asyncWait": true
              },
              {
                "objectType": "WriteToSymbol",
                "active": false,
                "symbolExpression": "%s%PLC1.GVL_DB.stSolvents::solventName2%/s%",
                "value": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/String",
                  "symbolExpression": "%ctrl%TcHmiTextbox_Solvent2::Text%/ctrl%"
                },
                "asyncWait": true
              },
              {
                "objectType": "WriteToSymbol",
                "active": false,
                "symbolExpression": "%s%PLC1.GVL_DB.stSolvents::solventName3%/s%",
                "value": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/String",
                  "symbolExpression": "%ctrl%TcHmiTextbox_Solvent3::Text%/ctrl%"
                },
                "asyncWait": true
              },
              {
                "objectType": "WriteToSymbol",
                "active": false,
                "symbolExpression": "%s%PLC1.GVL_DB.stSolvents::solventName4%/s%",
                "value": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/String",
                  "symbolExpression": "%ctrl%TcHmiTextbox_Solvent4::Text%/ctrl%"
                },
                "asyncWait": true
              },
              {
                "objectType": "WriteToSymbol",
                "active": false,
                "symbolExpression": "%s%PLC1.GVL_DB.stSolvents::density1%/s%",
                "value": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/String",
                  "symbolExpression": "%ctrl%TcHmiNumericInput_Solvent1Density::Value%/ctrl%"
                },
                "asyncWait": true
              },
              {
                "objectType": "WriteToSymbol",
                "active": false,
                "symbolExpression": "%s%PLC1.GVL_DB.stSolvents::density2%/s%",
                "value": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/String",
                  "symbolExpression": "%ctrl%TcHmiNumericInput_Solvent2Density::Value%/ctrl%"
                },
                "asyncWait": true
              },
              {
                "objectType": "WriteToSymbol",
                "active": false,
                "symbolExpression": "%s%PLC1.GVL_DB.stSolvents::density3%/s%",
                "value": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/String",
                  "symbolExpression": "%ctrl%TcHmiNumericInput_Solvent3Density::Value%/ctrl%"
                },
                "asyncWait": true
              },
              {
                "objectType": "WriteToSymbol",
                "active": false,
                "symbolExpression": "%s%PLC1.GVL_DB.stSolvents::density4%/s%",
                "value": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/String",
                  "symbolExpression": "%ctrl%TcHmiNumericInput_Solvent4Density::Value%/ctrl%"
                },
                "asyncWait": true
              },
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%ctrl%TcHmiNumericInput_Solvent1Density::IsEnabled%/ctrl%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/Boolean",
                  "value": false
                },
                "asyncWait": true
              },
              {
