<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiTextbox_SettingsLastChanged.onAttached",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(function () {",
          "    var ctrl = TcHmi.Controls.get('TcHmiTextbox_SettingsLastChanged');",
          "    var symbol = '%s%PLC1.GVL_Settings.sLastSysSettingsChangedBy%/s%';",
          "",
          "    TcHmi.Symbol.readEx2(symbol, function (data) {",
          "        if (data.error === TcHmi.Errors.NONE && ctrl) {",
          "            ctrl.setText(String(data.value || ''));",
          "        }",
          "    });",
          "})();"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
