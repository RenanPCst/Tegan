[
  {
    "event": "TcHmiNumericInput_SettingsRevNumber.onAttached",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(function () {",
          "    var ctrl = TcHmi.Controls.get('TcHmiNumericInput_SettingsRevNumber');",
          "    var symbol = '%s%PLC1.GVL_Settings.sysRevNumber%/s%';",
          "    TcHmi.Symbol.readEx2(symbol, function (data) {",
          "        if (data.error === TcHmi.Errors.NONE && ctrl) {",
          "            ctrl.setValue(Math.abs(Number(data.value)));",
          "        }",
          "    });",
          "})();"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
