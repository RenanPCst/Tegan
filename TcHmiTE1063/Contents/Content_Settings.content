<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiNumericInput_PumpMeterVelocity.onAttached",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(function () {",
          "    var ctrl = TcHmi.Controls.get('TcHmiNumericInput_PumpMeterVelocity');",
          "    var symbol = '%s%PLC1.GVL_HMI.stHMIPumpParameters::iMeterVelocity%/s%';",
          "    TcHmi.Symbol.readEx2(symbol, function (data) {",
          "        if (data.error === TcHmi.Errors.NONE && ctrl) {",
          "            ctrl.setValue(Math.abs(Number(data.value)));",
          "        }",
          "    });",
          "})();"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
