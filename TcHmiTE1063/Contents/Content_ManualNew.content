<div id="TcHmiButton_M2ManualRunBt" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="40" data-tchmi-height-unit="px" data-tchmi-left="930" data-tchmi-left-unit="px" data-tchmi-text="Run" data-tchmi-top="130" data-tchmi-top-unit="px" data-tchmi-width="100" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="15" data-tchmi-zindex="21">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_M2ManualRunBt.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(function () {",
          "  const H = TcHmi;",
          "  const TOL = 2.0; // ±2 mm window",
          "",
          "  const approx = (a, t, tol = TOL) => (typeof a === 'number' && typeof t === 'number') && Math.abs(a - t) <= tol;",
          "  const fmt = v => (typeof v === 'number') ? v.toFixed(3) : String(v);",
          "  const win = v => `≈ ${fmt(v)} ±${TOL} mm`;",
          "",
          "  // Reads via readEx2 (fallback readEx); writes via legacy writeEx",
          "  const readSym  = (expr, cb) => (H.Symbol.readEx2 ? H.Symbol.readEx2(expr, cb) : H.Symbol.readEx(expr, cb));",
          "  const writeSym = (expr, val, cb) => H.Symbol.writeEx(expr, val, cb);",
          "",
          "  // 1) Get combobox VALUE (1..4): 1=Home, 2=Waste, 3=Fill Vials, 4=Calibration",
          "  const cb = H.Controls.get('TcHmiCombobox_M2Position');",
          "  if (!cb) { alert('M2: combobox not found'); return; }",
          "  const targetVal = cb.getSelectedValue?.();",
          "  if (typeof targetVal !== 'number' || targetVal < 1 || targetVal > 4) {",
          "    alert('M2: invalid selection. Choose 1=Home, 2=Waste, 3=Fill Vials, 4=Calibration.');",
          "    return;",
          "  }",
          "",
          "  // 2) Read M3 actual position (mm)",
          "  readSym('%s%PLC1.GVL_Motion.M3Motor.rActualPos%/s%', function (m3Act) {",
          "    if (m3Act.error !== TcHmi.Errors.NONE) {",
          "      alert('M2 blocked: failed to read M3 actual position. err=' + m3Act.error);",
          "      writeSym('%s%PLC1.GVL_HMI.bM2MoveNotAllowedTrigger%/s%', true, function(){});",
          "      return;",
          "    }",
          "",
          "    // 3) Read base/reference setpoints with new structure:",
          "    // [0]=Home, [1]=VialSet1, [2]=VialSetSpacing, [3]=Calibration",
          "    const paths = [",
          "      '%s%PLC1.GVL_Settings.stMachineParam.aM3Position[0]%/s%', // Home",
          "      '%s%PLC1.GVL_Settings.stMachineParam.aM3Position[1]%/s%', // VialSet1",
          "      '%s%PLC1.GVL_Settings.stMachineParam.aM3Position[2]%/s%', // VialSetSpacing",
          "      '%s%PLC1.GVL_Settings.stMachineParam.aM3Position[3]%/s%'  // Calibration",
          "    ];",
          "",
          "    let refs = new Array(paths.length);",
          "    let pending = paths.length;",
          "",
          "    const finish = () => {",
          "      const m3Home = refs[0];",
          "      const vialSet1 = refs[1];",
          "      const vialSpacing = refs[2];",
          "      const m3Cal = refs[3];",
          "",
          "      let allowed = true;",
          "      let reason = '';",
          "",
          "      // Validate reads needed for each target",
          "      const needOk = (r, label) => (r && r.error === TcHmi.Errors.NONE) ? true : (reason = `M2 blocked: failed to read ${label}. err=${r ? r.error : 'n/a'}`, false);",
          "",
          "      if (targetVal === 2) {",
          "        // Waste → M3 must be at Home",
          "        if (!needOk(m3Home, 'M3 Home')) { allowed = false; }",
          "        else if (!approx(m3Act.value, m3Home.value)) {",
          "          allowed = false;",
          "          reason = `M2→Waste blocked: M3 must be at Home.\\nM3 actual: ${fmt(m3Act.value)} mm | Required: ${win(m3Home.value)}`;",
          "        }",
          "      } else if (targetVal === 3) {",
          "        // Fill Vials → M3 must be at one of the computed Vial Lines (1..4)",
          "        if (!needOk(vialSet1, 'VialSet1') || !needOk(vialSpacing, 'VialSetSpacing')) {",
          "          allowed = false;",
          "        } else {",
          "          const l1 = vialSet1.value;",
          "          const s  = vialSpacing.value;",
          "          const lines = [l1, l1 + s, l1 + 2*s, l1 + 3*s];",
          "          const atAny = lines.some(v => approx(m3Act.value, v));",
          "          if (!atAny) {",
          "            allowed = false;",
          "            const targets = lines.map(v => win(v)).join('  |  ');",
          "            reason = `M2→Fill Vials blocked: M3 must be at a Vial Line (1–4).\\n` +",
          "                     `M3 actual: ${fmt(m3Act.value)} mm\\nAccepted windows: ${targets}`;",
          "          }",
          "        }",
          "      } else if (targetVal === 4) {",
          "        // Calibration → M3 must be at Calibration",
          "        if (!needOk(m3Cal, 'M3 Calibration')) { allowed = false; }",
          "        else if (!approx(m3Act.value, m3Cal.value)) {",
          "          allowed = false;",
          "          reason = `M2→Calibration blocked: M3 must be at Calibration.\\nM3 actual: ${fmt(m3Act.value)} mm | Required: ${win(m3Cal.value)}`;",
          "        }",
          "      }",
          "      // targetVal === 1 (Home) → always allowed",
          "",
          "      if (!allowed) {",
          "        alert(reason || 'Interlock by Position Requested (M2).');",
          "        writeSym('%s%PLC1.GVL_HMI.bM2MoveNotAllowedTrigger%/s%', true, function(){});",
          "        return;",
          "      }",
          "",
          "      // 4) Send command to PLC (M2 slot [1]): iPosition=value(1..4) + bRun=TRUE (PLC resets)",
          "      writeSym('%s%PLC1.GVL_HMI.aManualMotorsCmd[1]::iPosition%/s%', targetVal, function (wPos) {",
          "        if (wPos.error !== TcHmi.Errors.NONE) { alert('M2 error: failed to set iPosition.'); return; }",
          "        writeSym('%s%PLC1.GVL_HMI.aManualMotorsCmd[1]::bRun%/s%', true, function (wRun) {",
          "          if (wRun.error !== TcHmi.Errors.NONE) { alert('M2 error: failed to set bRun=TRUE.'); return; }",
          "        });",
          "      });",
          "    };",
          "",
          "    // Parallel reads",
          "    paths.forEach((p, i) => {",
          "      readSym(p, function (d) {",
          "        refs[i] = d;",
          "        if (--pending === 0) finish();",
          "      });",
          "    });",
          "  });",
          "})();",
          ""
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
<div id="TcHmiButton_M2ManualStopBt" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="40" data-tchmi-height-unit="px" data-tchmi-left="930" data-tchmi-left-unit="px" data-tchmi-text="Stop" data-tchmi-top="177" data-tchmi-top-unit="px" data-tchmi-width="100" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="15" data-tchmi-zindex="22">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_M2ManualStopBt.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(function () {",
          "    // Set bRun false",
          "    TcHmi.Symbol.writeEx('%s%PLC1.GVL_HMI.aManualMotorsCmd[1]::bRun%/s%', false, function (data) {",
          "        if (data.error === TcHmi.Errors.NONE) {",
          "            // set bStop True",
          "            TcHmi.Symbol.writeEx('%s%PLC1.GVL_HMI.aManualMotorsCmd[1]::bStop%/s%', true);",
          "        }",
          "    });",
          "})();"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
<div id="TcHmiButton_M3ManualStopBt" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="40" data-tchmi-height-unit="px" data-tchmi-left="930" data-tchmi-left-unit="px" data-tchmi-text="Stop" data-tchmi-top="322" data-tchmi-top-unit="px" data-tchmi-width="100" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="15" data-tchmi-zindex="23">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_M3ManualStopBt.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(function () {",
          "    // Set bRun false",
          "    TcHmi.Symbol.writeEx('%s%PLC1.GVL_HMI.aManualMotorsCmd[2]::bRun%/s%', false, function (data) {",
          "        if (data.error === TcHmi.Errors.NONE) {",
          "            // set bStop True",
          "            TcHmi.Symbol.writeEx('%s%PLC1.GVL_HMI.aManualMotorsCmd[2]::bStop%/s%', true);",
          "        }",
          "    });",
          "})();"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
<div id="TcHmiButton_M3ManualRunBt" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="40" data-tchmi-height-unit="px" data-tchmi-left="930" data-tchmi-left-unit="px" data-tchmi-text="Run" data-tchmi-top="272" data-tchmi-top-unit="px" data-tchmi-width="100" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="15" data-tchmi-zindex="24">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_M3ManualRunBt.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(function () {",
          "  const H = TcHmi;",
          "  const TOL = 2.0; // ±2 mm tolerance",
          "  const approx = (a, t, tol = TOL) => (typeof a === 'number' && typeof t === 'number') && Math.abs(a - t) <= tol;",
          "  const fmt = v => (typeof v === 'number') ? v.toFixed(3) : String(v);",
          "  const win = v => `≈ ${fmt(v)} ±${TOL} mm`;",
          "",
          "  // Modern readEx2 for reads, legacy writeEx for writes",
          "  const readSym = (expr, cb) => (H.Symbol.readEx2 ? H.Symbol.readEx2(expr, cb) : H.Symbol.readEx(expr, cb));",
          "  const writeSym = (expr, val, cb) => H.Symbol.writeEx(expr, val, cb);",
          "",
          "  // 1) Get combobox selected VALUE (1..6)",
          "  const cb = H.Controls.get('TcHmiCombobox_M3Position');",
          "  if (!cb) { alert('M3: combobox not found'); return; }",
          "",
          "  const targetVal = cb.getSelectedValue?.();",
          "  if (typeof targetVal !== 'number' || targetVal < 1 || targetVal > 6) {",
          "    alert('M3: invalid selection. Choose a value from 1 to 6.');",
          "    return;",
          "  }",
          "",
          "  // 2) Interlock: M2 must be at Home (±2 mm)",
          "  readSym('%s%PLC1.GVL_Motion.M2Motor.rActualPos%/s%', function (m2Act) {",
          "    if (m2Act.error !== TcHmi.Errors.NONE) {",
          "      alert('M3 blocked: failed to read M2 actual position.');",
          "      writeSym('%s%PLC1.GVL_HMI.bM3MoveNotAllowedTrigger%/s%', true, function(){});",
          "      return;",
          "    }",
          "",
          "    readSym('%s%PLC1.GVL_Settings.stMachineParam.aM2Position[0]%/s%', function (m2Home) {",
          "      if (m2Home.error !== TcHmi.Errors.NONE) {",
          "        alert('M3 blocked: failed to read M2 home position.');",
          "        writeSym('%s%PLC1.GVL_HMI.bM3MoveNotAllowedTrigger%/s%', true, function(){});",
          "        return;",
          "      }",
          "",
          "      if (!approx(m2Act.value, m2Home.value)) {",
          "        alert(`M3 blocked: M2 must be at Home.\\nM2 actual: ${fmt(m2Act.value)} mm | Required: ${win(m2Home.value)}`);",
          "        writeSym('%s%PLC1.GVL_HMI.bM3MoveNotAllowedTrigger%/s%', true, function(){});",
          "        return;",
          "      }",
          "",
          "      // 3) Send command: VALUE (1..6) → iPosition [2], then bRun TRUE (PLC resets)",
          "      writeSym('%s%PLC1.GVL_HMI.aManualMotorsCmd[2]::iPosition%/s%', targetVal, function (wPos) {",
          "        if (wPos.error !== TcHmi.Errors.NONE) {",
          "          alert('M3 error: failed to set iPosition.');",
          "          return;",
          "        }",
          "",
          "        // Trigger move (PLC handles reset)",
          "        writeSym('%s%PLC1.GVL_HMI.aManualMotorsCmd[2]::bRun%/s%', true, function (wRun) {",
          "          if (wRun.error !== TcHmi.Errors.NONE) {",
          "            alert('M3 error: failed to set bRun=TRUE.');",
          "            return;",
          "          }",
          "        });",
          "      });",
          "    });",
          "  });",
          "})();"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
<div id="TcHmiButton_MoveValvesBt" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="40" data-tchmi-height-unit="px" data-tchmi-left="930" data-tchmi-left-unit="px" data-tchmi-text="Move Valves" data-tchmi-top="536" data-tchmi-top-unit="px" data-tchmi-width="100" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="15" data-tchmi-zindex="39">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_MoveValvesBt.onPressed",
    "actions": [
      {
        "objectType": "Condition",
        "active": true,
        "parts": [
          {
            "if": [
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/String",
                  "symbolExpression": "%s%PLC1.GVL_Motion.aPumps.0.Rotary.iNotMoving%/s%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "value": true
                },
                "compareOperator": "==",
                "logic": null
              },
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/String",
                  "symbolExpression": "%s%PLC1.GVL_Motion.aPumps.1.Rotary.iNotMoving%/s%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "value": true
                },
                "compareOperator": "==",
                "logic": "AND"
              },
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/String",
                  "symbolExpression": "%s%PLC1.GVL_Motion.aPumps.2.Rotary.iNotMoving%/s%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "value": true
                },
                "compareOperator": "==",
                "logic": "AND"
              },
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/String",
                  "symbolExpression": "%s%PLC1.GVL_Motion.aPumps.3.Rotary.iNotMoving%/s%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "value": true
                },
                "compareOperator": "==",
                "logic": "AND"
              },
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/String",
                  "symbolExpression": "%s%PLC1.GVL_Motion.aPumps.4.Rotary.iNotMoving%/s%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "value": true
                },
                "compareOperator": "==",
                "logic": "AND"
              },
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/String",
                  "symbolExpression": "%s%PLC1.GVL_Motion.aPumps.5.Rotary.iNotMoving%/s%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "value": true
                },
                "compareOperator": "==",
                "logic": "AND"
              },
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/String",
                  "symbolExpression": "%s%PLC1.GVL_Motion.aPumps.6.Rotary.iNotMoving%/s%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "value": true
                },
                "compareOperator": "==",
                "logic": "AND"
              },
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/String",
                  "symbolExpression": "%s%PLC1.GVL_Motion.aPumps.7.Rotary.iNotMoving%/s%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "value": true
                },
                "compareOperator": "==",
                "logic": "AND"
              },
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/String",
                  "symbolExpression": "%s%PLC1.GVL_Motion.aPumps.8.Rotary.iNotMoving%/s%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "value": true
                },
                "compareOperator": "==",
                "logic": "AND"
              },
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/String",
                  "symbolExpression": "%s%PLC1.GVL_Motion.aPumps.9.Rotary.iNotMoving%/s%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "value": true
                },
                "compareOperator": "==",
                "logic": "AND"
              }
            ],
            "then": [
              {
                "objectType": "JavaScript",
                "active": true,
                "sourceLines": [
                  "console.log(\"Button 'MoveValves' pressed.\");",
                  "",
                  "let allValid = true;",
                  "let valveValues = [];",
                  "",
                  "// Loop through all 5 valve controls",
                  "for (let i = 1; i <= 5; i++) {",
                  "    const combo = TcHmi.Controls.get(`TcHmiCombobox_Valve${i}Position`);",
                  "",
                  "    if (!combo) {",
                  "        console.warn(`Valve ${i} combobox not found.`);",
                  "        allValid = false;",
                  "        break;",
                  "    }",
                  "",
                  "    const selectedValue = combo.getSelectedValue();",
                  "    console.log(`Valve ${i} selected value: ${selectedValue}`);",
                  "",
                  "    if (selectedValue === null || selectedValue === undefined || selectedValue <= 0) {",
                  "        allValid = false;",
                  "        break;",
                  "    }",
                  "",
                  "    valveValues.push(selectedValue);",
                  "}",
                  "",
                  "// Validation failed",
                  "if (!allValid) {",
                  "    alert(\"Please select a valid position for all 5 valves before proceeding.\");",
                  "} else {",
                  "    console.log(\"Validation OK. Writing values to PLC...\");",
                  "",
                  "    for (let i = 0; i < 5; i++) {",
                  "        console.log(`→ Valve ${i + 1} write: pos=${valveValues[i]}`);",
                  "        TcHmi.Symbol.writeEx(`%s%PLC1.GVL_HMI.aManualValvesCmd[${i}]::iTargetPos%/s%`, valveValues[i]);",
                  "        TcHmi.Symbol.writeEx(`%s%PLC1.GVL_HMI.aManualValvesCmd[${i}]::bMove%/s%`, true);",
                  "    }",
                  "}"
                ],
                "injectContextObject": false,
                "asyncWait": true,
                "waitMode": "Synchronous"
              }
            ]
          },
          {
            "else": [
              {
                "objectType": "JavaScript",
                "active": true,
                "sourceLines": [
                  "alert(\"Valve movement is not allowed while pumps are running!\");"
                ],
                "injectContextObject": false,
                "asyncWait": true,
                "waitMode": "Synchronous"
              }
            ]
          }
        ],
        "asyncWait": true
      }
    ]
  }
]
</script>
</div>
<div id="TcHmiButton_StopValvesBt" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="40" data-tchmi-height-unit="px" data-tchmi-left="930" data-tchmi-left-unit="px" data-tchmi-text="Stop Valves" data-tchmi-top="598" data-tchmi-top-unit="px" data-tchmi-width="100" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="15" data-tchmi-zindex="40">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_StopValvesBt.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(function () {",
          "    for (let i = 0; i <= 4; i++) {",
          "        TcHmi.Symbol.writeEx('%s%PLC1.GVL_HMI.aManualValvesCmd[' + i + ']::bStop%/s%', true);",
          "    }",
          "})();"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
