<div id="TcHmiButton_M1ManualRunBt" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="40" data-tchmi-height-unit="px" data-tchmi-left="30" data-tchmi-left-unit="px" data-tchmi-text="Run" data-tchmi-top="365" data-tchmi-top-unit="px" data-tchmi-width="100" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="15" data-tchmi-zindex="16">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_M1ManualRunBt.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(function () {",
          "  const H = TcHmi;",
          "",
          "  // Prefer modern readEx2 for reads; keep legacy writeEx for writes (stable on your runtime)",
          "  const readSym  = (expr, cb) => (H.Symbol.readEx2 ? H.Symbol.readEx2(expr, cb) : H.Symbol.readEx(expr, cb));",
          "  const writeSym = (expr, val, cb) => H.Symbol.writeEx(expr, val, cb);",
          "",
          "  // 1) Get combobox VALUE (expected 1..3: 1=Home, 2=Seal Stages, 3=Air Dry)",
          "  const cb = H.Controls.get('TcHmiCombobox_M1Position');",
          "  if (!cb) { alert('M1: combobox not found'); return; }",
          "",
          "  const targetVal = cb.getSelectedValue?.();",
          "  if (typeof targetVal !== 'number' || targetVal < 1 || targetVal > 3) {",
          "    alert('M1: invalid selection. Choose 1=Home, 2=Seal Stages, 3=Air Dry.');",
          "    return;",
          "  }",
          "",
          "  // 2) Interlock: if selecting Seal Stages (2) or Air Dry (3), Throat Jig must be present (TRUE)",
          "  const needsJig = (targetVal === 2 || targetVal === 3);",
          "",
          "  if (needsJig) {",
          "    readSym('%s%PLC1.GVL_IO.gDigInputs.bThroatJigPresent%/s%', function (dig) {",
          "      if (dig.error !== TcHmi.Errors.NONE) {",
          "        alert('M1 blocked: failed to read Throat Jig presence input.');",
          "        writeSym('%s%PLC1.GVL_HMI.bM1MoveNotAllowedTrigger%/s%', true, function () { });",
          "        return;",
          "      }",
          "      if (!dig.value) {",
          "        alert('M1 move blocked: Throat Jig not present. Required for Seal Stages / Air Dry.');",
          "        writeSym('%s%PLC1.GVL_HMI.bM1MoveNotAllowedTrigger%/s%', true, function () { });",
          "        return;",
          "      }",
          "      // Interlock satisfied → send command",
          "      writeSym('%s%PLC1.GVL_HMI.aManualMotorsCmd[0]::iPosition%/s%', targetVal, function (wPos) {",
          "        if (wPos.error !== TcHmi.Errors.NONE) { alert('M1 error: failed to set iPosition.'); return; }",
          "        writeSym('%s%PLC1.GVL_HMI.aManualMotorsCmd[0]::bRun%/s%', true, function (wRun) {",
          "          if (wRun.error !== TcHmi.Errors.NONE) { alert('M1 error: failed to set bRun=TRUE.'); return; }",
          "          // PLC will reset bRun",
          "        });",
          "      });",
          "    });",
          "  } else {",
          "    // Home (1) → always allowed, send command directly",
          "    writeSym('%s%PLC1.GVL_HMI.aManualMotorsCmd[0]::iPosition%/s%', targetVal, function (wPos) {",
          "      if (wPos.error !== TcHmi.Errors.NONE) { alert('M1 error: failed to set iPosition.'); return; }",
          "      writeSym('%s%PLC1.GVL_HMI.aManualMotorsCmd[0]::bRun%/s%', true, function (wRun) {",
          "        if (wRun.error !== TcHmi.Errors.NONE) { alert('M1 error: failed to set bRun=TRUE.'); return; }",
          "        // PLC will reset bRun",
          "      });",
          "    });",
          "  }",
          "})();",
          ""
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
<div id="TcHmiButton_M1ManualStopBt" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="40" data-tchmi-height-unit="px" data-tchmi-left="209" data-tchmi-left-unit="px" data-tchmi-text="Stop" data-tchmi-top="365" data-tchmi-top-unit="px" data-tchmi-width="100" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="15" data-tchmi-zindex="17">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_M1ManualStopBt.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(function () {",
          "    // Set bRun false",
          "    TcHmi.Symbol.writeEx('%s%PLC1.GVL_HMI.aManualMotorsCmd[0]::bRun%/s%', false, function (data) {",
          "        if (data.error === TcHmi.Errors.NONE) {",
          "            // set bStop True",
          "            TcHmi.Symbol.writeEx('%s%PLC1.GVL_HMI.aManualMotorsCmd[0]::bStop%/s%', true);",
          "        }",
          "    });",
          "})();"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
<div id="TcHmiTextblock_111" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-height="20" data-tchmi-height-unit="px" data-tchmi-left="30" data-tchmi-left-unit="px" data-tchmi-text="Actual Position" data-tchmi-top="288" data-tchmi-top-unit="px" data-tchmi-width="159" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="16" data-tchmi-text-horizontal-alignment="Center" data-tchmi-text-vertical-alignment="Center" data-tchmi-text-font-weight="Auto" data-tchmi-zindex="18">
