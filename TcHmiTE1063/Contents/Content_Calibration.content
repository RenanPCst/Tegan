<div id="TcHmiButton_5" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="60" data-tchmi-height-unit="px" data-tchmi-left="54" data-tchmi-left-unit="px" data-tchmi-text="Run Automatic Test" data-tchmi-top="72" data-tchmi-top-unit="px" data-tchmi-width="250" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="16" data-tchmi-zindex="1" data-tchmi-text-font-weight="Bold">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_5.onPressed",
    "actions": [
      {
        "objectType": "Condition",
        "active": true,
        "parts": [
          {
            "if": [
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "symbolExpression": "%s%PLC1.GVL_HMI.bCalPressureUpSystemBt%/s%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "value": false
                },
                "compareOperator": "==",
                "logic": null
              },
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/String",
                  "symbolExpression": "%s%PLC1.GVL_HMI.bCalHoldSysPressureBt%/s%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "value": false
                },
                "compareOperator": "==",
                "logic": "AND"
              },
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/String",
                  "symbolExpression": "%s%PLC1.GVL_HMI.bCalStopLeakTestBt%/s%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "value": false
                },
                "compareOperator": "==",
                "logic": "AND"
              }
            ],
            "then": [
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%s%PLC1.GVL_HMI.bCalLeakTestButton%/s%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "value": true
                },
                "asyncWait": true
              }
            ]
          },
          {
            "else": []
          }
        ],
        "asyncWait": true
      }
    ]
  }
]
</script>
</div>
<div id="TcHmiButton_6" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="60" data-tchmi-height-unit="px" data-tchmi-left="54" data-tchmi-left-unit="px" data-tchmi-text="Pressurize System" data-tchmi-top="160" data-tchmi-top-unit="px" data-tchmi-width="250" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="16" data-tchmi-zindex="1" data-tchmi-text-font-weight="Bold">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_6.onPressed",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": false,
        "symbolExpression": "%s%PLC1.GVL_HMI.bCalPressureUpSystemBt%/s%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/BOOL",
          "value": true
        },
        "asyncWait": true
      },
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "// =========================",
          "// Pressurize System Button",
          "// =========================",
          "",
          "const SEAL_POS_TOLERANCE = 2.0; // Position reading tolerance",
          "",
          "(async () => {",
          "    try {",
          "        const readSymbol = (symbol) => new Promise((resolve, reject) => {",
          "            TcHmi.Symbol.readEx2(symbol, (data) => {",
          "                if (data.error === TcHmi.Enums.ErrorCode.OK) resolve(data.value);",
          "                else reject(data);",
          "            });",
          "        });",
          "",
          "        const writeSymbol = (symbol, value) => new Promise((resolve, reject) => {",
          "            TcHmi.Symbol.writeEx(symbol, value, (data) => {",
          "                if (data.error === TcHmi.Enums.ErrorCode.OK) resolve(true);",
          "                else reject(data);",
          "            });",
          "        });",
          "",
          "        const [m1ActualPos, m1SealPos] = await Promise.all([",
          "            readSymbol('%s%PLC1.GVL_Motion.M1Motor::rActualPos%/s%'),",
          "            readSymbol('%s%PLC1.GVL_Settings.stMachineParam.aM1Position[1]%/s%')",
          "        ]);",
          "",
          "        const delta = Math.abs(Number(m1ActualPos) - Number(m1SealPos));",
          "",
          "        if (delta > SEAL_POS_TOLERANCE) {",
          "            alert('M1 não está em Seal Position. Mova o eixo para SEAL e tente novamente.');",
          "            return;",
          "        }",
          "",
          "        await writeSymbol('%s%PLC1.GVL_HMI.bCalPressureUpSystemBt%/s%', true);",
          "        console.log('✅ Pressurize System liberado e flag enviada ao PLC.');",
          "    } catch (err) {",
          "        console.error('Erro ao executar Pressurize System:', err);",
          "        alert('Erro ao comunicar com o PLC.');",
          "    }",
          "})();",
          ""
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
<div id="TcHmiButton_7" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="60" data-tchmi-height-unit="px" data-tchmi-left="54" data-tchmi-left-unit="px" data-tchmi-text="Hold System Pressure" data-tchmi-top="254" data-tchmi-top-unit="px" data-tchmi-width="250" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="16" data-tchmi-zindex="1" data-tchmi-text-font-weight="Bold">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_7.onPressed",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": false,
        "symbolExpression": "%s%PLC1.GVL_HMI.bCalHoldSysPressureBt%/s%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/BOOL",
          "value": true
        },
        "asyncWait": true
      },
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "// =========================",
          "// Hold System Pressure Button",
          "// =========================",
          "",
          "const MIN_PRESSURE_THRESHOLD = 0.1; // Minimum value needed to accept having a pressure",
          "",
          "(async () => {",
          "    try {",
          "        const readSymbol = (symbol) => new Promise((resolve, reject) => {",
          "            TcHmi.Symbol.readEx2(symbol, (data) => {",
          "                if (data.error === TcHmi.Enums.ErrorCode.OK) resolve(data.value);",
          "                else reject(data);",
          "            });",
          "        });",
          "",
          "        const writeSymbol = (symbol, value) => new Promise((resolve, reject) => {",
          "            TcHmi.Symbol.writeEx(symbol, value, (data) => {",
          "                if (data.error === TcHmi.Enums.ErrorCode.OK) resolve(true);",
          "                else reject(data);",
          "            });",
          "        });",
          "",
          "        const pressure = await readSymbol('%s%PLC1.GVL_HMI.rCalLeakTestPressure%/s%');",
          "",
          "        if (Number(pressure) <= MIN_PRESSURE_THRESHOLD) {",
          "            alert('Não há pressão no sistema. Pressurize antes de segurar a pressão.');",
          "            return;",
          "        }",
          "",
          "        await writeSymbol('%s%PLC1.GVL_HMI.bCalHoldSysPressureBt%/s%', true);",
          "        console.log('✅ Hold System Pressure liberado e flag enviada ao PLC.');",
          "    } catch (err) {",
          "        console.error('Erro ao executar Hold System Pressure:', err);",
          "        alert('Erro ao comunicar com o PLC.');",
          "    }",
          "})();",
          ""
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
