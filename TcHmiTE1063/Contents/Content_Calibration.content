<div id="Content_Calibration" data-tchmi-type="TcHmi.Controls.System.TcHmiContent" data-tchmi-top="0" data-tchmi-left="0" data-tchmi-width="1080" data-tchmi-height="1360" data-tchmi-zindex="1">
<div id="TcHmiButton_CalStart" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="70" data-tchmi-height-unit="px" data-tchmi-left="905" data-tchmi-left-unit="px" data-tchmi-text="Start Calibration" data-tchmi-top="1279" data-tchmi-top-unit="px" data-tchmi-width="150" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="18" data-tchmi-text-font-weight="Bold" data-tchmi-zindex="1">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_CalStart.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(function () {",
          "    // 1. Calibration Box Validation",
          "    TcHmi.Symbol.readEx2('%s%PLC1.GVL_IO.gDigInputs.bCalibrationBoxPresent%/s%', function (data) {",
          "        if (data.error !== TcHmi.Errors.NONE || !data.value) {",
          "            alert('Calibration reservoir is not detected. Please check its position.');",
          "            return;",
          "        }",
          "",
          "        // 5. Delay Validation",
          "        const cbDelay = TcHmi.Controls.get('TcHmiCheckbox_DelayStart');",
          "        const delayInput = TcHmi.Controls.get('TcHmiNumericInput_DelayTimeMin');",
          "        const delayState = cbDelay?.getToggleState?.();",
          "        const delayEnabled = (delayState === 'Active');",
          "        const delayValue = delayInput?.getValue?.() ?? 0;",
          "",
          "        if (delayEnabled && delayValue === 0) {",
          "            alert('Delay time must be greater than zero if delay is enabled.');",
          "            return;",
          "        }",
          "",
          "        // 5. Pumps Validation",
          "        let atLeastOneSelected = false;",
          "        let hasZeroVolume = false;",
          "",
          "        for (let i = 0; i < 10; i++) {",
          "            const checkbox = TcHmi.Controls.get('TcHmiCheckbox_CalEnabledPump' + (i + 1));",
          "            const input = TcHmi.Controls.get('TcHmiNumericInput_TargetVolumePump' + (i + 1));",
          "",
          "            const isSelected = checkbox?.getToggleState?.() === 'Active';",
          "            const volume = input?.getValue?.() ?? 0;",
          "",
          "            if (isSelected) {",
          "                atLeastOneSelected = true;",
          "                if (volume === 0) {",
          "                    hasZeroVolume = true;",
          "                }",
          "            }",
          "        }",
          "",
          "        if (!atLeastOneSelected) {",
          "            alert('Select at least one pump.');",
          "            return;",
          "        }",
          "",
          "        if (hasZeroVolume) {",
          "            alert('One or more selected pumps have target volume = 0.');",
          "            return;",
          "        }",
          "",
          "        // 6. Write pump settings",
          "        for (let i = 0; i < 10; i++) {",
          "            const checkbox = TcHmi.Controls.get('TcHmiCheckbox_CalEnabledPump' + (i + 1));",
          "            const input = TcHmi.Controls.get('TcHmiNumericInput_TargetVolumePump' + (i + 1));",
          "",
          "            const isChecked = checkbox?.getToggleState?.() === 'Active';",
          "            const volume = input?.getValue?.() ?? 0;",
          "",
          "            TcHmi.Symbol.writeEx('%s%PLC1.GVL_HMI.aCalibPumps[' + i + ']::bSelected%/s%', isChecked);",
          "            TcHmi.Symbol.writeEx('%s%PLC1.GVL_HMI.aCalibPumps[' + i + ']::rTargetVolume%/s%', volume); ",
          "        }",
          "",
          "        // 7. Write global calibration settings",
          "        TcHmi.Symbol.writeEx('%s%PLC1.GVL_HMI.stHMICalibParameters::bDelayStart%/s%', delayEnabled);",
          "",
          "        if (delayEnabled) {",
          "            TcHmi.Symbol.writeEx('%s%PLC1.GVL_HMI.stHMICalibParameters::iDelayTimeMin%/s%', delayValue);",
          "        }",
          "",
          "        // 8. Start calibration flag",
          "        TcHmi.Symbol.writeEx('%s%PLC1.GVL_HMI.bStartCalibrationBt%/s%', true);",
          "    });",
          "})();"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
<div id="TcHmiButton_CalAbort" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="70" data-tchmi-height-unit="px" data-tchmi-left="723" data-tchmi-left-unit="px" data-tchmi-text="Abort Calibration" data-tchmi-top="1279" data-tchmi-top-unit="px" data-tchmi-width="150" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="18" data-tchmi-text-font-weight="Bold" data-tchmi-zindex="1">

