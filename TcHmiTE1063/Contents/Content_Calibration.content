<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "btnDownloadPDF_14.onStateChanged",
    "actions": [
      {
        "objectType": "Condition",
        "active": false,
        "parts": [
          {
            "if": [
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:framework#/definitions/TcHmi.Controls.Beckhoff.TcHmiCheckbox.StateSymbol",
                  "symbolExpression": "%ctrl%TcHmiCheckbox_PrintWhenComplete::StateSymbol%/ctrl%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:framework#/definitions/TcHmi.Controls.Beckhoff.TcHmiCheckbox.StateSymbol",
                  "value": "true"
                },
                "compareOperator": "==",
                "logic": null
              }
            ],
            "then": []
          },
          {
            "else": []
          }
        ],
        "asyncWait": true
      },
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "// Call the PDF generator function",
          "          function showMessageFromPLC(message) {",
          "          \t\talert(\"Mensagem do PLC: \" + message);",
          "          }",
          "          // Wrinting the PLC variable",
          "          TcHmi.Symbol.readEx2('%s%PLC1.GVL_DB.astData_PCR%/s%', function (data1) {",
          "              if (data1.error === TcHmi.Errors.NONE) {",
          "                        TcHmi.Symbol.readEx2('%s%PLC1.GVL_DB.stParameter_PCR%/s%', function (data2) {",
          "              \t\t\tif (data2.error === TcHmi.Errors.NONE) {",
          "                        let sysHeadArray = data2.value;",
          "                  \t\tlet sysDataArray = data1.value; // value from PLC (array)",
          "                  \t\t// Function Call",
          "                 \t\t genPumpCalibrationReport(sysDataArray, sysHeadArray, 'Pump Calibration Report');                  ",
          "              \t\t} else {",
          "                 \t\t console.error(\"Erro ao ler variável do PLC: \", data2.error);",
          "              \t\t}",
          "          \t\t});                  ",
          "              } else {",
          "                  console.error(\"Erro ao ler variável do PLC: \", data1.error);",
          "              }",
          "          });"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
