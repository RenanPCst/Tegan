<div id="TcHmiButton_14" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="50" data-tchmi-height-unit="px" data-tchmi-left="54" data-tchmi-left-unit="px" data-tchmi-text="Move Valves" data-tchmi-top="652" data-tchmi-top-unit="px" data-tchmi-width="120" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="16" data-tchmi-zindex="1" data-tchmi-text-font-weight="Bold">
<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_14.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(function () {",
          "  const H = TcHmi;",
          "",
          "  // Use legacy writeEx for your runtime",
          "  const writeSym = (expr, val, cb) => H.Symbol.writeEx(expr, val, cb);",
          "",
          "  // 1) Get combobox and its VALUE (expected 1..6)",
          "  const cb = H.Controls.get('TcHmiCombobox_AllValvesPosition');",
          "  if (!cb) { alert('Valves: combobox not found.'); return; }",
          "",
          "  const val = cb.getSelectedValue?.();",
          "  if (val === undefined || val === null || typeof val !== 'number') {",
          "    alert('Please select a valve position first.');",
          "    return;",
          "  }",
          "  if (val < 1 || val > 6) {",
          "    alert('Invalid selection. Choose a position from 1 to 6.');",
          "    return;",
          "  }",
          "",
          "  // 2) Write target position (USINT 1..6)",
          "  writeSym('%s%PLC1.GVL_HMI.iCalMoveValvesPosition%/s%', val, function (wPos) {",
          "    if (wPos.error !== TcHmi.Errors.NONE) {",
          "      alert('Failed to set valve position.');",
          "      return;",
          "    }",
          "",
          "    // 3) Trigger move flag (PLC will handle/reset as needed)",
          "    writeSym('%s%PLC1.GVL_HMI.bCalMoveValves%/s%', true, function (wRun) {",
          "      if (wRun.error !== TcHmi.Errors.NONE) {",
          "        alert('Failed to trigger valve move.');",
          "        return;",
          "      }",
          "    });",
          "  });",
          "})();",
          ""
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
