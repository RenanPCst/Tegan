</div>
<div id="TcHmiTextblock_1037" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-height="21" data-tchmi-height-unit="px" data-tchmi-left="484" data-tchmi-left-unit="px" data-tchmi-text="Valve 4" data-tchmi-top="577" data-tchmi-top-unit="px" data-tchmi-width="82" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-vertical-alignment="Center" data-tchmi-text-horizontal-alignment="Center" data-tchmi-text-font-size="16" data-tchmi-text-font-weight="Bold" data-tchmi-zindex="1">
</div>
<div id="TcHmiTextblock_1038" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-height="21" data-tchmi-height-unit="px" data-tchmi-left="576" data-tchmi-left-unit="px" data-tchmi-text="Valve 5" data-tchmi-top="577" data-tchmi-top-unit="px" data-tchmi-width="82" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-vertical-alignment="Center" data-tchmi-text-horizontal-alignment="Center" data-tchmi-text-font-size="16" data-tchmi-text-font-weight="Bold" data-tchmi-zindex="1">
</div>
<div id="TcHmiButton_15" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="50" data-tchmi-height-unit="px" data-tchmi-left="913" data-tchmi-left-unit="px" data-tchmi-text="Move Motor" data-tchmi-top="652" data-tchmi-top-unit="px" data-tchmi-width="120" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="16" data-tchmi-zindex="1" data-tchmi-text-font-weight="Bold">
<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_15.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(function () {",
          "  const H = TcHmi;",
          "",
          "  // Prefer readEx2 for reads; keep legacy writeEx for writes (stable)",
          "  const readSym  = (expr, cb) => (H.Symbol.readEx2 ? H.Symbol.readEx2(expr, cb) : H.Symbol.readEx(expr, cb));",
          "  const writeSym = (expr, val, cb) => H.Symbol.writeEx(expr, val, cb);",
          "",
          "  // 1) Get combobox VALUE (expected 1..3: 1=Home, 2=Seal Stages, 3=Air Dry)",
          "  const cb = H.Controls.get('TcHmiCombobox_CalM1Position');",
          "  if (!cb) { alert('M1 (Cal): combobox not found.'); return; }",
          "",
          "  const targetVal = cb.getSelectedValue?.();",
          "  if (typeof targetVal !== 'number') { alert('Please select a position first.'); return; }",
          "  if (targetVal < 1 || targetVal > 3) { alert('Invalid selection. Choose 1..3.'); return; }",
          "",
          "  // 2) Interlock: for Seal Stages (2) or Air Dry (3), Throat Jig must be present (TRUE)",
          "  const needsJig = (targetVal === 2 || targetVal === 3);",
          "",
          "  const proceedCommand = () => {",
          "    // 3) Send command to PLC: position + trigger (PLC will reset the trigger)",
          "    writeSym('%s%PLC1.GVL_HMI.iCalMoveM1MotorPosition%/s%', targetVal, function (wPos) {",
          "      if (wPos.error !== TcHmi.Errors.NONE) { alert('M1 (Cal) error: failed to set position.'); return; }",
          "      writeSym('%s%PLC1.GVL_HMI.bCalMoveM1Motor%/s%', true, function (wTrig) {",
          "        if (wTrig.error !== TcHmi.Errors.NONE) { alert('M1 (Cal) error: failed to trigger move.'); return; }",
          "        // Note: PLC logic should reset bCalMoveM1Motor.",
          "      });",
          "    });",
          "  };",
          "",
          "  if (needsJig) {",
          "    readSym('%s%PLC1.GVL_IO.gDigInputs.bThroatJigPresent%/s%', function (dig) {",
          "      if (dig.error !== TcHmi.Errors.NONE) {",
          "        alert('M1 (Cal) blocked: failed to read Throat Jig presence.');",
          "        writeSym('%s%PLC1.GVL_HMI.bM1MoveNotAllowedTrigger%/s%', true, function(){});",
          "        return;",
          "      }",
          "      if (!dig.value) {",
          "        alert('M1 (Cal) move blocked: Throat Jig not present. Required for Seal Stages / Air Dry.');",
          "        writeSym('%s%PLC1.GVL_HMI.bM1MoveNotAllowedTrigger%/s%', true, function(){});",
          "        return;",
          "      }",
          "      // Interlock satisfied",
          "      proceedCommand();",
          "    });",
          "  } else {",
          "    // Home (1) → always allowed",
          "    proceedCommand();",
          "  }",
          "})();",
          ""
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
<div id="TcHmiTextblock_1039" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-height="26" data-tchmi-height-unit="px" data-tchmi-left="901" data-tchmi-left-unit="px" data-tchmi-text="Stage Collection" data-tchmi-top="565" data-tchmi-top-unit="px" data-tchmi-width="141" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-vertical-alignment="Center" data-tchmi-text-horizontal-alignment="Center" data-tchmi-text-font-size="16" data-tchmi-text-font-weight="Bold" data-tchmi-zindex="1">
