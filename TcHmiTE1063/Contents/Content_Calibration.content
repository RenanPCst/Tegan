<div id="TcHmiButton_LeakTestBt" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="60" data-tchmi-height-unit="px" data-tchmi-left="54" data-tchmi-left-unit="px" data-tchmi-text="Run Automatic Test" data-tchmi-top="67" data-tchmi-top-unit="px" data-tchmi-width="250" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="16" data-tchmi-zindex="62" data-tchmi-text-font-weight="Bold">



<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_LeakTestBt.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(function () {",
          "",
          "    const SYM_ACTUAL_POS = \"%s%PLC1.GVL_Motion.M1Motor.rActualPos%/s%\";",
          "    const SYM_SEAL_POS   = \"%s%PLC1.GVL_Settings.stMachineParam.aM1Position[1]%/s%\"; // HMI index 0..2 se aplicável",
          "    const SYM_TRIGGER    = \"%s%PLC1.GVL_HMI.bCalLeakTestButton%/s%\";",
          "",
          "    const TOL_MM = 1.0;",
          "",
          "    // Read helper (readEx2)",
          "    function readSymbol(sym, cbOk, cbErr) {",
          "        TcHmi.Symbol.readEx2(sym, function (data) {",
          "            if (data.error === TcHmi.Errors.NONE) cbOk(data.value);",
          "            else cbErr(data.error);",
          "        });",
          "    }",
          "",
          "    // Write helper (writeEx)  <-- padrão do teu projeto",
          "    function writeSymbol(sym, value, cbOk, cbErr) {",
          "        TcHmi.Symbol.writeEx(sym, value, function (data) {",
          "            if (data.error === TcHmi.Errors.NONE) cbOk();",
          "            else cbErr(data.error);",
          "        });",
          "    }",
          "",
          "    // fluxo (sem async/await pra evitar incompatibilidade do runtime/handler)",
          "    readSymbol(SYM_ACTUAL_POS, function (actualPos) {",
          "",
          "        readSymbol(SYM_SEAL_POS, function (sealPos) {",
          "",
          "            // garante number",
          "            actualPos = Number(actualPos);",
          "            sealPos   = Number(sealPos);",
          "",
          "            if (isNaN(actualPos) || isNaN(sealPos)) {",
          "                alert(\"LeakTest: invalid position values (NaN).\");",
          "                return;",
          "            }",
          "",
          "            if (Math.abs(actualPos - sealPos) > TOL_MM) {",
          "                alert(\"Stage Collection Motor needs to be on seal position!\");",
          "                return;",
          "            }",
          "",
          "            writeSymbol(SYM_TRIGGER, true, function () {",
          "                // opcional: feedback",
          "                // alert(\"LeakTest request sent to PLC\");",
          "            }, function (err) {",
          "                alert(\"LeakTest: write error: \" + err);",
          "            });",
          "",
          "        }, function (err) {",
          "            alert(\"LeakTest: read sealPos error: \" + err);",
          "        });",
          "",
          "    }, function (err) {",
          "        alert(\"LeakTest: read actualPos error: \" + err);",
          "    });",
          "",
          "})();"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
<div id="TcHmiButton_6" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="60" data-tchmi-height-unit="px" data-tchmi-left="54" data-tchmi-left-unit="px" data-tchmi-text="Pressurize System" data-tchmi-top="152" data-tchmi-top-unit="px" data-tchmi-width="250" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="16" data-tchmi-zindex="63" data-tchmi-text-font-weight="Bold">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_6.onPressed",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": false,
        "symbolExpression": "%s%PLC1.GVL_HMI.bCalPressureUpSystemBt%/s%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/BOOL",
          "value": true
        },
        "asyncWait": true
      },
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "// =========================",
          "// Botão: Pressurize System",
          "// =========================",
          "const SEAL_POS_TOLERANCE = 0.5; // ajuste conforme sua unidade",
          "",
          "(async () => {",
          "    const isOk = (data) => data && (data.error === TcHmi.Errors.NONE || data.error === 0);",
          "",
          "    const readSymbol = (symbol) => new Promise((resolve, reject) => {",
          "        TcHmi.Symbol.readEx2(symbol, (data) => {",
          "            if (isOk(data)) resolve(data.value);",
          "            else reject(data);",
          "        });",
          "    });",
          "",
          "    const writeSymbol = (symbol, value) => new Promise((resolve, reject) => {",
          "        TcHmi.Symbol.writeEx(symbol, value, (data) => {",
          "            if (isOk(data)) resolve(true);",
          "            else reject(data);",
          "        });",
          "    });",
          "",
          "    try {",
          "        const m1ActualPos = Number(await readSymbol('%s%PLC1.GVL_Motion.M1Motor.rActualPos%/s%'));",
          "        const m1SealPos   = Number(await readSymbol('%s%PLC1.GVL_Settings.stMachineParam.aM1Position[1]%/s%'));",
          "        const delta       = Math.abs(m1ActualPos - m1SealPos);",
          "",
          "        console.log(`[Pressurize] actual=${m1ActualPos}, seal=${m1SealPos}, delta=${delta}`);",
          "",
          "        if (delta > SEAL_POS_TOLERANCE) {",
          "            alert('M1 is not in Seal Position. Move the axis to SEAL and try again.');",
          "            return;",
          "        }",
          "",
          "        // Pulso TRUE -> FALSE para borda no PLC",
          "        await writeSymbol('%s%PLC1.GVL_HMI.bCalPressureUpSystemBt%/s%', true);",
          "        setTimeout(() => {",
          "            TcHmi.Symbol.writeEx('%s%PLC1.GVL_HMI.bCalPressureUpSystemBt%/s%', false, () => {});",
          "        }, 80);",
          "",
          "        console.log('Pressurize: pulse sent (TRUE → FALSE).');",
          "    } catch (err) {",
          "        console.error('Error running Pressurize System:', err);",
          "        alert('Error communicating with the PLC (Pressurize). Check the symbols and the connection.');",
          "    }",
          "})();"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
<div id="TcHmiButton_7" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="60" data-tchmi-height-unit="px" data-tchmi-left="54" data-tchmi-left-unit="px" data-tchmi-text="Hold System Pressure" data-tchmi-top="237" data-tchmi-top-unit="px" data-tchmi-width="250" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="16" data-tchmi-zindex="64" data-tchmi-text-font-weight="Bold">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_7.onPressed",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": false,
        "symbolExpression": "%s%PLC1.GVL_HMI.bCalHoldSysPressureBt%/s%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/BOOL",
          "value": true
        },
        "asyncWait": true
      },
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "// =========================",
          "// Hold System Pressure Button",
          "// =========================",
          "const MIN_PRESSURE_THRESHOLD = 0.1; // 0.1 tolerance (psi/kPa)",
          "",
          "(async () => {",
          "    const isOk = (data) => data && (data.error === TcHmi.Errors.NONE || data.error === 0);",
          "",
          "    const readSymbol = (symbol) => new Promise((resolve, reject) => {",
          "        TcHmi.Symbol.readEx2(symbol, (data) => {",
          "            if (isOk(data)) resolve(data.value);",
          "            else reject(data);",
          "        });",
          "    });",
          "",
          "    const writeSymbol = (symbol, value) => new Promise((resolve, reject) => {",
          "        TcHmi.Symbol.writeEx(symbol, value, (data) => {",
          "            if (isOk(data)) resolve(true);",
          "            else reject(data);",
          "        });",
          "    });",
          "",
          "    try {",
          "        const pressure = Number(await readSymbol('%s%PLC1.GVL_HMI.rCalLeakTestPressure%/s%'));",
          "        console.log(`[Hold] pressure=${pressure}`);",
          "",
          "        if (pressure <= MIN_PRESSURE_THRESHOLD) {",
          "            alert('There is no pressure in the system. Pressurize before holding the pressure.');",
          "            return;",
          "        }",
          "",
          "        await writeSymbol('%s%PLC1.GVL_HMI.bCalHoldSysPressureBt%/s%', true);",
          "        setTimeout(() => {",
          "            TcHmi.Symbol.writeEx('%s%PLC1.GVL_HMI.bCalHoldSysPressureBt%/s%', false, () => {});",
          "        }, 80);",
          "",
          "        console.log('Hold: pulse Sent (TRUE → FALSE).');",
          "    } catch (err) {",
          "        console.error('Error executing Hold System Pressure:', err);",
          "        alert('Error communicating with the PLC (Hold). Check the symbols and the connection.');",
          "    }",
          "})();",
          ""
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
<div id="TcHmiButton_8" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="60" data-tchmi-height-unit="px" data-tchmi-left="54" data-tchmi-left-unit="px" data-tchmi-text="Stop" data-tchmi-top="323" data-tchmi-top-unit="px" data-tchmi-width="250" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="16" data-tchmi-zindex="65" data-tchmi-text-font-weight="Bold">

