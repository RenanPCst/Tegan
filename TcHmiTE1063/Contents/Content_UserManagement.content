<div id="TcHmiButton_DeleteUser" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="60" data-tchmi-height-unit="px" data-tchmi-left="827" data-tchmi-left-unit="px" data-tchmi-text="Delete User" data-tchmi-top="738" data-tchmi-top-unit="px" data-tchmi-width="140" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="18" data-tchmi-zindex="4">


<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_DeleteUser.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(function () {",
          "",
          "    const SYSTEM_USERS = [",
          "        '__SystemAdministrator',",
          "        '__SystemGuest'",
          "    ];",
          "",
          "    function isSystemUser(userName) {",
          "        return SYSTEM_USERS.includes(userName);",
          "    }",
          "",
          "    function removeUserAsync(userName) {",
          "        return new Promise(function (resolve, reject) {",
          "            TcHmi.Server.UserManagement.removeUserEx(",
          "                userName,",
          "                null,",
          "                { timeout: 2000 },",
          "                function (data) {",
          "                    if (data.error === TcHmi.Errors.NONE) {",
          "                        resolve(true);",
          "                    } else {",
          "                        reject(data.error);",
          "                    }",
          "                }",
          "            );",
          "        });",
          "    }",
          "",
          "    function clearEditArea() {",
          "        const txtUser = TcHmi.Controls.get('TcHmiTextbox_EditCurrentUserName');",
          "        const cmbGroup = TcHmi.Controls.get('TcHmiCombobox_EditCurrentUserGroup');",
          "        const numTimeout = TcHmi.Controls.get('TcHmiNumericInput_EditCurrentTimeOut');",
          "        const showText = TcHmi.Controls.get('TcHmiTextblock_UserDetails');",
          "",
          "        if (txtUser) {",
          "            txtUser.setText('');",
          "        }",
          "",
          "        if (cmbGroup && typeof cmbGroup.setSelectedIndex === 'function') {",
          "            cmbGroup.setSelectedIndex(-1);",
          "        }",
          "",
          "        if (numTimeout && typeof numTimeout.setValue === 'function') {",
          "            numTimeout.setValue(0);",
          "        }",
          "",
          "        if (showText) {",
          "            showText.setText('');",
          "        }",
          "    }",
          "",
          "    async function deleteUser() {",
          "        try {",
          "            const txtUser = TcHmi.Controls.get('TcHmiTextbox_EditCurrentUserName');",
          "",
          "            if (!txtUser) {",
          "                alert('User textbox not found.');",
          "                return;",
          "            }",
          "",
          "            const userName = txtUser.getText();",
          "",
          "            if (!userName) {",
          "                alert('Please select a user first.');",
          "                return;",
          "            }",
          "",
          "            if (isSystemUser(userName)) {",
          "                alert('System users cannot be deleted.');",
          "                return;",
          "            }",
          "",
          "            const confirmed = confirm(",
          "                'Are you sure you want to delete user \"' + userName + '\"?'",
          "            );",
          "",
          "            if (!confirmed) {",
          "                return;",
          "            }",
          "",
          "            await removeUserAsync(userName);",
          "",
          "            alert('User deleted successfully.');",
          "",
          "            clearEditArea();",
          "",
          "            // Reload User DataGrid immediately",
          "            if (typeof window.UserManagement_LoadUsers === 'function') {",
          "                window.UserManagement_LoadUsers();",
          "            } else {",
          "                console.warn('window.UserManagement_LoadUsers is not available.');",
          "            }",
          "",
          "        } catch (error) {",
          "            console.error('Error deleting user:', error);",
          "            alert('Error deleting user. Please check HMI permissions and server logs.');",
          "        }",
          "    }",
          "",
          "    deleteUser();",
          "",
          "})();"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>

