<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiDatagrid_UserLists.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(function () {",
          "",
          "    const SYSTEM_GROUPS = [",
          "        '__SystemAdministrators',",
          "        '__SystemUsers',",
          "        '__SystemGuests'",
          "    ];",
          "",
          "    const SYSTEM_USERS = [",
          "        '__SystemAdministrator',",
          "        '__SystemGuest'",
          "    ];",
          "",
          "    // Controls",
          "    const grid = TcHmi.Controls.get('TcHmiDatagrid_UserLists');",
          "    const showText = TcHmi.Controls.get('TcHmiTextblock_UserDetails');",
          "    const txtEditUser = TcHmi.Controls.get('TcHmiTextbox_EditCurrentUserName');",
          "    const cmbEditGroup = TcHmi.Controls.get('TcHmiCombobox_EditCurrentUserGroup');",
          "    const numEditTimeout = TcHmi.Controls.get('TcHmiNumericInput_EditCurrentTimeOut');",
          "",
          "    if (!grid) {",
          "        console.error('TcHmiDatagrid_UserLists not found.');",
          "        return;",
          "    }",
          "",
          "    if (!showText) {",
          "        console.error('TcHmiTextblock_UserDetails not found.');",
          "        return;",
          "    }",
          "",
          "    function isSystemUser(username) {",
          "        return SYSTEM_USERS.includes(username);",
          "    }",
          "",
          "    function isSystemGroup(groupName) {",
          "        return SYSTEM_GROUPS.includes(groupName);",
          "    }",
          "",
          "    function isoDurationToMinutes(duration) {",
          "\t    if (duration === null || duration === undefined) {",
          "\t        return 0;",
          "\t    }",
          "\t",
          "\t    const value = String(duration).trim().toUpperCase();",
          "\t",
          "\t    console.log('Raw autoLogout value:', duration);",
          "\t    console.log('Normalized autoLogout value:', value);",
          "\t",
          "\t    if (value === '') {",
          "\t        return 0;",
          "\t    }",
          "\t",
          "\t    // Format examples:",
          "\t    // P30D",
          "\t    // P1D",
          "\t    if (value.startsWith('P') && !value.startsWith('PT')) {",
          "\t        let days = 0;",
          "\t        let buffer = '';",
          "\t",
          "\t        for (let i = 1; i < value.length; i++) {",
          "\t            const char = value[i];",
          "\t",
          "\t            if (char >= '0' && char <= '9') {",
          "\t                buffer += char;",
          "\t            } else {",
          "\t                const number = parseInt(buffer, 10);",
          "\t",
          "\t                if (!isNaN(number)) {",
          "\t                    if (char === 'D') {",
          "\t                        days = number;",
          "\t                    }",
          "\t                }",
          "\t",
          "\t                buffer = '';",
          "\t            }",
          "\t        }",
          "\t",
          "\t        return days * 24 * 60;",
          "\t    }",
          "\t",
          "\t    // Format examples:",
          "\t    // PT8H",
          "\t    // PT30M",
          "\t    // PT1H30M",
          "\t    // PT1H0M0S",
          "\t    // PT0S",
          "\t    if (value.startsWith('PT')) {",
          "\t",
          "\t        let hours = 0;",
          "\t        let minutes = 0;",
          "\t        let seconds = 0;",
          "\t",
          "\t        let buffer = '';",
          "\t",
          "\t        for (let i = 2; i < value.length; i++) {",
          "\t            const char = value[i];",
          "\t",
          "\t            if (char >= '0' && char <= '9') {",
          "\t                buffer += char;",
          "\t            } else {",
          "\t                const number = parseInt(buffer, 10);",
          "\t",
          "\t                if (!isNaN(number)) {",
          "\t                    if (char === 'H') {",
          "\t                        hours = number;",
          "\t                    } else if (char === 'M') {",
          "\t                        minutes = number;",
          "\t                    } else if (char === 'S') {",
          "\t                        seconds = number;",
          "\t                    }",
          "\t                }",
          "\t",
          "\t                buffer = '';",
          "\t            }",
          "\t        }",
          "\t",
          "\t        return (hours * 60) + minutes + Math.ceil(seconds / 60);",
          "\t    }",
          "\t",
          "\t    // Fallback: 01:00:00",
          "\t    if (value.indexOf(':') >= 0) {",
          "\t        const parts = value.split(':');",
          "\t",
          "\t        if (parts.length === 3) {",
          "\t            const hours = parseInt(parts[0], 10) || 0;",
          "\t            const minutes = parseInt(parts[1], 10) || 0;",
          "\t            const seconds = parseInt(parts[2], 10) || 0;",
          "\t",
          "\t            return (hours * 60) + minutes + Math.ceil(seconds / 60);",
          "\t        }",
          "\t    }",
          "\t",
          "\t    // Fallback: plain number, assume minutes",
          "\t    if (!isNaN(Number(value))) {",
          "\t        return parseInt(value, 10);",
          "\t    }",
          "\t",
          "\t    console.warn('Unsupported autoLogout format:', duration);",
          "\t    return 0;",
          "\t}",
          "    ",
          "\tfunction formatAutoLogout(duration) {",
          "\t    const totalMinutes = isoDurationToMinutes(duration);",
          "\t",
          "\t    if (totalMinutes <= 0) {",
          "\t        return '0min';",
          "\t    }",
          "\t",
          "\t    const days = Math.floor(totalMinutes / 1440);",
          "\t    const remainingAfterDays = totalMinutes % 1440;",
          "\t",
          "\t    const hours = Math.floor(remainingAfterDays / 60);",
          "\t    const minutes = remainingAfterDays % 60;",
          "\t",
          "\t    let parts = [];",
          "\t",
          "\t    if (days > 0) {",
          "\t        parts.push(days + 'd');",
          "\t    }",
          "\t",
          "\t    if (hours > 0) {",
          "\t        parts.push(hours + 'h');",
          "\t    }",
          "\t",
          "\t    if (minutes > 0) {",
          "\t        parts.push(minutes + 'min');",
          "\t    }",
          "\t",
          "\t    return parts.join(' ');",
          "\t}",
          "",
          "    function getSelectedUsername() {",
          "        const selectedIndex = grid.getSelectedRowIndex();",
          "        const gridData = grid.getSrcData();",
          "",
          "        if (selectedIndex === null || selectedIndex < 0 || !gridData || selectedIndex >= gridData.length) {",
          "            return null;",
          "        }",
          "",
          "        const selectedRow = gridData[selectedIndex];",
          "",
          "        if (!selectedRow || !selectedRow['Username']) {",
          "            return null;",
          "        }",
          "",
          "        return selectedRow['Username'];",
          "    }",
          "",
          "    function getVisibleGroups(userDetails) {",
          "        if (!userDetails || !Array.isArray(userDetails.groups)) {",
          "            return [];",
          "        }",
          "",
          "        return userDetails.groups.filter(function (group) {",
          "            return !isSystemGroup(group);",
          "        });",
          "    }",
          "",
          "    function getMainUserGroup(userDetails) {",
          "        const visibleGroups = getVisibleGroups(userDetails);",
          "",
          "        if (visibleGroups.length > 0) {",
          "            return visibleGroups[0];",
          "        }",
          "",
          "        return '';",
          "    }",
          "",
          "    function setComboboxValue(combo, value) {",
          "        if (!combo || !value) {",
          "            return;",
          "        }",
          "",
          "        // Preferred method if available",
          "        if (typeof combo.setSelectedValue === 'function') {",
          "            combo.setSelectedValue(value);",
          "            return;",
          "        }",
          "",
          "        // Fallback using SrcData",
          "        const comboData = combo.getSrcData ? combo.getSrcData() : null;",
          "",
          "        if (!comboData || !Array.isArray(comboData)) {",
          "            console.warn('Combobox SrcData not available.');",
          "            return;",
          "        }",
          "",
          "        const index = comboData.findIndex(function (item) {",
          "            return item === value ||",
          "                item.value === value ||",
          "                item.text === value ||",
          "                item.Groupname === value ||",
          "                item.GroupName === value ||",
          "                item.groupName === value;",
          "        });",
          "",
          "        if (index >= 0 && typeof combo.setSelectedIndex === 'function') {",
          "            combo.setSelectedIndex(index);",
          "        } else {",
          "            console.warn('Group not found in combobox:', value);",
          "        }",
          "    }",
          "",
          "    function clearEditArea() {",
          "        if (txtEditUser) {",
          "            txtEditUser.setText('');",
          "        }",
          "",
          "        if (cmbEditGroup && typeof cmbEditGroup.setSelectedIndex === 'function') {",
          "            cmbEditGroup.setSelectedIndex(-1);",
          "        }",
          "",
          "        if (numEditTimeout && typeof numEditTimeout.setValue === 'function') {",
          "            numEditTimeout.setValue(0);",
          "        }",
          "    }",
          "",
          "    const nome = getSelectedUsername();",
          "",
          "    if (!nome) {",
          "        console.warn('No row selected or invalid data.');",
          "        showText.setText('No user selected.');",
          "        clearEditArea();",
          "        return;",
          "    }",
          "",
          "    console.log('Nome selecionado:', nome);",
          "",
          "    if (isSystemUser(nome)) {",
          "        showText.setText(",
          "            'System user selected:\\n' +",
          "            nome +",
          "            '\\n\\nThis user cannot be edited or deleted from this screen.'",
          "        );",
          "",
          "        clearEditArea();",
          "        return;",
          "    }",
          "",
          "    // Show selected username while full details are loading",
          "    showText.setText(nome);",
          "",
          "    TcHmi.Server.UserManagement.listUsersEx(",
          "        null,",
          "        { timeout: 2000 },",
          "        function (data) {",
          "",
          "            if (data.error === TcHmi.Errors.NONE) {",
          "",
          "                const allUsers = data.userDetails;",
          "",
          "                if (allUsers.hasOwnProperty(nome)) {",
          "",
          "                    const userDetails = allUsers[nome];",
          "                    console.log('User details:', userDetails);",
          "",
          "                    const visibleGroups = getVisibleGroups(userDetails);",
          "                    const mainGroup = getMainUserGroup(userDetails);",
          "",
          "                    const groupsText = visibleGroups.length > 0",
          "                        ? visibleGroups.join(',\\n')",
          "                        : 'No application group assigned';",
          "",
          "                    // Populate edit username textbox",
          "                    if (txtEditUser) {",
          "                        txtEditUser.setText(nome);",
          "                    }",
          "",
          "                    // Populate edit group combobox",
          "                    if (cmbEditGroup && mainGroup) {",
          "                        setComboboxValue(cmbEditGroup, mainGroup);",
          "                    } else if (cmbEditGroup && typeof cmbEditGroup.setSelectedIndex === 'function') {",
          "                        cmbEditGroup.setSelectedIndex(-1);",
          "                    }",
          "",
          "                    // Populate edit timeout numeric input in minutes",
          "                    if (numEditTimeout && typeof numEditTimeout.setValue === 'function') {",
          "                        numEditTimeout.setValue(isoDurationToMinutes(userDetails.autoLogout));",
          "                    }",
          "",
          "                    // User details text",
          "                    const formattedText =",
          "                        'User: ' + nome + '\\n\\n' +",
          "                        'Active: ' + (userDetails.enabled ? 'Yes' : 'No') + '\\n\\n' +",
          "                        'Automatic Logout: ' + formatAutoLogout(userDetails.autoLogout) + '\\n\\n' +",
          "                        'Groups:\\n ' + groupsText;",
          "",
          "                    showText.setText(formattedText);",
          "",
          "                } else {",
          "                    console.log('User not found:', nome);",
          "                    showText.setText('User not found:\\n' + nome);",
          "                    clearEditArea();",
          "                }",
          "",
          "            } else {",
          "                console.error('Error listing users:', data.error);",
          "                showText.setText('Error loading user details.');",
          "                clearEditArea();",
          "            }",
          "        }",
          "    );",
          "",
          "})();"
        ],
        "injectContextObject": true,
        "asyncWait": true,
        "waitMode": "Asynchronous"
      }
    ]
  }
]
</script>



<script data-tchmi-target-attribute="data-tchmi-header-background-color" type="application/json">
{
  "color": "rgba(25, 63, 98, 1)"
}
</script>
