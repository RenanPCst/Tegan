<div id="TcHmiButton_NewUserAdd" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="60" data-tchmi-height-unit="px" data-tchmi-left="104" data-tchmi-left-unit="px" data-tchmi-text="Add User" data-tchmi-top="738" data-tchmi-top-unit="px" data-tchmi-width="140" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="18" data-tchmi-zindex="4">


<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_NewUserAdd.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(function () {",
          "",
          "    function minutesToIsoDuration(totalMinutes) {",
          "        totalMinutes = parseInt(totalMinutes, 10);",
          "",
          "        if (isNaN(totalMinutes) || totalMinutes < 0) {",
          "            totalMinutes = 0;",
          "        }",
          "",
          "        const days = Math.floor(totalMinutes / 1440);",
          "        const remainingAfterDays = totalMinutes % 1440;",
          "",
          "        const hours = Math.floor(remainingAfterDays / 60);",
          "        const minutes = remainingAfterDays % 60;",
          "",
          "        if (days > 0 && hours === 0 && minutes === 0) {",
          "            return 'P' + days + 'D';",
          "        }",
          "",
          "        if (days > 0) {",
          "            const totalHours = Math.floor(totalMinutes / 60);",
          "            const remainingMinutes = totalMinutes % 60;",
          "",
          "            let resultWithDays = 'PT' + totalHours + 'H';",
          "",
          "            if (remainingMinutes > 0) {",
          "                resultWithDays += remainingMinutes + 'M';",
          "            }",
          "",
          "            return resultWithDays;",
          "        }",
          "",
          "        let result = 'PT';",
          "",
          "        if (hours > 0) {",
          "            result += hours + 'H';",
          "        }",
          "",
          "        if (minutes > 0) {",
          "            result += minutes + 'M';",
          "        }",
          "",
          "        if (hours === 0 && minutes === 0) {",
          "            result += '0S';",
          "        }",
          "",
          "        return result;",
          "    }",
          "",
          "    function clearNewUserFields() {",
          "        const txtNewUser = TcHmi.Controls.get('TcHmiTextbox_NewUserName');",
          "        const cmbNewGroup = TcHmi.Controls.get('TcHmiCombobox_NewUserGroup');",
          "        const numNewTimeout = TcHmi.Controls.get('TcHmiNumericInput_NewUserTimeOut2');",
          "        const pwdNewUser = TcHmi.Controls.get('TcHmiPasswordInput_NewUserPasswdUpdate');",
          "",
          "        if (txtNewUser) {",
          "            txtNewUser.setText('');",
          "        }",
          "",
          "        if (cmbNewGroup && typeof cmbNewGroup.setSelectedIndex === 'function') {",
          "            cmbNewGroup.setSelectedIndex(-1);",
          "        }",
          "",
          "        if (numNewTimeout && typeof numNewTimeout.setValue === 'function') {",
          "            numNewTimeout.setValue(0);",
          "        }",
          "",
          "        if (pwdNewUser) {",
          "            pwdNewUser.setText('');",
          "        }",
          "    }",
          "",
          "    const txtNewUser = TcHmi.Controls.get('TcHmiTextbox_NewUserName');",
          "    const cmbNewGroup = TcHmi.Controls.get('TcHmiCombobox_NewUserGroup');",
          "    const numNewTimeout = TcHmi.Controls.get('TcHmiNumericInput_NewUserTimeOut2');",
          "    const pwdNewUser = TcHmi.Controls.get('TcHmiPasswordInput_NewUserPasswdUpdate');",
          "",
          "    if (!txtNewUser || !cmbNewGroup || !numNewTimeout || !pwdNewUser) {",
          "        alert('New user controls not found.');",
          "        return;",
          "    }",
          "",
          "    const addNewUser = txtNewUser.getText();",
          "    const addNewGroup = cmbNewGroup.getSelectedValue();",
          "    const addNewAutoL = parseInt(numNewTimeout.getValue(), 10);",
          "    const addNewPassword = pwdNewUser.getText();",
          "",
          "    if (!addNewUser || addNewUser === 'New User') {",
          "        alert('Please provide a valid username.');",
          "        return;",
          "    }",
          "",
          "    if (!addNewPassword) {",
          "        alert('Please provide a password.');",
          "        return;",
          "    }",
          "",
          "    if (!addNewGroup) {",
          "        alert('Please select a group.');",
          "        return;",
          "    }",
          "",
          "    if (isNaN(addNewAutoL) || addNewAutoL < 0) {",
          "        alert('Please provide a valid auto logout time in minutes.');",
          "        return;",
          "    }",
          "",
          "    const groupsToAdd = [];",
          "",
          "    groupsToAdd.push(addNewGroup);",
          "",
          "    // If the selected group is MANAGEMENT,",
          "    // also add the internal __SystemAdministrators group.",
          "    if (addNewGroup === 'MANAGEMENT') {",
          "        groupsToAdd.push('__SystemAdministrators');",
          "    }",
          "",
          "    const autoLogoutValue = minutesToIsoDuration(addNewAutoL);",
          "",
          "    // 1) Create the user with initial password",
          "    TcHmi.Server.UserManagement.addUser(",
          "        addNewUser,",
          "        addNewPassword,",
          "        function (addData) {",
          "",
          "            if (addData && addData.error !== TcHmi.Errors.NONE) {",
          "                console.error('Error creating user:', addData.error);",
          "                alert('Error while creating the user.');",
          "                return;",
          "            }",
          "",
          "            // 2) Update user properties",
          "            TcHmi.Server.UserManagement.updateUser(",
          "                addNewUser,",
          "                {",
          "                    enabled: true,",
          "                    autoLogout: autoLogoutValue,",
          "                    addGroups: groupsToAdd",
          "                },",
          "                function (data) {",
          "",
          "                    if (data.error === TcHmi.Errors.NONE) {",
          "",
          "                        console.log('User created:', addNewUser);",
          "                        console.log('Groups:', groupsToAdd);",
          "                        console.log('Auto-logout:', autoLogoutValue);",
          "",
          "                        alert('User \"' + addNewUser + '\" was created successfully!');",
          "",
          "                        clearNewUserFields();",
          "",
          "                        // Reload User DataGrid immediately",
          "                        if (typeof window.UserManagement_LoadUsers === 'function') {",
          "                            window.UserManagement_LoadUsers();",
          "                        } else {",
          "                            console.warn('window.UserManagement_LoadUsers is not available.');",
          "                        }",
          "",
          "                    } else {",
          "                        console.error('Error updating user:', data.error);",
          "                        alert('Error while creating or updating the user.');",
          "                    }",
          "                }",
          "            );",
          "        }",
          "    );",
          "",
          "})();"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%ctrl%TcHmiNumericInput_NewUserTimeOut2::Value%/ctrl%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/Number",
          "value": 0.0
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%ctrl%TcHmiPasswordInput_NewUserPasswdUpdate::Text%/ctrl%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/String",
          "value": null
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%ctrl%TcHmiTextbox_NewUserName::Text%/ctrl%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/String",
          "value": "New Name"
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%ctrl%TcHmiCombobox_NewUserGroup::SelectedIndex%/ctrl%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/UDINT",
          "value": 0
        },
        "asyncWait": true
      }
    ]
  }
]
</script>

