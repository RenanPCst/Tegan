<div id="TcHmiButton_UpdateUser" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="60" data-tchmi-height-unit="px" data-tchmi-left="647" data-tchmi-left-unit="px" data-tchmi-text="Update User" data-tchmi-top="738" data-tchmi-top-unit="px" data-tchmi-width="140" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="18" data-tchmi-zindex="4">


<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_UpdateUser.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(function () {",
          "",
          "    const SYSTEM_GROUPS = [",
          "        '__SystemAdministrators',",
          "        '__SystemUsers',",
          "        '__SystemGuests',",
          "        '__SystemMaintenanceUsers'",
          "    ];",
          "",
          "    const SYSTEM_USERS = [",
          "        '__SystemAdministrator',",
          "        '__SystemGuest'",
          "    ];",
          "",
          "    function isSystemGroup(groupName) {",
          "        return SYSTEM_GROUPS.includes(groupName);",
          "    }",
          "",
          "    function isSystemUser(userName) {",
          "        return SYSTEM_USERS.includes(userName);",
          "    }",
          "",
          "    function isoDurationToMinutes(duration) {",
          "        if (duration === null || duration === undefined) {",
          "            return 0;",
          "        }",
          "",
          "        const value = String(duration).trim().toUpperCase();",
          "",
          "        if (value === '') {",
          "            return 0;",
          "        }",
          "",
          "        // Format examples:",
          "        // P30D",
          "        // P1D",
          "        if (value.startsWith('P') && !value.startsWith('PT')) {",
          "            let days = 0;",
          "            let buffer = '';",
          "",
          "            for (let i = 1; i < value.length; i++) {",
          "                const char = value[i];",
          "",
          "                if (char >= '0' && char <= '9') {",
          "                    buffer += char;",
          "                } else {",
          "                    const number = parseInt(buffer, 10);",
          "",
          "                    if (!isNaN(number)) {",
          "                        if (char === 'D') {",
          "                            days = number;",
          "                        }",
          "                    }",
          "",
          "                    buffer = '';",
          "                }",
          "            }",
          "",
          "            return days * 24 * 60;",
          "        }",
          "",
          "        // Format examples:",
          "        // PT8H",
          "        // PT30M",
          "        // PT1H30M",
          "        // PT1H0M0S",
          "        // PT0S",
          "        if (value.startsWith('PT')) {",
          "",
          "            let hours = 0;",
          "            let minutes = 0;",
          "            let seconds = 0;",
          "",
          "            let buffer = '';",
          "",
          "            for (let i = 2; i < value.length; i++) {",
          "                const char = value[i];",
          "",
          "                if (char >= '0' && char <= '9') {",
          "                    buffer += char;",
          "                } else {",
          "                    const number = parseInt(buffer, 10);",
          "",
          "                    if (!isNaN(number)) {",
          "                        if (char === 'H') {",
          "                            hours = number;",
          "                        } else if (char === 'M') {",
          "                            minutes = number;",
          "                        } else if (char === 'S') {",
          "                            seconds = number;",
          "                        }",
          "                    }",
          "",
          "                    buffer = '';",
          "                }",
          "            }",
          "",
          "            return (hours * 60) + minutes + Math.ceil(seconds / 60);",
          "        }",
          "",
          "        // Fallback: 01:00:00",
          "        if (value.indexOf(':') >= 0) {",
          "            const parts = value.split(':');",
          "",
          "            if (parts.length === 3) {",
          "                const hours = parseInt(parts[0], 10) || 0;",
          "                const minutes = parseInt(parts[1], 10) || 0;",
          "                const seconds = parseInt(parts[2], 10) || 0;",
          "",
          "                return (hours * 60) + minutes + Math.ceil(seconds / 60);",
          "            }",
          "        }",
          "",
          "        // Fallback: plain number, assume minutes",
          "        if (!isNaN(Number(value))) {",
          "            return parseInt(value, 10);",
          "        }",
          "",
          "        console.warn('Unsupported autoLogout format:', duration);",
          "        return 0;",
          "    }",
          "",
          "    function minutesToIsoDuration(totalMinutes) {",
          "        totalMinutes = parseInt(totalMinutes, 10);",
          "",
          "        if (isNaN(totalMinutes) || totalMinutes < 0) {",
          "            totalMinutes = 0;",
          "        }",
          "",
          "        const days = Math.floor(totalMinutes / 1440);",
          "        const remainingAfterDays = totalMinutes % 1440;",
          "",
          "        const hours = Math.floor(remainingAfterDays / 60);",
          "        const minutes = remainingAfterDays % 60;",
          "",
          "        // If exactly one or more full days, save as PnD.",
          "        // Example: 43200 min -> P30D",
          "        if (days > 0 && hours === 0 && minutes === 0) {",
          "            return 'P' + days + 'D';",
          "        }",
          "",
          "        // If there are days + remaining hours/minutes,",
          "        // convert everything to hours because it is safer for the HMI parser.",
          "        if (days > 0) {",
          "            const totalHours = Math.floor(totalMinutes / 60);",
          "            const remainingMinutes = totalMinutes % 60;",
          "",
          "            let resultWithDays = 'PT' + totalHours + 'H';",
          "",
          "            if (remainingMinutes > 0) {",
          "                resultWithDays += remainingMinutes + 'M';",
          "            }",
          "",
          "            return resultWithDays;",
          "        }",
          "",
          "        let result = 'PT';",
          "",
          "        if (hours > 0) {",
          "            result += hours + 'H';",
          "        }",
          "",
          "        if (minutes > 0) {",
          "            result += minutes + 'M';",
          "        }",
          "",
          "        if (hours === 0 && minutes === 0) {",
          "            result += '0S';",
          "        }",
          "",
          "        return result;",
          "    }",
          "",
          "    function formatAutoLogoutFromMinutes(totalMinutes) {",
          "        totalMinutes = parseInt(totalMinutes, 10);",
          "",
          "        if (isNaN(totalMinutes) || totalMinutes <= 0) {",
          "            return '0min';",
          "        }",
          "",
          "        const days = Math.floor(totalMinutes / 1440);",
          "        const remainingAfterDays = totalMinutes % 1440;",
          "",
          "        const hours = Math.floor(remainingAfterDays / 60);",
          "        const minutes = remainingAfterDays % 60;",
          "",
          "        let parts = [];",
          "",
          "        if (days > 0) {",
          "            parts.push(days + 'd');",
          "        }",
          "",
          "        if (hours > 0) {",
          "            parts.push(hours + 'h');",
          "        }",
          "",
          "        if (minutes > 0) {",
          "            parts.push(minutes + 'min');",
          "        }",
          "",
          "        return parts.join(' ');",
          "    }",
          "",
          "    function getNumericValue(control) {",
          "        if (!control) {",
          "            return 0;",
          "        }",
          "",
          "        if (typeof control.getValue === 'function') {",
          "            return control.getValue();",
          "        }",
          "",
          "        if (typeof control.getText === 'function') {",
          "            return parseFloat(control.getText());",
          "        }",
          "",
          "        return 0;",
          "    }",
          "",
          "    function getSelectedComboboxValue(combo) {",
          "        if (!combo) {",
          "            return '';",
          "        }",
          "",
          "        if (typeof combo.getSelectedValue === 'function') {",
          "            const selectedValue = combo.getSelectedValue();",
          "",
          "            if (selectedValue !== null && selectedValue !== undefined && selectedValue !== '') {",
          "                return selectedValue;",
          "            }",
          "        }",
          "",
          "        const selectedIndex = combo.getSelectedIndex ? combo.getSelectedIndex() : -1;",
          "        const srcData = combo.getSrcData ? combo.getSrcData() : null;",
          "",
          "        if (selectedIndex < 0 || !srcData || selectedIndex >= srcData.length) {",
          "            return '';",
          "        }",
          "",
          "        const selectedItem = srcData[selectedIndex];",
          "",
          "        if (typeof selectedItem === 'string') {",
          "            return selectedItem;",
          "        }",
          "",
          "        return selectedItem.value ||",
          "            selectedItem.text ||",
          "            selectedItem.Groupname ||",
          "            selectedItem.GroupName ||",
          "            selectedItem.groupName ||",
          "            '';",
          "    }",
          "",
          "    function listUsersExAsync() {",
          "        return new Promise(function (resolve, reject) {",
          "            TcHmi.Server.UserManagement.listUsersEx(",
          "                null,",
          "                { timeout: 2000 },",
          "                function (data) {",
          "                    if (data.error === TcHmi.Errors.NONE) {",
          "                        resolve(data.userDetails);",
          "                    } else {",
          "                        reject(data.error);",
          "                    }",
          "                }",
          "            );",
          "        });",
          "    }",
          "",
          "    function updateUserAsync(userName, updateData) {",
          "        return new Promise(function (resolve, reject) {",
          "            TcHmi.Server.UserManagement.updateUserEx(",
          "                userName,",
          "                updateData,",
          "                { timeout: 2000 },",
          "                function (data) {",
          "                    if (data.error === TcHmi.Errors.NONE) {",
          "                        resolve(true);",
          "                    } else {",
          "                        reject(data.error);",
          "                    }",
          "                }",
          "            );",
          "        });",
          "    }",
          "",
          "    async function updateUser() {",
          "        try {",
          "            const txtUser = TcHmi.Controls.get('TcHmiTextbox_EditCurrentUserName');",
          "            const cmbGroup = TcHmi.Controls.get('TcHmiCombobox_EditCurrentUserGroup');",
          "            const numTimeout = TcHmi.Controls.get('TcHmiNumericInput_EditCurrentTimeOut');",
          "            const showText = TcHmi.Controls.get('TcHmiTextblock_UserDetails');",
          "",
          "            if (!txtUser || !cmbGroup || !numTimeout) {",
          "                alert('User management controls not found.');",
          "                return;",
          "            }",
          "",
          "            const userName = txtUser.getText();",
          "            const selectedGroup = getSelectedComboboxValue(cmbGroup);",
          "            const selectedTimeoutMin = parseInt(getNumericValue(numTimeout), 10);",
          "",
          "            if (!userName) {",
          "                alert('Please select a user first.');",
          "                return;",
          "            }",
          "",
          "            if (isSystemUser(userName)) {",
          "                alert('System users cannot be edited.');",
          "                return;",
          "            }",
          "",
          "            if (!selectedGroup) {",
          "                alert('Please select a group.');",
          "                return;",
          "            }",
          "",
          "            if (isSystemGroup(selectedGroup)) {",
          "                alert('System groups cannot be assigned from this screen.');",
          "                return;",
          "            }",
          "",
          "            if (isNaN(selectedTimeoutMin) || selectedTimeoutMin < 0) {",
          "                alert('Please enter a valid automatic logout time in minutes.');",
          "                return;",
          "            }",
          "",
          "            const allUsers = await listUsersExAsync();",
          "",
          "            if (!allUsers.hasOwnProperty(userName)) {",
          "                alert('Selected user was not found.');",
          "                return;",
          "            }",
          "",
          "            const userDetails = allUsers[userName];",
          "",
          "            if (!userDetails.groups || !Array.isArray(userDetails.groups)) {",
          "                alert('Could not read current user groups.');",
          "                return;",
          "            }",
          "",
          "            const currentCustomGroups = userDetails.groups.filter(function (group) {",
          "                return !isSystemGroup(group);",
          "            });",
          "",
          "            const currentGroup = currentCustomGroups.length > 0 ? currentCustomGroups[0] : '';",
          "            const currentTimeoutMin = isoDurationToMinutes(userDetails.autoLogout);",
          "",
          "            const groupChanged = currentGroup !== selectedGroup;",
          "            const timeoutChanged = currentTimeoutMin !== selectedTimeoutMin;",
          "",
          "            if (!groupChanged && !timeoutChanged) {",
          "                alert('No changes detected.');",
          "                return;",
          "            }",
          "",
          "            const updateData = {};",
          "",
          "            if (groupChanged) {",
          "                updateData.removeGroups = currentCustomGroups.filter(function (group) {",
          "                    return group !== selectedGroup;",
          "                });",
          "",
          "                updateData.addGroups = currentCustomGroups.includes(selectedGroup) ? [] : [selectedGroup];",
          "            }",
          "",
          "            if (timeoutChanged) {",
          "                updateData.autoLogout = minutesToIsoDuration(selectedTimeoutMin);",
          "            }",
          "",
          "            console.log('Updating user:', userName);",
          "            console.log('Current group:', currentGroup);",
          "            console.log('Selected group:', selectedGroup);",
          "            console.log('Current timeout min:', currentTimeoutMin);",
          "            console.log('Selected timeout min:', selectedTimeoutMin);",
          "            console.log('Update data:', updateData);",
          "",
          "            await updateUserAsync(userName, updateData);",
          "",
          "            alert('User updated successfully.');",
          "",
          "            if (showText) {",
          "                showText.setText(",
          "                    'User: ' + userName + '\\n\\n' +",
          "                    'Group: ' + selectedGroup + '\\n\\n' +",
          "                    'Automatic Logout: ' + formatAutoLogoutFromMinutes(selectedTimeoutMin)",
          "                );",
          "            }",
          "",
          "            // Reload the user list to keep the screen synchronized.",
          "            // Not strictly required for update, but useful for UX consistency.",
          "            if (typeof window.UserManagement_LoadUsers === 'function') {",
          "                window.UserManagement_LoadUsers();",
          "            } else {",
          "                console.warn('window.UserManagement_LoadUsers is not available.');",
          "            }",
          "",
          "        } catch (error) {",
          "            console.error('Error updating user:', error);",
          "            alert('Error updating user. Please check HMI permissions and server logs.');",
          "        }",
          "    }",
          "",
          "    updateUser();",
          "",
          "})();"
        ],
        "injectContextObject": true,
        "asyncWait": true,
        "waitMode": "Asynchronous"
      }
    ]
  }
]
</script>

