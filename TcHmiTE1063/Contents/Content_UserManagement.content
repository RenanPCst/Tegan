<div id="TcHmiButton_ChangePasswd" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="60" data-tchmi-height-unit="px" data-tchmi-left="827" data-tchmi-left-unit="px" data-tchmi-text="Change Password" data-tchmi-top="332" data-tchmi-top-unit="px" data-tchmi-width="140" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="16" data-tchmi-zindex="4">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_ChangePasswd.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(function () {",
          "",
          "    function validateNewPassword(password) {",
          "        const requirements = {",
          "            minLength: 8,",
          "            hasUppercase: /[A-Z]/,",
          "            hasLowercase: /[a-z]/,",
          "            hasNumber: /[0-9]/,",
          "            hasSpecialCharacter: /[!@#$%^&*(),.?\":{}|<>]/",
          "        };",
          "",
          "        if (!password) {",
          "            return 'Please enter a new password.';",
          "        }",
          "",
          "        if (password.length < requirements.minLength) {",
          "            return 'The password must be at least 8 characters long.';",
          "        }",
          "",
          "        if (!requirements.hasUppercase.test(password)) {",
          "            return 'The password must contain at least one uppercase letter.';",
          "        }",
          "",
          "        if (!requirements.hasLowercase.test(password)) {",
          "            return 'The password must contain at least one lowercase letter.';",
          "        }",
          "",
          "        if (!requirements.hasNumber.test(password)) {",
          "            return 'The password must contain at least one number.';",
          "        }",
          "",
          "        if (!requirements.hasSpecialCharacter.test(password)) {",
          "            return 'The password must contain at least one special character.';",
          "        }",
          "",
          "        return null;",
          "    }",
          "",
          "    function clearPasswordFields() {",
          "        const newPasswordControl = TcHmi.Controls.get('TextboxNewPassword');",
          "        const confirmPasswordControl = TcHmi.Controls.get('TextboxConfirmNewPassword');",
          "",
          "        if (newPasswordControl) {",
          "            newPasswordControl.setText('');",
          "        }",
          "",
          "        if (confirmPasswordControl) {",
          "            confirmPasswordControl.setText('');",
          "        }",
          "    }",
          "",
          "    const newPasswordControl = TcHmi.Controls.get('TextboxNewPassword');",
          "    const confirmPasswordControl = TcHmi.Controls.get('TextboxConfirmNewPassword');",
          "    const messageTextblock = TcHmi.Controls.get('TcHmiTextblock_1014');",
          "",
          "    if (!newPasswordControl || !confirmPasswordControl || !messageTextblock) {",
          "        alert('Password controls not found.');",
          "        return;",
          "    }",
          "",
          "    const newPassword = newPasswordControl.getText();",
          "    const confirmPassword = confirmPasswordControl.getText();",
          "    const currentUser = TcHmi.Server.getCurrentUser();",
          "",
          "    messageTextblock.setText('');",
          "",
          "    if (!currentUser) {",
          "        messageTextblock.setText('No user is currently logged in.');",
          "        alert('No user is currently logged in.');",
          "        return;",
          "    }",
          "",
          "    if (!confirmPassword) {",
          "        messageTextblock.setText('Please confirm the new password.');",
          "        return;",
          "    }",
          "",
          "    if (newPassword !== confirmPassword) {",
          "        messageTextblock.setText('The passwords do not match.');",
          "        alert('The passwords do not match. Please check both fields.');",
          "        return;",
          "    }",
          "",
          "    const passwordError = validateNewPassword(newPassword);",
          "",
          "    if (passwordError) {",
          "        messageTextblock.setText(passwordError);",
          "        return;",
          "    }",
          "",
          "    if (!confirm('Do you confirm the password change?')) {",
          "        console.log('Password change cancelled by the user.');",
          "        return;",
          "    }",
          "",
          "    TcHmi.Server.UserManagement.updateUser(",
          "        currentUser,",
          "        {",
          "            password: newPassword",
          "        },",
          "        function (data) {",
          "            if (data.error === TcHmi.Errors.NONE) {",
          "                console.log('Password updated successfully.');",
          "",
          "                messageTextblock.setText('Password changed successfully.');",
          "                alert('Password changed successfully. Please log in again.');",
          "",
          "                clearPasswordFields();",
          "",
          "                TcHmi.Server.logout();",
          "",
          "            } else {",
          "                console.error('Error updating password:', data.error);",
          "",
          "                messageTextblock.setText('Error changing password. Please check permissions and try again.');",
          "                alert('Error changing password. Please check permissions and try again.');",
          "            }",
          "        }",
          "    );",
          "",
          "})();"
        ],
        "injectContextObject": true,
        "asyncWait": true,
        "waitMode": "Asynchronous"
      }
    ]
  }
]
</script>

