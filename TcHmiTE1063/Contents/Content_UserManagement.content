<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiDatagrid_GroupLists.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "// Pega o controle do DataGrid",
          "let grid = TcHmi.Controls.get('TcHmiDatagrid_GroupLists');",
          "",
          "// Pega o índice da linha selecionada",
          "let selectedIndex = grid.getSelectedRowIndex();",
          "",
          "// Pega os dados da origem do DataGrid",
          "let data = grid.getSrcData();",
          "",
          "// Verifica se há uma seleção válida",
          "if (grid) {",
          "    if (selectedIndex !== null && data && selectedIndex >= 0 && selectedIndex < data.length) {",
          "        // Pega a linha selecionada",
          "        let selectedRow = data[selectedIndex];",
          "",
          "        // Pega o nome do grupo da linha selecionada (ajuste o nome da coluna conforme necessário)",
          "        let nomeGrupo = selectedRow['Groupname']; // Substitua 'GroupName' pelo nome real da coluna no seu DataGrid",
          "",
          "        console.log('Grupo selecionado:', nomeGrupo);",
          "",
          "        // Busca todos os usuários e filtra os que pertencem ao grupo selecionado",
          "        TcHmi.Server.UserManagement.listUsersEx(",
          "            null,",
          "            { timeout: 2000 },",
          "            function (data) {",
          "                if (data.error === TcHmi.Errors.NONE) {",
          "                    const allUsers = data.userDetails;",
          "",
          "                    // Filtra usuários que pertencem ao grupo selecionado",
          "                    const usuariosNoGrupo = Object.keys(allUsers).filter(username => {",
          "                        const user = allUsers[username];",
          "                        return user.groups.includes(nomeGrupo);",
          "                    });",
          "",
          "                    if (usuariosNoGrupo.length > 0) {",
          "                        const formattedText =",
          "                            'Group: ' + nomeGrupo + '\\n\\n' +",
          "                            'Users in the group:\\n' + usuariosNoGrupo.join(',\\n');",
          "",
          "                        const showText = TcHmi.Controls.get('UserDetails');",
          "                        showText.setText(formattedText);",
          "                    } else {",
          "                        const showText = TcHmi.Controls.get('UserDetails');",
          "                        showText.setText('No users registered in this group:\\n' + nomeGrupo);",
          "                    }",
          "                } else {",
          "                    console.error('Erro ao listar usuários:', data.error);",
          "                }",
          "            }",
          "        );",
          "    } else {",
          "        console.warn('No row selected or invalid data.');",
          "    }",
          "} else {",
          "    console.error('Controle DataGrid não encontrado.');",
          "}"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>

