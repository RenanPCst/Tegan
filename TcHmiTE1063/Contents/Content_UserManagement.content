<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "Content_UserManagement.onAttached",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(function () {",
          "",
          "    console.log(\"User Management Content attached. Loading users and groups...\");",
          "",
          "    // ------------------------------------------------------------",
          "    // Load Users",
          "    // ------------------------------------------------------------",
          "    function loadUsers() {",
          "",
          "        TcHmi.Server.UserManagement.listUsernames(function (data) {",
          "",
          "            if (data.error === TcHmi.Errors.NONE) {",
          "",
          "                const userList = data.userList || [];",
          "                console.log(\"User list received:\", userList);",
          "",
          "                const usersExcluded = [",
          "                    \"__SystemAdministrator\",",
          "                    \"__SystemGuest\"",
          "                ];",
          "",
          "                const usersFiltered = userList.filter(function (username) {",
          "                    return !usersExcluded.includes(username);",
          "                });",
          "",
          "                const gridData = usersFiltered.map(function (username) {",
          "                    return {",
          "                        Username: username",
          "                    };",
          "                });",
          "",
          "                const userGrid = TcHmi.Controls.get(\"TcHmiDatagrid_UserLists\");",
          "",
          "                if (userGrid) {",
          "                    userGrid.setSrcData(gridData);",
          "                    console.log(\"User DataGrid loaded:\", gridData);",
          "                } else {",
          "                    console.warn(\"Control not found: TcHmiDatagrid_UserLists\");",
          "                }",
          "",
          "            } else {",
          "                console.error(\"Error loading users:\", data.error);",
          "            }",
          "        });",
          "    }",
          "",
          "",
          "    // ------------------------------------------------------------",
          "    // Load Groups",
          "    // ------------------------------------------------------------",
          "    function loadGroups() {",
          "",
          "        TcHmi.Server.UserManagement.listUserGroups(function (data) {",
          "",
          "            if (data.error === TcHmi.Errors.NONE) {",
          "",
          "                const groupDetailsList = data.groupDetailsList || {};",
          "                console.log(\"Group details received:\", groupDetailsList);",
          "",
          "                const groupsExcluded = [",
          "                    \"__SystemAdministrators\",",
          "                    \"__SystemGuests\",",
          "                    \"__SystemMaintenanceUsers\",",
          "                    \"__SystemUsers\"",
          "                ];",
          "",
          "                const groupNames = Object.keys(groupDetailsList).filter(function (groupname) {",
          "                    return !groupsExcluded.includes(groupname);",
          "                });",
          "",
          "                console.log(\"Filtered groups:\", groupNames);",
          "",
          "                const gridData = groupNames.map(function (groupname) {",
          "                    return {",
          "                        Groupname: groupname",
          "                    };",
          "                });",
          "",
          "                const comboData = groupNames.map(function (groupname) {",
          "                    return {",
          "                        value: groupname,",
          "                        text: groupname",
          "                    };",
          "                });",
          "",
          "",
          "                // ------------------------------------------------------------",
          "                // Group DataGrid",
          "                // ------------------------------------------------------------",
          "                const groupGrid = TcHmi.Controls.get(\"TcHmiDatagrid_GroupLists\");",
          "",
          "                if (groupGrid) {",
          "                    groupGrid.setSrcData(gridData);",
          "                    console.log(\"Group DataGrid loaded:\", gridData);",
          "                } else {",
          "                    console.warn(\"Control not found: TcHmiDatagrid_GroupLists\");",
          "                }",
          "",
          "",
          "                // ------------------------------------------------------------",
          "                // New User Group ComboBox",
          "                // ------------------------------------------------------------",
          "                const newUserGroupCombo = TcHmi.Controls.get(\"TcHmiCombobox_NewUserGroup\");",
          "",
          "                if (newUserGroupCombo) {",
          "                    newUserGroupCombo.setSrcData(comboData);",
          "                    console.log(\"New User Group ComboBox loaded:\", comboData);",
          "                } else {",
          "                    console.warn(\"Control not found: TcHmiCombobox_NewUserGroup\");",
          "                }",
          "",
          "",
          "                // ------------------------------------------------------------",
          "                // Edit Current User Group ComboBox",
          "                // ------------------------------------------------------------",
          "                const editUserGroupCombo = TcHmi.Controls.get(\"TcHmiCombobox_EditCurrentUserGroup\");",
          "",
          "                if (editUserGroupCombo) {",
          "                    editUserGroupCombo.setSrcData(comboData);",
          "                    console.log(\"Edit User Group ComboBox loaded:\", comboData);",
          "                } else {",
          "                    console.warn(\"Control not found: TcHmiCombobox_EditCurrentUserGroup\");",
          "                }",
          "",
          "            } else {",
          "                console.error(\"Error loading groups:\", data.error);",
          "            }",
          "        });",
          "    }",
          "",
          "",
          "    // ------------------------------------------------------------",
          "    // Expose reload functions globally",
          "    // ------------------------------------------------------------",
          "    window.UserManagement_LoadUsers = loadUsers;",
          "",
          "    window.UserManagement_LoadGroups = loadGroups;",
          "",
          "    window.UserManagement_ReloadAll = function () {",
          "        loadUsers();",
          "        loadGroups();",
          "    };",
          "",
          "",
          "    // ------------------------------------------------------------",
          "    // Execute on content attached",
          "    // ------------------------------------------------------------",
          "    loadUsers();",
          "    loadGroups();",
          "",
          "})();"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
