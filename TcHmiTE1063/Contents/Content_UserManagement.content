<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiDatagrid_UserLists.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "let grid = TcHmi.Controls.get('TcHmiDatagrid_UserLists');",
          "let selectedIndex = grid.getSelectedRowIndex();",
          "    let data = grid.getSrcData();",
          "let selectedRow = data[selectedIndex];",
          "let nome = selectedRow['Username']; // substitua com o nome real da sua coluna",
          "",
          "// Função para converter o formato ISO 8601 para um valor legível",
          "function formatAutoLogout(duration) {",
          "    const match = duration.match(/^PT/);",
          "",
          "    if (!match) return duration; // Retorna original se não for compatível",
          "",
          "    const hours = match[1] ? parseInt(match[1]) : 0;",
          "    const minutes = match[2] ? parseInt(match[2]) : 0;",
          "    const seconds = match[3] ? parseInt(match[3]) : 0;",
          "",
          "    let parts = [];",
          "    if (hours) parts.push(`${hours}h`);",
          "    if (minutes) parts.push(`${minutes}min`);",
          "    if (seconds || parts.length === 0) parts.push(`${seconds}s`);",
          "",
          "    return parts.join(' ');",
          "}",
          "",
          "",
          "if (grid) {",
          "    if (selectedIndex !== null && data && selectedIndex >= 0 && selectedIndex < data.length) {",
          "        console.log('Nome selecionado:', nome);",
          "    } else {",
          "        console.warn('Nenhuma linha selecionada ou dados inválidos.');",
          "    }",
          "} else {",
          "    console.error('Controle MyDataGrid não encontrado.');",
          "}",
          "",
          "TcHmi.Server.UserManagement.listUsersEx(",
          "    null,",
          "    { timeout: 2000 },",
          "    function (data) {",
          "        if (data.error === TcHmi.Errors.NONE) {",
          "            const allUsers = data.userDetails;",
          "            // Verifica se o usuário existe na resposta",
          "            if (allUsers.hasOwnProperty(nome)) {",
          "                const userDetails = allUsers[nome];",
          "                console.log('User details:', userDetails);",
          "                const formattedText =",
          "        'User: ' + nome + '\\n\\n' +",
          "        'Active: ' + (userDetails.enabled ? 'Yes' : 'No') + '\\n\\n' +",
          "        'Automatic Logout: ' + formatAutoLogout(userDetails.autoLogout) + '\\n\\n' +",
          "        'Groups:\\n ' + userDetails.groups.join(',\\n');",
          "                showText.setText(formattedText);",
          "            } else {",
          "                console.log('Usuário não encontrado:', nome);",
          "            }",
          "        } else {",
          "            console.error('Erro ao listar usuários:', data.error);",
          "        }",
          "    }",
          ");",
          "var showText = TcHmi.Controls.get('TcHmiTextblock_UserDetails');",
          "",
          "showText.setText(nome);"
        ],
        "injectContextObject": true,
        "asyncWait": true,
        "waitMode": "Asynchronous"
      }
    ]
  }
]
</script>



