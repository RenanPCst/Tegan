<div id="btnDownloadPDF_16" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="80" data-tchmi-height-unit="px" data-tchmi-left="568" data-tchmi-left-unit="px" data-tchmi-text="Linear Pumps Position History" data-tchmi-top="446" data-tchmi-top-unit="px" data-tchmi-width="180" data-tchmi-width-unit="px" data-tchmi-word-wrap="True" data-tchmi-zindex="60" data-tchmi-text-font-size="16" data-tchmi-text-font-weight="Normal">
<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "btnDownloadPDF_16.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "// Call the PDF generator function",
          "          function showMessageFromPLC(message) {",
          "          \t\talert(\"Mensagem do PLC: \" + message);",
          "          }",
          "          // Wrinting the PLC variable",
          "          TcHmi.Symbol.readEx2('%s%PLC1.GVL_DB.arrCompleteMethod%/s%', function (data) {",
          "              if (data.error === TcHmi.Errors.NONE) {",
          "                  let allRevisions = data.value; // value from PLC (array)",
          "                  // Function Call",
          "                  genCompleteMethodReport(allRevisions, '203 - Complete Method Report');                  ",
          "              } else {",
          "                  console.error(\"Erro ao ler variável do PLC: \", data.error);",
          "              }",
          "          });"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
