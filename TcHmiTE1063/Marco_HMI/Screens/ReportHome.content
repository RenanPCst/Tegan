<div id="TcHmiButton_24" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="55" data-tchmi-height-unit="px" data-tchmi-left="335" data-tchmi-left-unit="px" data-tchmi-text="Generate PDF" data-tchmi-top="755" data-tchmi-top-unit="px" data-tchmi-width="120" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="16">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_24.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "TcHmi.Symbol.readEx2('%s%PLC1.GVL_Reports.aReportSearchResult%/s%', function (data) {",
          "    if (data.error !== TcHmi.Errors.NONE || !Array.isArray(data.value)) {",
          "        console.error('Error reading report search result:', data.error);",
          "        alert('Could not read the report list.');",
          "        return;",
          "    }",
          "",
          "    var combo = TcHmi.Controls.get('TcHmiCombobox_ReportType');",
          "    var grid = TcHmi.Controls.get('TcHmiDatagrid_5');",
          "    var idInput = TcHmi.Controls.get('TcHmiNumericInput_SelectbyID');",
          "",
          "    if (!combo) {",
          "        alert('Report type control not found.');",
          "        return;",
          "    }",
          "",
          "    if (!grid) {",
          "        alert('Report list grid not found.');",
          "        return;",
          "    }",
          "",
          "    function getComboValue(ctrl) {",
          "        if (!ctrl) return null;",
          "",
          "        if (typeof ctrl.getSelectedValue === 'function') {",
          "            return ctrl.getSelectedValue();",
          "        }",
          "",
          "        if (typeof ctrl.getValue === 'function') {",
          "            return ctrl.getValue();",
          "        }",
          "",
          "        return null;",
          "    }",
          "",
          "    function getNumericValue(ctrl) {",
          "        if (!ctrl) return null;",
          "",
          "        if (typeof ctrl.getValue === 'function') {",
          "            return ctrl.getValue();",
          "        }",
          "",
          "        return null;",
          "    }",
          "",
          "    var reportType = getComboValue(combo);",
          "",
          "    if (",
          "        reportType === null ||",
          "        reportType === undefined ||",
          "        reportType === '' ||",
          "        Number(reportType) === 0",
          "    ) {",
          "        alert('Please select a report type before generating the PDF.');",
          "        return;",
          "    }",
          "",
          "    var selectedIndex = -1;",
          "    if (typeof grid.getSelectedRowIndex === 'function') {",
          "        selectedIndex = grid.getSelectedRowIndex();",
          "    }",
          "",
          "    var selectedPrimaryID = '';",
          "    var selectedReportName = '';",
          "",
          "    if (selectedIndex >= 0 && selectedIndex < data.value.length) {",
          "        var selectedRow = data.value[selectedIndex];",
          "",
          "        selectedPrimaryID = String(selectedRow.ReportID || '').trim();",
          "        selectedReportName = String(selectedRow.ReportType || '').trim();",
          "",
          "        if (selectedPrimaryID === '') {",
          "            alert('The selected row does not contain a valid report ID.');",
          "            return;",
          "        }",
          "    } else {",
          "        var inputId = getNumericValue(idInput);",
          "        var numericId = Number(inputId);",
          "",
          "        if (!isFinite(numericId) || numericId <= 0) {",
          "            alert('Please select a report in the table or enter a valid report ID.');",
          "            return;",
          "        }",
          "",
          "        selectedPrimaryID = String(numericId);",
          "        selectedReportName = '';",
          "    }",
          "",
          "    TcHmi.Symbol.writeEx('%s%PLC1.GVL_Reports.eSelectedReportType%/s%', reportType, function (res1) {",
          "        if (res1.error !== TcHmi.Errors.NONE) {",
          "            console.error('Error writing report type:', res1.error);",
          "            alert('Could not prepare report loading.');",
          "            return;",
          "        }",
          "",
          "        TcHmi.Symbol.writeEx('%s%PLC1.GVL_Reports.sSelectedPrimaryID%/s%', selectedPrimaryID, function (res2) {",
          "            if (res2.error !== TcHmi.Errors.NONE) {",
          "                console.error('Error writing selected primary ID:', res2.error);",
          "                alert('Could not prepare report loading.');",
          "                return;",
          "            }",
          "",
          "            TcHmi.Symbol.writeEx('%s%PLC1.GVL_Reports.sSelectedReportName%/s%', selectedReportName, function (res3) {",
          "                if (res3.error !== TcHmi.Errors.NONE) {",
          "                    console.error('Error writing selected report name:', res3.error);",
          "                    alert('Could not prepare report loading.');",
          "                    return;",
          "                }",
          "",
          "                TcHmi.Symbol.writeEx('%s%PLC1.GVL_Reports.bLoadSelectedReport%/s%', true, function (res4) {",
          "                    if (res4.error !== TcHmi.Errors.NONE) {",
          "                        console.error('Error triggering report load:', res4.error);",
          "                        alert('Could not start report loading.');",
          "                    } else {",
          "                        console.log('Report load requested for ID:', selectedPrimaryID);",
          "                    }",
          "                });",
          "            });",
          "        });",
          "    });",
          "});"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
