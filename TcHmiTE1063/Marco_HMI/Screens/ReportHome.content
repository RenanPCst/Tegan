<div id="btnDownloadPDF_15" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="80" data-tchmi-height-unit="px" data-tchmi-left="568" data-tchmi-left-unit="px" data-tchmi-text="Method Report" data-tchmi-top="110" data-tchmi-top-unit="px" data-tchmi-width="180" data-tchmi-width-unit="px" data-tchmi-word-wrap="True" data-tchmi-zindex="60" data-tchmi-text-font-size="16" data-tchmi-text-font-weight="Normal">
<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "btnDownloadPDF_15.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(function () {",
          "    const readSymbol = (symbol) => new Promise((resolve, reject) => {",
          "        TcHmi.Symbol.readEx2('%s%' + symbol + '%/s%', function (data) {",
          "            if (data.error === TcHmi.Errors.NONE) {",
          "                resolve(data.value);",
          "            } else {",
          "                reject(data.error);",
          "            }",
          "        });",
          "    });",
          "",
          "    function formatDateFromPlcDate(plcDate) {",
          "        if (!plcDate) return '';",
          "",
          "        try {",
          "            const d = new Date(plcDate);",
          "            if (!isNaN(d.getTime())) {",
          "                const dd = String(d.getDate()).padStart(2, '0');",
          "                const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];",
          "                const mm = months[d.getMonth()];",
          "                const yyyy = d.getFullYear();",
          "                return `${dd}-${mm}-${yyyy}`;",
          "            }",
          "        } catch (e) {",
          "            console.warn('Could not parse PLC date:', plcDate, e);",
          "        }",
          "",
          "        return String(plcDate);",
          "    }",
          "",
          "    function timeToSecondsString(value) {",
          "\t    if (value === null || value === undefined || value === '') return '';",
          "\t",
          "\t    if (typeof value === 'number') {",
          "\t        return String(Math.round(value));",
          "\t    }",
          "\t",
          "\t    const s = String(value).trim().toUpperCase();",
          "\t",
          "\t    const isoMatch = s.match(/^PT(?:(\\d+)H)?(?:(\\d+)M)?(?:(\\d+(?:\\.\\d+)?)S)?$/);",
          "\t    if (isoMatch) {",
          "\t        const hours = parseFloat(isoMatch[1] || '0');",
          "\t        const minutes = parseFloat(isoMatch[2] || '0');",
          "\t        const seconds = parseFloat(isoMatch[3] || '0');",
          "\t        return String(Math.round(hours * 3600 + minutes * 60 + seconds));",
          "\t    }",
          "\t",
          "\t    const matchMs = s.match(/^(\\d+(?:\\.\\d+)?)MS$/);",
          "\t    if (matchMs) {",
          "\t        return String(Math.round(parseFloat(matchMs[1]) / 1000));",
          "\t    }",
          "\t",
          "\t    const matchS = s.match(/^(\\d+(?:\\.\\d+)?)S$/);",
          "\t    if (matchS) {",
          "\t        return String(Math.round(parseFloat(matchS[1])));",
          "\t    }",
          "\t",
          "\t    return s;",
          "\t}",
          "",
          "    function numberToString(value, decimals) {",
          "        const num = Number(value);",
          "        if (!isFinite(num)) return '';",
          "        return num.toFixed(decimals);",
          "    }",
          "",
          "    function buildMethodHeader(activeRecipe) {",
          "        return {",
          "            methodName: String(activeRecipe?.stInfo?.sMethodName || ''),",
          "            methodRevision: String(activeRecipe?.stInfo?.iRevision ?? ''),",
          "            methodCreatedBy: String(activeRecipe?.stInfo?.sCreatedBy || ''),",
          "            methodCreatedOn: formatDateFromPlcDate(activeRecipe?.stInfo?.dCreationDate),",
          "",
          "            solvent_R1: String(activeRecipe?.stSolventsTimes?.aSolventN?.[0] ?? activeRecipe?.stSolventsTimes?.aSolventN?.[1] ?? ''),",
          "            solvent_R2: String(activeRecipe?.stSolventsTimes?.aSolventN?.[1] ?? activeRecipe?.stSolventsTimes?.aSolventN?.[2] ?? ''),",
          "            solvent_W1: String(activeRecipe?.stSolventsTimes?.aSolventN?.[2] ?? activeRecipe?.stSolventsTimes?.aSolventN?.[3] ?? ''),",
          "            solvent_W2: String(activeRecipe?.stSolventsTimes?.aSolventN?.[3] ?? activeRecipe?.stSolventsTimes?.aSolventN?.[4] ?? ''),",
          "",
          "            time_R1: timeToSecondsString(activeRecipe?.stSolventsTimes?.aTime?.[0] ?? activeRecipe?.stSolventsTimes?.aTime?.[1]),",
          "            time_R2: timeToSecondsString(activeRecipe?.stSolventsTimes?.aTime?.[1] ?? activeRecipe?.stSolventsTimes?.aTime?.[2]),",
          "            time_W1: timeToSecondsString(activeRecipe?.stSolventsTimes?.aTime?.[2] ?? activeRecipe?.stSolventsTimes?.aTime?.[3]),",
          "            time_W2: timeToSecondsString(activeRecipe?.stSolventsTimes?.aTime?.[3] ?? activeRecipe?.stSolventsTimes?.aTime?.[4]),",
          "",
          "            velocity_R1: String(activeRecipe?.stSolventsTimes?.aVelocity?.[0] ?? activeRecipe?.stSolventsTimes?.aVelocity?.[1] ?? ''),",
          "            velocity_R2: String(activeRecipe?.stSolventsTimes?.aVelocity?.[1] ?? activeRecipe?.stSolventsTimes?.aVelocity?.[2] ?? ''),",
          "            velocity_W1: String(activeRecipe?.stSolventsTimes?.aVelocity?.[2] ?? activeRecipe?.stSolventsTimes?.aVelocity?.[3] ?? ''),",
          "            velocity_W2: String(activeRecipe?.stSolventsTimes?.aVelocity?.[3] ?? activeRecipe?.stSolventsTimes?.aVelocity?.[4] ?? ''),",
          "",
          "            soakTime: timeToSecondsString(activeRecipe?.stOtherParams?.tSoakTime),",
          "            agitate_1_Time: timeToSecondsString(activeRecipe?.stOtherParams?.tAgitate1Time),",
          "            agitate_2_Time: timeToSecondsString(activeRecipe?.stOtherParams?.tAgitate2Time),",
          "            vialsToFill: String(activeRecipe?.stOtherParams?.iVialsToFill ?? ''),",
          "            vialPrimeVol: numberToString(activeRecipe?.stOtherParams?.rVialPrimeVol, 2),",
          "            vial_1_FillVol: numberToString(activeRecipe?.stOtherParams?.rVial1FillVol, 2),",
          "            vial_2_4_FillVol: numberToString(activeRecipe?.stOtherParams?.rVials2_4FillVol, 2),",
          "            airDryTime: timeToSecondsString(activeRecipe?.stOtherParams?.tAirDryTime)",
          "        };",
          "    }",
          "",
          "    function buildVolumeData(activeRecipe) {",
          "        const v = activeRecipe?.stVolumes || {};",
          "",
          "        const get = (arr, idx) => numberToString(arr?.[idx] ?? arr?.[idx + 1], 2);",
          "",
          "        return [",
          "            {",
          "                pump: '1',",
          "                stage: 'T/IC',",
          "                rinse1: get(v.aT_IC_Volume, 0),",
          "                rinse2: get(v.aT_IC_Volume, 1),",
          "                wash1: get(v.aT_IC_Volume, 2),",
          "                wash2: get(v.aT_IC_Volume, 3)",
          "            },",
          "            {",
          "                pump: '2',",
          "                stage: 'S0',",
          "                rinse1: get(v.aS0_Volume, 0),",
          "                rinse2: get(v.aS0_Volume, 1),",
          "                wash1: get(v.aS0_Volume, 2),",
          "                wash2: get(v.aS0_Volume, 3)",
          "            },",
          "            {",
          "                pump: '3',",
          "                stage: 'S1',",
          "                rinse1: get(v.aS1_Volume, 0),",
          "                rinse2: get(v.aS1_Volume, 1),",
          "                wash1: get(v.aS1_Volume, 2),",
          "                wash2: get(v.aS1_Volume, 3)",
          "            },",
          "            {",
          "                pump: '4',",
          "                stage: 'S2',",
          "                rinse1: get(v.aS2_Volume, 0),",
          "                rinse2: get(v.aS2_Volume, 1),",
          "                wash1: get(v.aS2_Volume, 2),",
          "                wash2: get(v.aS2_Volume, 3)",
          "            },",
          "            {",
          "                pump: '5',",
          "                stage: 'S3',",
          "                rinse1: get(v.aS3_Volume, 0),",
          "                rinse2: get(v.aS3_Volume, 1),",
          "                wash1: get(v.aS3_Volume, 2),",
          "                wash2: get(v.aS3_Volume, 3)",
          "            },",
          "            {",
          "                pump: '6',",
          "                stage: 'S4',",
          "                rinse1: get(v.aS4_Volume, 0),",
          "                rinse2: get(v.aS4_Volume, 1),",
          "                wash1: get(v.aS4_Volume, 2),",
          "                wash2: get(v.aS4_Volume, 3)",
          "            },",
          "            {",
          "                pump: '7',",
          "                stage: 'S5',",
          "                rinse1: get(v.aS5_Volume, 0),",
          "                rinse2: get(v.aS5_Volume, 1),",
          "                wash1: get(v.aS5_Volume, 2),",
          "                wash2: get(v.aS5_Volume, 3)",
          "            },",
          "            {",
          "                pump: '8',",
          "                stage: 'S6',",
          "                rinse1: get(v.aS6_Volume, 0),",
          "                rinse2: get(v.aS6_Volume, 1),",
          "                wash1: get(v.aS6_Volume, 2),",
          "                wash2: get(v.aS6_Volume, 3)",
          "            },",
          "            {",
          "                pump: '9',",
          "                stage: 'S7',",
          "                rinse1: get(v.aS7_Volume, 0),",
          "                rinse2: get(v.aS7_Volume, 1),",
          "                wash1: get(v.aS7_Volume, 2),",
          "                wash2: get(v.aS7_Volume, 3)",
          "            },",
          "            {",
          "                pump: '10',",
          "                stage: 'F',",
          "                rinse1: get(v.aF_Volume, 0),",
          "                rinse2: get(v.aF_Volume, 1),",
          "                wash1: get(v.aF_Volume, 2),",
          "                wash2: get(v.aF_Volume, 3)",
          "            }",
          "        ];",
          "    }",
          "",
          "    Promise.all([",
          "        readSymbol('PLC1.GVL_Recipe.bIsThereRecipeActivated'),",
          "        readSymbol('PLC1.GVL_Recipe.stActiveRecipe')",
          "    ])",
          "        .then(function ([isActive, activeRecipe]) {",
          "            if (!isActive) {",
          "                alert('There is no active method.');",
          "                return;",
          "            }",
          "",
          "            if (typeof genMethodReport !== 'function') {",
          "                alert('Current method PDF function was not found.');",
          "                return;",
          "            }",
          "",
          "            const methodHeader = buildMethodHeader(activeRecipe);",
          "            const volumeData = buildVolumeData(activeRecipe);",
          "",
          "            genMethodReport(methodHeader, volumeData, '301 - Current Method Report');",
          "        })",
          "        .catch(function (err) {",
          "            console.error('Error generating current method report:', err);",
          "            alert('Could not generate current method report.');",
          "        });",
          "})();"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>

<script data-tchmi-target-attribute="data-tchmi-border-radius" type="application/json">
{
  "topLeft": 0.0,
  "topRight": 0.0,
  "bottomLeft": 0.0,
  "bottomRight": 0.0,
  "topLeftUnit": "px",
  "topRightUnit": "px",
  "bottomLeftUnit": "px",
  "bottomRightUnit": "px"
}
