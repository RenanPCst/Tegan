<div id="btnDownloadPDF_8" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="80" data-tchmi-height-unit="px" data-tchmi-left="80" data-tchmi-left-unit="px" data-tchmi-text="Users and Groups" data-tchmi-top="110" data-tchmi-top-unit="px" data-tchmi-width="180" data-tchmi-width-unit="px" data-tchmi-word-wrap="True" data-tchmi-zindex="60" data-tchmi-text-font-size="16" data-tchmi-text-font-weight="Normal">
<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "btnDownloadPDF_8.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "// Call the PDF generator function",
          "          function showMessageFromPLC(message) {",
          "          \t\talert(\"Mensagem do PLC: \" + message);",
          "          }",
          "          // Wrinting the PLC variable",
          "          TcHmi.Symbol.readEx2('%s%PLC1.GVL_DB.astData_CUL%/s%', function (data) {",
          "              if (data.error === TcHmi.Errors.NONE) {",
          "                  let plcArrayData = data.value; // value from PLC (array)",
          "                  // Function Call",
          "                  genCurrentUserList(plcArrayData,'401 - Current Users List');                  ",
          "              } else {",
          "                  console.error(\"Erro ao ler variável do PLC: \", data.error);",
          "              }",
          "          });"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>

