          "              if (data.error === TcHmi.Errors.NONE) {",
          "                  let sysDataArray = data.value; // value from PLC (array)",
          "                  // Function Call",
          "                  genCurrentSysReport(sysDataArray, 'System Settings Report');                  ",
          "              } else {",
          "                  console.error(\"Erro ao ler variável do PLC: \", data.error);",
          "              }",
          "          });"
        ],
