<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "btnDownloadPDF_18.onPressed",
    "actions": [
      {
        "objectType": "Condition",
        "active": false,
        "parts": [
          {
            "if": [
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:framework#/definitions/TcHmi.Controls.Beckhoff.TcHmiCheckbox.StateSymbol",
                  "symbolExpression": "%ctrl%TcHmiCheckbox_PrintWhenComplete::StateSymbol%/ctrl%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:framework#/definitions/TcHmi.Controls.Beckhoff.TcHmiCheckbox.StateSymbol",
                  "value": "true"
                },
                "compareOperator": "==",
                "logic": null
              }
            ],
            "then": []
          },
          {
            "else": []
          }
        ],
        "asyncWait": true
      },
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "// Call the PDF generator function",
          "function showMessageFromPLC(message) {",
          "\talert(\"Mensagem do PLC: \" + message);",
          "}",
          "",
          "// Wrinting the PLC variable",
          "TcHmi.Symbol.readEx2('%s%PLC1.GVL_DB.stPostRunInfo%/s%', function (data1) {",
          "if (data1.error === TcHmi.Errors.NONE) {",
          "\tTcHmi.Symbol.readEx2('%s%PLC1.GVL_DB.stParameter_MR%/s%', function (data2) {",
          "\tif (data2.error === TcHmi.Errors.NONE) {",
          "\t\tTcHmi.Symbol.readEx2('%s%PLC1.GVL_DB.astVolData%/s%', function (data3) {",
          "\t\tif (data3.error === TcHmi.Errors.NONE) {",
          "\t\t\tlet volumeDataArray = data3.value;",
          "\t\t\tlet methodDataArray = data2.value;",
          "\t\t\tlet runDataArray = data1.value; // value from PLC (array)",
          "\t\t\t// Function Call",
          "\t\t\tgenPostRunReport(runDataArray, methodDataArray, volumeDataArray,  '001 - Post-Run Report')",
          "    \t}else {console.error(\"Error to read volumeData from PLC: \", data3.error);}});",
          "\t}else {console.error(\"Error to read methodData fromPLC: \", data2.error);}});",
          "}else {console.error(\"Error to read runData from PLC: \", data1.error);}});"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
