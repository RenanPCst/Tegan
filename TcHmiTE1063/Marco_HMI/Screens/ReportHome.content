<div id="TcHmiButton_20" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="55" data-tchmi-height-unit="px" data-tchmi-left="203" data-tchmi-left-unit="px" data-tchmi-text="List Last 100" data-tchmi-top="755" data-tchmi-top-unit="px" data-tchmi-width="120" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="16">

    <script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
        [
        {
        "event": "TcHmiButton_20.onPressed",
        "actions": [
        {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
        "(function () {",
        "    var combo = TcHmi.Controls.get('TcHmiCombobox_ReportType');",
        "",
        "    function writeSymbol(symbol, value, onSuccess, onError) {",
        "        TcHmi.Symbol.writeEx('%s%' + symbol + '%/s%', value, function (data) {",
        "            if (data.error === TcHmi.Errors.NONE) {",
        "                if (onSuccess) {",
        "                    onSuccess();",
        "                }",
        "            } else {",
        "                if (onError) {",
        "                    onError(data.error);",
        "                }",
        "            }",
        "        });",
        "    }",
        "",
        "    function getComboValue(ctrl) {",
        "        if (!ctrl) {",
        "            return null;",
        "        }",
        "",
        "        if (typeof ctrl.getSelectedValue === 'function') {",
        "            return ctrl.getSelectedValue();",
        "        }",
        "",
        "        if (typeof ctrl.getValue === 'function') {",
        "            return ctrl.getValue();",
        "        }",
        "",
        "        return null;",
        "    }",
        "",
        "    var reportType = getComboValue(combo);",
        "",
        "    if (",
        "        reportType === null ||",
        "        reportType === undefined ||",
        "        reportType === '' ||",
        "        Number(reportType) === 0",
        "    ) {",
        "        alert('Please select a report type first.');",
        "        return;",
        "    }",
        "",
        "    writeSymbol('PLC1.GVL_Reports.eSelectedReportType', reportType, function () {",
        "        writeSymbol('PLC1.GVL_Reports.bSearchRequest', true, function () {",
        "            console.log('List last 100 request sent.');",
        "        }, function (e) {",
        "            console.error('Could not write bSearchRequest:', e);",
        "            alert('Could not start report search.');",
        "        });",
        "    }, function (e) {",
        "        console.error('Could not write report type:', e);",
        "        alert('Could not prepare report search.');",
        "    });",
        "})();"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
        }
        ]
        }
        ]
    </script>
</div>
<div id="TcHmiButton_21" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="55" data-tchmi-height-unit="px" data-tchmi-left="861" data-tchmi-left-unit="px" data-tchmi-text="Search" data-tchmi-top="670" data-tchmi-top-unit="px" data-tchmi-width="120" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="16">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_21.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(async function () {",
          "    const getControl = id => TcHmi.Controls.get(id);",
          "",
          "    const writeSymbol = (symbol, value) => new Promise((resolve, reject) => {",
          "        TcHmi.Symbol.writeEx('%s%' + symbol + '%/s%', value, data => {",
          "            if (data.error === TcHmi.Errors.NONE) {",
          "                resolve();",
          "            } else {",
          "                reject(data.error);",
          "            }",
          "        });",
          "    });",
          "",
          "    function getComboValue(ctrl) {",
          "        if (!ctrl) return null;",
          "",
          "        if (typeof ctrl.getSelectedValue === 'function') {",
          "            return ctrl.getSelectedValue();",
          "        }",
          "",
          "        if (typeof ctrl.getValue === 'function') {",
          "            return ctrl.getValue();",
          "        }",
          "",
          "        return null;",
          "    }",
          "",
          "    function getDateValue(ctrl) {",
          "        if (!ctrl) return null;",
          "",
          "        if (typeof ctrl.getValue === 'function') {",
          "            return ctrl.getValue();",
          "        }",
          "",
          "        return null;",
          "    }",
          "",
          "    function normalizeToDate(value) {",
          "        if (value === null || value === undefined || value === '') {",
          "            return null;",
          "        }",
          "",
          "        if (value instanceof Date) {",
          "            return isNaN(value.getTime()) ? null : value;",
          "        }",
          "",
          "        if (typeof value === 'number') {",
          "            const d = new Date(value);",
          "            return isNaN(d.getTime()) ? null : d;",
          "        }",
          "",
          "        if (typeof value === 'string') {",
          "            const d = new Date(value);",
          "            return isNaN(d.getTime()) ? null : d;",
          "        }",
          "",
          "        return null;",
          "    }",
          "",
          "    function formatSqlDate(value, endOfDay) {",
          "        const d = normalizeToDate(value);",
          "        if (!d) return '';",
          "",
          "        const local = new Date(d.getTime());",
          "",
          "        if (endOfDay) {",
          "            local.setHours(23, 59, 59, 0);",
          "        } else {",
          "            local.setHours(0, 0, 0, 0);",
          "        }",
          "",
          "        const yyyy = local.getFullYear();",
          "        const MM = String(local.getMonth() + 1).padStart(2, '0');",
          "        const dd = String(local.getDate()).padStart(2, '0');",
          "        const hh = String(local.getHours()).padStart(2, '0');",
          "        const mm = String(local.getMinutes()).padStart(2, '0');",
          "        const ss = String(local.getSeconds()).padStart(2, '0');",
          "",
          "        return `'${yyyy}-${MM}-${dd} ${hh}:${mm}:${ss}'`;",
          "    }",
          "",
          "    try {",
          "        const combo = getControl('TcHmiCombobox_ReportType');",
          "        const fromCtrl = getControl('TcHmiDateTimeInput_FromFilter');",
          "        const toCtrl = getControl('TcHmiDateTimeInput_ToFilter');",
          "",
          "        const reportType = getComboValue(combo);",
          "        const fromValue = getDateValue(fromCtrl);",
          "        const toValue = getDateValue(toCtrl);",
          "",
          "        console.log('Search reportType:', reportType);",
          "        console.log('Search fromValue raw:', fromValue);",
          "        console.log('Search toValue raw:', toValue);",
          "",
          "        if (",
          "            reportType === null ||",
          "            reportType === undefined ||",
          "            reportType === '' ||",
          "            Number(reportType) === 0",
          "        ) {",
          "            alert('Please select a report type first.');",
          "            return;",
          "        }",
          "",
          "        const fromSql = formatSqlDate(fromValue, false);",
          "        const toSql = formatSqlDate(toValue, true);",
          "",
          "        console.log('Search fromSql:', fromSql);",
          "        console.log('Search toSql:', toSql);",
          "",
          "        let useDateFilter = false;",
          "",
          "        if ((fromSql && !toSql) || (!fromSql && toSql)) {",
          "            alert('Please select both From and To dates, or leave both empty.');",
          "            return;",
          "        }",
          "",
          "        if (fromSql && toSql) {",
          "            useDateFilter = true;",
          "        }",
          "",
          "        await writeSymbol('PLC1.GVL_Reports.eSelectedReportType', Number(reportType));",
          "        await writeSymbol('PLC1.GVL_Reports.sDateFromFilter', fromSql);",
          "        await writeSymbol('PLC1.GVL_Reports.sDateToFilter', toSql);",
          "        await writeSymbol('PLC1.GVL_Reports.bUseDateFilter', useDateFilter);",
          "        await writeSymbol('PLC1.GVL_Reports.bSearchRequest', true);",
          "",
          "    } catch (e) {",
          "        console.error('Search reports failed:', e);",
          "        alert('Could not perform report search: ' + e);",
          "    }",
          "})();"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
<div id="TcHmiButton_22" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="55" data-tchmi-height-unit="px" data-tchmi-left="71" data-tchmi-left-unit="px" data-tchmi-text="Clear" data-tchmi-top="755" data-tchmi-top-unit="px" data-tchmi-width="120" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="16">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_22.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(async function () {",
          "    const getControl = id => TcHmi.Controls.get(id);",
          "",
          "    const writeSymbol = (symbol, value) => new Promise((resolve, reject) => {",
          "        TcHmi.Symbol.writeEx('%s%' + symbol + '%/s%', value, data => {",
          "            if (data.error === TcHmi.Errors.NONE) {",
          "                resolve();",
          "            } else {",
          "                reject(data.error);",
          "            }",
          "        });",
          "    });",
          "",
          "    function clearComboBox(ctrl) {",
          "        if (!ctrl) return;",
          "",
          "        if (typeof ctrl.setSelectedValue === 'function') ctrl.setSelectedValue(0);",
          "        if (typeof ctrl.setValue === 'function') ctrl.setValue('');",
          "        if (typeof ctrl.setText === 'function') ctrl.setText('');",
          "    }",
          "",
          "    function clearNumericInput(ctrl) {",
          "        if (!ctrl) return;",
          "        if (typeof ctrl.setValue === 'function') ctrl.setValue(0);",
          "    }",
          "",
          "    function clearDateInput(ctrl) {",
          "        if (!ctrl) return;",
          "        if (typeof ctrl.setValue === 'function') ctrl.setValue(null);",
          "    }",
          "",
          "    function clearGrid(ctrl) {",
          "        if (!ctrl) return;",
          "        if (typeof ctrl.setSrcData === 'function') ctrl.setSrcData([]);",
          "        if (typeof ctrl.setSelectedRowIndex === 'function') ctrl.setSelectedRowIndex(-1);",
          "    }",
          "",
          "    try {",
          "        const combo = getControl('TcHmiCombobox_ReportType');",
          "        const grid = getControl('TcHmiDatagrid_5');",
          "        const idInput = getControl('TcHmiNumericInput_SelectbyID');",
          "        const fromDate = getControl('TcHmiDateTimeInput_FromFilter');",
          "        const toDate = getControl('TcHmiDateTimeInput_ToFilter');",
          "",
          "        clearComboBox(combo);",
          "        clearNumericInput(idInput);",
          "        clearDateInput(fromDate);",
          "        clearDateInput(toDate);",
          "        clearGrid(grid);",
          "",
          "        console.log('Writing clear flag...');",
          "        await writeSymbol('PLC1.GVL_Reports.bClearSearchScreen', true);",
          "        console.log('Clear flag written.');",
          "",
          "    } catch (e) {",
          "        console.error('Clear report screen failed:', e);",
          "        alert('Could not clear the report screen.');",
          "    }",
          "})();"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
<div id="TcHmiButton_23" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="55" data-tchmi-height-unit="px" data-tchmi-left="861" data-tchmi-left-unit="px" data-tchmi-text="Clear Dates" data-tchmi-top="737" data-tchmi-top-unit="px" data-tchmi-width="120" data-tchmi-width-unit="px" data-tchmi-word-wrap="true" data-tchmi-text-font-size="16">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_23.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(async function () {",
          "    const getControl = id => TcHmi.Controls.get(id);",
          "",
          "    const writeSymbol = (symbol, value) => new Promise((resolve, reject) => {",
          "        TcHmi.Symbol.writeEx('%s%' + symbol + '%/s%', value, data => {",
          "            if (data.error === TcHmi.Errors.NONE) {",
          "                resolve();",
          "            } else {",
          "                reject(data.error);",
          "            }",
          "        });",
          "    });",
          "",
          "    function clearDateInput(ctrl) {",
          "        if (!ctrl) return;",
          "",
          "        if (typeof ctrl.setValue === 'function') {",
          "            ctrl.setValue(null);",
          "        }",
          "    }",
          "",
          "    try {",
          "        const fromCtrl = getControl('TcHmiDateTimeInput_FromFilter');",
          "        const toCtrl = getControl('TcHmiDateTimeInput_ToFilter');",
          "",
          "        clearDateInput(fromCtrl);",
          "        clearDateInput(toCtrl);",
          "",
          "        await writeSymbol('PLC1.GVL_Reports.sDateFromFilter', '');",
          "        await writeSymbol('PLC1.GVL_Reports.sDateToFilter', '');",
          "        await writeSymbol('PLC1.GVL_Reports.bUseDateFilter', false);",
          "",
          "    } catch (e) {",
          "        console.error('Clear dates failed:', e);",
          "        alert('Could not clear date filters.');",
          "    }",
          "})();"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%ctrl%TcHmiDateTimeInput_FromFilter::Value%/ctrl%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/DateTime",
          "value": null
        },
        "asyncWait": true
      }
    ]
  }
]
</script>
