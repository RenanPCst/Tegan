<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "btnDownloadPDF_17.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "TcHmi.Symbol.writeEx('%s%PLC1.GVL_Reports.bBuildCurrentLinearReport%/s%', true, function (res) {",
          "    if (res.error !== TcHmi.Errors.NONE) {",
          "        console.error('Error requesting current linear pumps report:', res.error);",
          "        alert('Could not start current linear pumps report.');",
          "    }",
          "});"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
