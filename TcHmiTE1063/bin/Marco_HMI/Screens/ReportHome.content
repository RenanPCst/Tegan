<div id="btnDownloadPDF_15" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="50" data-tchmi-height-unit="px" data-tchmi-left="482" data-tchmi-left-unit="px" data-tchmi-text="Method Report" data-tchmi-top="50" data-tchmi-top-unit="px" data-tchmi-width="100" data-tchmi-width-unit="px" data-tchmi-word-wrap="True" data-tchmi-zindex="57">
<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "btnDownloadPDF_15.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "// Call the PDF generator function",
          "function showMessageFromPLC(message) {",
          "\talert(\"Mensagem do PLC: \" + message);",
          "}",
          "// Wrinting the PLC variable",
          "TcHmi.Symbol.readEx2('%s%PLC1.GVL_DB.astVolData%/s%', function (data1) {",
          "\tif (data1.error === TcHmi.Errors.NONE) {",
          "\t\tTcHmi.Symbol.readEx2('%s%PLC1.GVL_DB.stParameter_MR%/s%', function (data2) {",
          "\t\t\tif (data2.error === TcHmi.Errors.NONE) {",
          "\t            let methodDataArray = data2.value;",
          "           \t\tlet volumeDataArray = data1.value; // value from PLC (array)",
          "           \t\t// Function Call",
          "\t\t   \t\tgenPumpCalibrationReport(methodDataArray, volumeDataArray, 'Pump Calibration Report');                  ",
          "       \t\t} else {",
          "\t\t   \t\t console.error(\"Erro ao ler variável do PLC: \", data2.error);",
          "       \t\t}",
          "       \t\t});                  ",
          "\t} else {",
          "       console.error(\"Erro ao ler variável do PLC: \", data1.error);",
          "    }",
          "    });"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>

<script data-tchmi-target-attribute="data-tchmi-border-radius" type="application/json">
{
  "topLeft": 5.0,
  "topRight": 5.0,
  "bottomLeft": 5.0,
  "bottomRight": 5.0,
  "topLeftUnit": "px",
  "topRightUnit": "px",
  "bottomLeftUnit": "px",
  "bottomRightUnit": "px"
}
</script>


