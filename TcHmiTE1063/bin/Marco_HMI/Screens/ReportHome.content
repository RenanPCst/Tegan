<div id="btnDownloadPDF_8" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="50" data-tchmi-height-unit="px" data-tchmi-left="97" data-tchmi-left-unit="px" data-tchmi-text="Current Users" data-tchmi-top="50" data-tchmi-top-unit="px" data-tchmi-width="100" data-tchmi-width-unit="px" data-tchmi-word-wrap="True" data-tchmi-zindex="57">
<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "btnDownloadPDF_8.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "// Call the PDF generator function",
          "          function showMessageFromPLC(message) {",
          "          \t\talert(\"Mensagem do PLC: \" + message);",
          "          }",
          "          // Wrinting the PLC variable",
          "          TcHmi.Symbol.readEx2('%s%PLC1.GVL_DB.astData_CUL%/s%', function (data) {",
          "              if (data.error === TcHmi.Errors.NONE) {",
          "                  let plcArrayData = data.value; // value from PLC (array)",
          "                  // Function Call",
          "                  genCurrentUserList(plcArrayData,'Current Users List');                  ",
          "              } else {",
          "                  console.error(\"Erro ao ler variável do PLC: \", data.error);",
          "              }",
          "          });"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>

<script data-tchmi-target-attribute="data-tchmi-border-radius" type="application/json">
{
  "topLeft": 5.0,
  "topRight": 5.0,
  "bottomLeft": 5.0,
  "bottomRight": 5.0,
  "topLeftUnit": "px",
  "topRightUnit": "px",
  "bottomLeftUnit": "px",
  "bottomRightUnit": "px"
}
</script>


</div>
